<UserControl
    x:Class="MESharp.Views.McpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:McpViewModel}"
    d:DesignHeight="650"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header / status / actions  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="10"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <iconPacks:PackIconMaterial Margin="0,0,6,0" VerticalAlignment="Center" Kind="ServerNetwork" />
                <TextBlock
                    Margin="0,0,18,0"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="MCP Bridge" />

                <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#EF5350" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListening}" Value="True">
                                    <Setter Property="Fill" Value="#66BB6A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Margin="0,0,14,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding StatusText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#EF5350" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListening}" Value="True">
                                    <Setter Property="Foreground" Value="#66BB6A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Margin="0,0,14,0" VerticalAlignment="Center" Opacity="0.75" Text="{Binding ClientText}" />

                <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="Auto Refresh" IsChecked="{Binding AutoRefresh}" />
                <Button Margin="0,0,8,0" Padding="10,4" Command="{Binding RefreshCommand}" Content="Refresh" Style="{StaticResource AccentButton}" />
                <Button Margin="0,0,8,0" Padding="10,4" Command="{Binding ResetCountersCommand}" Content="Reset Counters" />
                <Button Margin="0,0,8,0" Padding="10,4" Command="{Binding CopyConfigCommand}" Content="Copy Client Config" ToolTip="Copies an mcpServers JSON snippet for this session to the clipboard" />
                <Button Padding="10,4" Command="{Binding OpenDashboardCommand}" Content="Open Full Dashboard" ToolTip="Opens the standalone MCP dashboard window (start/stop bridge, logs, full tool browser)" />
            </StackPanel>
        </Border>

        <!--  Stats + bridge info  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,8"
            Padding="10"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Counters  -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock FontSize="10" Opacity="0.6" Text="REQUESTS" />
                        <TextBlock FontFamily="Consolas" FontSize="18" FontWeight="Bold" Text="{Binding TotalRequests}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock FontSize="10" Opacity="0.6" Text="FAILED" />
                        <TextBlock FontFamily="Consolas" FontSize="18" FontWeight="Bold" Text="{Binding FailedRequests}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFailures}" Value="True">
                                            <Setter Property="Foreground" Value="#EF5350" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock FontSize="10" Opacity="0.6" Text="AVG" />
                        <TextBlock FontFamily="Consolas" FontSize="18" FontWeight="Bold" Text="{Binding AvgDuration}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock FontSize="10" Opacity="0.6" Text="CONNECTIONS" />
                        <TextBlock FontFamily="Consolas" FontSize="18" FontWeight="Bold" Text="{Binding Connections}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock FontSize="10" Opacity="0.6" Text="UPTIME" />
                        <TextBlock FontFamily="Consolas" FontSize="18" FontWeight="Bold" Text="{Binding Uptime}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock FontSize="10" Opacity="0.6" Text="LAST COMMAND" />
                        <TextBlock FontFamily="Consolas" FontSize="14" FontWeight="Bold" VerticalAlignment="Bottom" Text="{Binding LastCommand}" />
                    </StackPanel>
                </StackPanel>

                <!--  Bridge / config details  -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Opacity="0.6" Text="Pipe" />
                    <TextBlock Grid.Row="0" Grid.Column="1" FontFamily="Consolas" Text="{Binding PipeName}" TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Opacity="0.6" Text="Listening since" />
                    <TextBlock Grid.Row="1" Grid.Column="1" FontFamily="Consolas" Text="{Binding ListeningSince}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Opacity="0.6" Text="Auto-start" />
                    <TextBlock Grid.Row="2" Grid.Column="1" FontFamily="Consolas" Text="{Binding AutoStartText}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Opacity="0.6" Text="MCP server exe" />
                    <TextBlock Grid.Row="3" Grid.Column="1" FontFamily="Consolas" Text="{Binding ServerPathText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ServerPathText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#EF5350" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ServerFound}" Value="True">
                                        <Setter Property="Foreground" Value="#66BB6A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Row="4" Grid.Column="0" Opacity="0.6" Text="Game API / tools" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                        <TextBlock FontFamily="Consolas" Text="{Binding GameApiVersion}" />
                        <TextBlock Margin="12,0,0,0" FontFamily="Consolas" Opacity="0.75" Text="{Binding CatalogSummary}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--  Activity + tools  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" MinWidth="380" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!--  Recent calls  -->
            <Border Grid.Column="0" Padding="8" Background="{DynamicResource App.CardBrush}" CornerRadius="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Recent calls" />
                        <TextBlock Margin="10,0,4,0" VerticalAlignment="Center" Opacity="0.6" Text="Filter:" />
                        <TextBox Width="160" Text="{Binding ActivityFilter, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Margin="10,0,0,0" VerticalAlignment="Center" Content="Errors only" IsChecked="{Binding ErrorsOnly}" />
                    </StackPanel>
                    <DataGrid
                        AutoGenerateColumns="False"
                        Background="{DynamicResource App.BackgroundBrush}"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        Foreground="{DynamicResource App.ForegroundBrush}"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Activity}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Ok}" Value="False">
                                        <Setter Property="Foreground" Value="#EF5350" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="70" Binding="{Binding Time}" Header="Time" />
                            <DataGridTextColumn Width="190" Binding="{Binding Command}" Header="Command" />
                            <DataGridTextColumn Width="60" Binding="{Binding Status}" Header="Status" />
                            <DataGridTextColumn Width="50" Binding="{Binding Duration}" Header="ms" />
                            <DataGridTextColumn Width="*" Binding="{Binding Error}" Header="Error" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!--  Right column: per-command totals + tool catalog  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="1.4*" MinHeight="160" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="8" Background="{DynamicResource App.CardBrush}" CornerRadius="6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontWeight="SemiBold" Text="Per-command totals" />
                        <DataGrid
                            AutoGenerateColumns="False"
                            Background="{DynamicResource App.BackgroundBrush}"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            Foreground="{DynamicResource App.ForegroundBrush}"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding CommandStats}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Binding="{Binding Command}" Header="Command" />
                                <DataGridTextColumn Width="50" Binding="{Binding Count}" Header="Calls" />
                                <DataGridTextColumn Width="45" Binding="{Binding Failed}" Header="Fail" />
                                <DataGridTextColumn Width="60" Binding="{Binding AvgMs}" Header="Avg ms" />
                                <DataGridTextColumn Width="70" Binding="{Binding Last}" Header="Last" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Padding="8" Background="{DynamicResource App.CardBrush}" CornerRadius="6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Tool catalog" />
                            <TextBlock Margin="10,0,4,0" VerticalAlignment="Center" Opacity="0.6" Text="Search:" />
                            <TextBox Width="160" Text="{Binding ToolSearch, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.6" Text="{Binding ToolsCountText}" />
                        </StackPanel>
                        <DataGrid
                            AutoGenerateColumns="False"
                            Background="{DynamicResource App.BackgroundBrush}"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            Foreground="{DynamicResource App.ForegroundBrush}"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding Tools}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="180" Binding="{Binding Name}" Header="Tool" />
                                <DataGridTextColumn Width="110" Binding="{Binding Kind}" Header="Category" />
                                <DataGridTextColumn Width="100" Binding="{Binding Safety}" Header="Safety" />
                                <DataGridTextColumn Width="45" Binding="{Binding Login}" Header="Login" />
                                <DataGridTextColumn Width="55" Binding="{Binding Mutates}" Header="Mutates" />
                                <DataGridTextColumn Width="*" Binding="{Binding Description}" Header="Description" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!--  Status message  -->
        <TextBlock Grid.Row="3" Margin="2,6,2,0" Opacity="0.7" Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>
