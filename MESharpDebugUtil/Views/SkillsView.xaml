<UserControl
    x:Class="MESharp.Views.SkillsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:MESharp.Views.Behaviors"
    xmlns:conv="clr-namespace:MESharp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:controls="clr-namespace:MESharp.Views.Controls"
    xmlns:local="clr-namespace:MESharp.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{DynamicResource App.BackgroundBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>

            <RotateTransform x:Key="BorderRotateTransform" Angle="0" CenterX="0.5" CenterY="0.5" />

            <!--  Removed unused AnimatedBorderBrush to avoid binding warnings before DataContext is available  -->

            <conv:BoolToStringConverter x:Key="BoolToString" />
            <conv:ToOpacityBrushConverter x:Key="ToOpacityBrush" />
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />

            <!--  Backgrounds come from theme resources directly via DynamicResource  -->

            <!--  Outer “chrome” outline  -->
            <Style x:Key="SkillChromeBorderStyle" TargetType="Border">
                <!--  spacing between cards  -->
                <Setter Property="Margin" Value="6" />
                <!--  gap between chrome and gradient  -->
                <Setter Property="Padding" Value="0" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="CornerRadius" Value="10" />
                <!--  2px larger than inner  -->
                <Setter Property="BorderBrush" Value="#66FFFFFF" />
                <!--  40% white  -->
                <Setter Property="BorderThickness" Value="2" />
            </Style>

            <!--  Inner gradient border  -->
            <Style x:Key="SkillCardStyle" TargetType="Border">
                <!--  NO margin or padding here!  -->
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="{DynamicResource App.CardBrush}" />
                <Setter Property="BorderThickness" Value="4" />
            </Style>

            <!--  text styles for consistent padding & alignment  -->
            <Style x:Key="SkillTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style
                x:Key="SkillTitleTextStyle"
                BasedOn="{StaticResource SkillTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,0" />
            </Style>

            <Style x:Key="SkillLevelBadgeStyle" TargetType="Border">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Background" Value="{Binding SecondaryBrush, Converter={StaticResource ToOpacityBrush}, ConverterParameter=0.4}" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style x:Key="SkillLevelBadgeTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>

            <!--  A compact list card with safer right edge spacing  -->
            <DataTemplate x:Key="ListSkillTemplate">
                <Border Style="{StaticResource SkillChromeBorderStyle}">
                    <Border Style="{StaticResource SkillCardStyle}">
                        <Border.BorderBrush>
                            <LinearGradientBrush>
                                <GradientStop Offset="0" Color="{Binding DataContext.PrimaryBrush.Color, RelativeSource={RelativeSource AncestorType=Border}}" />
                                <GradientStop Offset="0.33" Color="{Binding DataContext.SecondaryBrush.Color, RelativeSource={RelativeSource AncestorType=Border}}" />
                                <GradientStop Offset="0.66" Color="{Binding DataContext.PrimaryBrush.Color, RelativeSource={RelativeSource AncestorType=Border}}" />
                                <GradientStop Offset="0.99" Color="{Binding DataContext.SecondaryBrush.Color, RelativeSource={RelativeSource AncestorType=Border}}" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Style="{StaticResource SkillLevelBadgeStyle}">
                                <TextBlock Style="{StaticResource SkillLevelBadgeTextStyle}" Text="{Binding Level}" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SkillTitleTextStyle}"
                                Text="{Binding Name}" />

                            <UniformGrid Grid.Column="2" Columns="5">
                                <StackPanel Margin="4,0">
                                    <TextBlock Style="{StaticResource SkillTextBlockStyle}" Text="Total XP" />
                                    <TextBlock Style="{StaticResource SkillTextBlockStyle}" Text="{Binding Xp, StringFormat=N0}" />
                                </StackPanel>
                                <StackPanel Margin="4,0">
                                    <TextBlock Style="{StaticResource SkillTextBlockStyle}" Text="Gained" />
                                    <TextBlock Style="{StaticResource SkillTextBlockStyle}" Text="{Binding XpGained, StringFormat=N0}" />
                                </StackPanel>
                                <StackPanel Margin="4,0">
                                    <TextBlock Style="{StaticResource SkillTextBlockStyle}" Text="XP/hr" />
                                    <TextBlock Style="{StaticResource SkillTextBlockStyle}" Text="{Binding XpPerHour, StringFormat=N0}" />
                                </StackPanel>
                                <StackPanel Margin="4,0">
                                    <TextBlock Style="{StaticResource SkillTextBlockStyle}" Text="To Next" />
                                    <TextBlock Style="{StaticResource SkillTextBlockStyle}" Text="{Binding XpToNext, StringFormat=N0}" />
                                </StackPanel>
                                <StackPanel Margin="4,0">
                                    <TextBlock Style="{StaticResource SkillTextBlockStyle}" Text="ETA" />
                                    <TextBlock Style="{StaticResource SkillTextBlockStyle}" Text="{Binding EtaString}" />
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Border>
            </DataTemplate>

            <!--  1) The “grid” card (copy of your existing inline DataTemplate)  -->
            <DataTemplate x:Key="GridSkillTemplate">
                <Border Style="{StaticResource SkillChromeBorderStyle}">
                    <Border Style="{StaticResource SkillCardStyle}">
                        <Border.BorderBrush>
                            <LinearGradientBrush>
                                <GradientStop Offset="0" Color="{Binding DataContext.PrimaryBrush.Color, RelativeSource={RelativeSource AncestorType=Border}}" />
                                <GradientStop Offset="0.33" Color="{Binding DataContext.SecondaryBrush.Color, RelativeSource={RelativeSource AncestorType=Border}}" />
                                <GradientStop Offset="0.66" Color="{Binding DataContext.PrimaryBrush.Color, RelativeSource={RelativeSource AncestorType=Border}}" />
                                <GradientStop Offset="0.99" Color="{Binding DataContext.SecondaryBrush.Color, RelativeSource={RelativeSource AncestorType=Border}}" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <StackPanel Margin="6">
                            <!--  Header: Level + Name + colored bar  -->
                            <StackPanel Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Level badge  -->
                                    <Border
                                        Grid.Column="0"
                                        Style="{StaticResource SkillLevelBadgeStyle}">
                                        <TextBlock Style="{StaticResource SkillLevelBadgeTextStyle}" Text="{Binding Level}" />
                                    </Border>

                                    <!--  Skill name  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SkillTitleTextStyle}"
                                        Text="{Binding Name}" />
                                </Grid>

                                <!--  colored underline  -->
                                <Rectangle
                                    Height="3"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Stretch">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Offset="0" Color="{Binding SecondaryBrush.Color}" />
                                            <GradientStop Offset="0.25" Color="{Binding PrimaryBrush.Color}" />
                                            <GradientStop Offset="0.5" Color="{Binding SecondaryBrush.Color}" />
                                            <GradientStop Offset="0.75" Color="{Binding PrimaryBrush.Color}" />
                                            <GradientStop Offset="1" Color="{Binding SecondaryBrush.Color}" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </StackPanel>

                            <!--  Metrics grid  -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <!--  labels / values  -->
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,5,2"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="Total XP:" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="5,0,0,2"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="{Binding Xp, StringFormat=N0}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,5,2"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="Gained XP:" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="5,0,0,2"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="{Binding XpGained, StringFormat=N0}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,0,5,2"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="XP/hr:" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="5,0,0,2"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="{Binding XpPerHour, StringFormat=N0}" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,0,5,2"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="XP to lvl:" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="5,0,0,2"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="{Binding XpToNext, StringFormat=N0}" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Margin="0,0,5,2"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="ETA:" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Margin="5,0,0,2"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="{Binding EtaString}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>
            </DataTemplate>

            <!--  Two ItemsPanelTemplates  -->
            <ItemsPanelTemplate x:Key="GridItemsPanel">
                <WrapPanel ItemWidth="225" Orientation="Horizontal" />
            </ItemsPanelTemplate>

            <ItemsPanelTemplate x:Key="ListItemsPanel">
                <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>

            <Style x:Key="SkillsTableStyle" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="AlternationCount" Value="2" />
                <Setter Property="Background" Value="{DynamicResource App.CardBrush}" />
                <Setter Property="BorderBrush" Value="#55FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                <Setter Property="RowBackground" Value="#16000000" />
                <Setter Property="AlternatingRowBackground" Value="#28000000" />
                <Setter Property="HorizontalGridLinesBrush" Value="#33FFFFFF" />
                <Setter Property="VerticalGridLinesBrush" Value="#22FFFFFF" />
                <Setter Property="ColumnHeaderStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#22000000" />
                            <Setter Property="BorderBrush" Value="#44FFFFFF" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="8,6" />
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="CellStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,5" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

            <!--  Header  -->
            <controls:SectionHeader
                Grid.Row="0"
                Margin="0,0,0,12"
                Title="Skills"
                Description="Track XP, levels, and per-hour gains across skills."
                IconKind="TrophyVariant"
                HelpCommand="{Binding DataContext.ShowApiDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

            <Grid Grid.Row="1" behaviors:PanelLayoutBehavior.PageKey="skills-view">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Controls Card  -->
                <Border
                    Grid.Row="0"
                    behaviors:PanelLayoutBehavior.PanelKey="view-options"
                    behaviors:PanelLayoutBehavior.IsHeightResizable="False"
                    Margin="0,0,0,12"
                    Padding="16"
                    Background="{DynamicResource App.CardBrush}"
                    CornerRadius="8">
                    <Expander Header="View Options" IsExpanded="True">
                        <StackPanel Margin="0,10,0,0">
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource App.MutedBrush}"
                            Text="Toggle view mode, filter active skills, and sort by any tracked metric." />

                        <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
                            <CheckBox
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Content="Auto Refresh"
                                IsChecked="{Binding AutoRefreshEnabled, Mode=TwoWay}"
                                ToolTip="Automatically refresh skill stats on a timer" />
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Refresh Rate:" />
                            <Slider
                                Width="160"
                                Minimum="1"
                                Maximum="10"
                                TickFrequency="1"
                                SmallChange="1"
                                LargeChange="1"
                                Foreground="{DynamicResource App.ForegroundBrush}"
                                Background="{DynamicResource App.MutedBrush}"
                                IsSnapToTickEnabled="True"
                                IsEnabled="{Binding AutoRefreshEnabled}"
                                Value="{Binding RefreshIntervalSeconds, Mode=TwoWay}" />
                            <TextBlock
                                Width="32"
                                Margin="8,0,12,0"
                                VerticalAlignment="Center"
                                Text="{Binding RefreshIntervalDisplay}" />
                        </WrapPanel>

                    <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
                        <!--  List View Toggle  -->
                        <ToggleButton
                            Width="36"
                            Height="36"
                            Margin="0,0,10,0"
                            Padding="0"
                            IsChecked="{Binding IsListView, Mode=TwoWay}"
                            ToolTip="Switch to List View">
                            <iconPacks:PackIconMaterial
                                Width="20"
                                Height="20"
                                Kind="ViewList" />
                        </ToggleButton>

                        <!--  Grid View Toggle  -->
                        <ToggleButton
                            Width="36"
                            Height="36"
                            Margin="0,0,10,0"
                            Padding="0"
                            IsChecked="{Binding IsGridView, Mode=TwoWay}"
                            ToolTip="Switch to Grid View">
                            <iconPacks:PackIconMaterial
                                Width="20"
                                Height="20"
                                Kind="ViewGrid" />
                        </ToggleButton>

                        <!--  Table View Toggle  -->
                        <ToggleButton
                            Width="36"
                            Height="36"
                            Margin="0,0,10,0"
                            Padding="0"
                            IsChecked="{Binding IsTableView, Mode=TwoWay}"
                            ToolTip="Switch to Table View">
                            <iconPacks:PackIconMaterial
                                Width="20"
                                Height="20"
                                Kind="Table" />
                        </ToggleButton>

                        <!--  Keep your "Show Only Active" next  -->
                        <ToggleButton
                            Content="Active Only"
                            Margin="0,0,12,0"
                            IsChecked="{Binding ShowOnlyActive, Mode=TwoWay}"
                            ToolTip="Show only skills with XP gains" />
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Sort:" />
                        <ComboBox
                            Width="170"
                            Margin="0,0,10,0"
                            ItemsSource="{Binding SortOptions}"
                            SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}" />
                        <ToggleButton
                            Padding="10,4"
                            IsChecked="{Binding SortDescending, Mode=TwoWay}"
                            ToolTip="Toggle descending / ascending sort">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,6,0"
                                    Kind="SwapVertical" />
                                <TextBlock Text="{Binding SortDescending, Converter={StaticResource BoolToString}, ConverterParameter='Desc|Asc'}" />
                            </StackPanel>
                        </ToggleButton>
                    </WrapPanel>
                        </StackPanel>
                    </Expander>
                </Border>

                <!--  Skills Display Card  -->
                <Border
                    Grid.Row="1"
                    behaviors:PanelLayoutBehavior.PanelKey="skills-display"
                    behaviors:PanelLayoutBehavior.IsHeightResizable="False"
                    Padding="16"
                    Background="{DynamicResource App.CardBrush}"
                    CornerRadius="8">
                    <Expander
                        VerticalAlignment="Stretch"
                        Header="Skills Display"
                        IsExpanded="True">
                        <Grid Margin="0,10,0,0" VerticalAlignment="Stretch">
                            <ScrollViewer
                                Padding="0,0,8,0"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTableView}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <ItemsControl
                                Margin="0,0,4,0"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{Binding SkillsView}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="ItemTemplate" Value="{StaticResource GridSkillTemplate}" />
                                        <Setter Property="ItemsPanel" Value="{StaticResource GridItemsPanel}" />

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsListView}" Value="True">
                                                <Setter Property="ItemTemplate" Value="{StaticResource ListSkillTemplate}" />
                                                <Setter Property="ItemsPanel" Value="{StaticResource ListItemsPanel}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>
                            </ScrollViewer>

                            <DataGrid
                                Margin="0,0,8,0"
                                Sorting="SkillsTable_Sorting"
                                ItemsSource="{Binding SkillsView}">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid" BasedOn="{StaticResource SkillsTableStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTableView}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Skill" MinWidth="220" SortMemberPath="Name" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" RadiusX="2" RadiusY="2" Fill="{Binding SecondaryBrush}" />
                                                <Border
                                                    Grid.Column="1"
                                                    Margin="8,0"
                                                    Style="{StaticResource SkillLevelBadgeStyle}">
                                                    <TextBlock Style="{StaticResource SkillLevelBadgeTextStyle}" Text="{Binding Level}" />
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{DynamicResource App.MutedBrush}"
                                                        Text="{Binding IsActive, Converter={StaticResource BoolToString}, ConverterParameter='Active|Idle'}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Binding="{Binding LevelValue}" Header="Lvl" SortMemberPath="LevelValue" Width="70" />
                                <DataGridTextColumn Binding="{Binding Xp, StringFormat=N0}" Header="Total XP" SortMemberPath="Xp" Width="*" />
                                <DataGridTextColumn Binding="{Binding XpGained, StringFormat=N0}" Header="XP Gained" SortMemberPath="XpGained" Width="*" />
                                <DataGridTextColumn Binding="{Binding XpPerHour, StringFormat=N0}" Header="XP / Hour" SortMemberPath="XpPerHour" Width="*" />
                                <DataGridTextColumn Binding="{Binding XpToNext, StringFormat=N0}" Header="XP To Next" SortMemberPath="XpToNext" Width="*" />
                                <DataGridTextColumn Binding="{Binding EtaString}" Header="ETA" SortMemberPath="EtaMinutes" Width="*" />
                            </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Expander>
                </Border>
            </Grid>
    </Grid>

</UserControl>
