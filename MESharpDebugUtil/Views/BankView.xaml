<UserControl
    x:Class="MESharp.Views.BankView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:MESharp.Views.Behaviors"
    xmlns:controls="clr-namespace:MESharp.Views.Controls"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Background="{DynamicResource App.BackgroundBrush}"
    Foreground="{DynamicResource App.ForegroundBrush}">

    <UserControl.Resources />

    <ScrollViewer>
        <StackPanel Margin="24" behaviors:PanelLayoutBehavior.PageKey="bank-view">

            <!--  Header  -->
            <controls:SectionHeader
                Title="Bank"
                Margin="0,0,0,16"
                Description="Inspect bank state, filters, and common actions."
                HelpCommand="{Binding DataContext.ShowApiDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                IconKind="BankOutline" />

            <!--  Status, Lookups & Actions Card  -->
            <Border
                behaviors:PanelLayoutBehavior.PanelKey="status-actions"
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <Expander Header="Status, Lookups and Actions" IsExpanded="True">
                    <StackPanel Margin="0,10,0,0">
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Bank status, quick filter, deposits, stack lookups, and item actions." />

                    <!--  Status & Quick Filter  -->
                    <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Filter:" />
                        <TextBox
                            Width="220"
                            Margin="0,0,12,8"
                            Text="{Binding QuickFilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Width="140"
                            Margin="0,0,12,8"
                            Command="{Binding RefreshStateCommand}"
                            Content="Refresh State"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="120"
                            Margin="0,0,12,8"
                            Command="{Binding CloseCommand}"
                            Content="Close Bank"
                            Style="{StaticResource AccentButton}" />
                        <TextBlock Margin="0,0,12,8" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Status: Closed" />
                                    <Setter Property="Foreground" Value="{DynamicResource App.MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                            <Setter Property="Text" Value="Status: Open" />
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,0,12,8" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Foreground" Value="{DynamicResource App.MutedBrush}" />
                                    <Setter Property="Text" Value="{Binding QuickStack, StringFormat=Matching: {0}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasStack}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </WrapPanel>

                    <!--  Divider  -->
                    <Border
                        Height="1"
                        Margin="0,8,0,12"
                        Background="{DynamicResource App.BorderBrush}" />

                    <!--  Deposit Section  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Deposit" />
                    <WrapPanel Margin="0,0,0,12">
                        <Button
                            Width="140"
                            Margin="0,0,12,8"
                            Command="{Binding DepositAllCommand}"
                            Content="Deposit All"
                            Style="{StaticResource AccentButton}" />
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Keep IDs:" />
                        <TextBox
                            Width="180"
                            Margin="0,0,8,8"
                            Text="{Binding IdsInput}" />
                        <Button
                            Width="180"
                            Margin="0,0,12,8"
                            Command="{Binding DepositAllExceptIdsCommand}"
                            Content="Deposit Except IDs"
                            Style="{StaticResource AccentButton}" />
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Keep Names:" />
                        <TextBox
                            Width="200"
                            Margin="0,0,8,8"
                            Text="{Binding NamesInput}" />
                        <Button
                            Width="200"
                            Margin="0,0,0,8"
                            Command="{Binding DepositAllExceptNamesCommand}"
                            Content="Deposit Except Names"
                            Style="{StaticResource AccentButton}" />
                    </WrapPanel>

                    <!--  Divider  -->
                    <Border
                        Height="1"
                        Margin="0,0,0,12"
                        Background="{DynamicResource App.BorderBrush}" />

                    <!--  Extended Actions Section  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Extended Actions" />
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Quick access to tabs, quantities, presets, and deposit/collection tools." />

                    <WrapPanel Margin="0,0,0,8">
                        <Button
                            Width="120"
                            Margin="0,0,12,8"
                            Command="{Binding OpenCommand}"
                            Content="Open Bank"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="160"
                            Margin="0,0,12,8"
                            Command="{Binding LoadLastPresetCommand}"
                            Content="Load Last Preset"
                            Style="{StaticResource AccentButton}" />
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="PIN:" />
                        <TextBox
                            Width="90"
                            Margin="0,0,8,8"
                            Text="{Binding PinInput}" />
                        <Button
                            Width="120"
                            Margin="0,0,0,8"
                            Command="{Binding EnterPinCommand}"
                            Content="Enter PIN"
                            Style="{StaticResource AccentButton}" />
                    </WrapPanel>

                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Tabs:" />
                        <Button
                            Width="120"
                            Margin="0,0,8,8"
                            Command="{Binding OpenInventoryTabCommand}"
                            Content="Inventory"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="120"
                            Margin="0,0,8,8"
                            Command="{Binding OpenBoBTabCommand}"
                            Content="BoB"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="120"
                            Margin="0,0,12,8"
                            Command="{Binding OpenEquipmentTabCommand}"
                            Content="Equipment"
                            Style="{StaticResource AccentButton}" />
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Mode:" />
                        <Button
                            Width="120"
                            Margin="0,0,8,8"
                            Command="{Binding SetTransferTabCommand}"
                            Content="Transfer"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="120"
                            Margin="0,0,0,8"
                            Command="{Binding SetPresetTabCommand}"
                            Content="Preset"
                            Style="{StaticResource AccentButton}" />
                    </WrapPanel>

                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Quantity:" />
                        <Button
                            Width="70"
                            Margin="0,0,6,8"
                            Command="{Binding SetQuantity1Command}"
                            Content="1"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="70"
                            Margin="0,0,6,8"
                            Command="{Binding SetQuantity5Command}"
                            Content="5"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="70"
                            Margin="0,0,6,8"
                            Command="{Binding SetQuantity10Command}"
                            Content="10"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="70"
                            Margin="0,0,6,8"
                            Command="{Binding SetQuantityXCommand}"
                            Content="X"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="80"
                            Margin="0,0,12,8"
                            Command="{Binding SetQuantityAllCommand}"
                            Content="All"
                            Style="{StaticResource AccentButton}" />
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="X:" />
                        <TextBox
                            Width="80"
                            Margin="0,0,8,8"
                            Text="{Binding XQuantityInput}" />
                        <Button
                            Width="120"
                            Margin="0,0,12,8"
                            Command="{Binding SetXQuantityCommand}"
                            Content="Set X"
                            Style="{StaticResource AccentButton}" />
                        <CheckBox
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Content="Note Mode"
                            IsChecked="{Binding NoteModeEnabled}"
                            IsEnabled="False" />
                        <Button
                            Width="140"
                            Margin="0,0,0,8"
                            Command="{Binding ToggleNoteModeCommand}"
                            Content="Toggle Note"
                            Style="{StaticResource AccentButton}" />
                    </WrapPanel>

                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Preset #:" />
                        <TextBox
                            Width="80"
                            Margin="0,0,8,8"
                            Text="{Binding PresetNumberInput}" />
                        <Button
                            Width="120"
                            Margin="0,0,8,8"
                            Command="{Binding SavePresetCommand}"
                            Content="Save Preset"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="120"
                            Margin="0,0,12,8"
                            Command="{Binding LoadPresetCommand}"
                            Content="Load Preset"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="160"
                            Margin="0,0,8,8"
                            Command="{Binding SaveSummonPresetCommand}"
                            Content="Save Summon"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="160"
                            Margin="0,0,0,8"
                            Command="{Binding LoadSummonPresetCommand}"
                            Content="Load Summon"
                            Style="{StaticResource AccentButton}" />
                    </WrapPanel>

                    <WrapPanel Margin="0,0,0,8">
                        <Button
                            Width="180"
                            Margin="0,0,8,8"
                            Command="{Binding PresetSettingsOpenCommand}"
                            Content="Open Preset Settings"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="180"
                            Margin="0,0,12,8"
                            Command="{Binding PresetSettingsReturnCommand}"
                            Content="Return to Bank"
                            Style="{StaticResource AccentButton}" />
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Select Preset:" />
                        <TextBox
                            Width="80"
                            Margin="0,0,8,8"
                            Text="{Binding PresetSettingsNumberInput}" />
                        <Button
                            Width="140"
                            Margin="0,0,0,8"
                            Command="{Binding PresetSettingsSelectCommand}"
                            Content="Select"
                            Style="{StaticResource AccentButton}" />
                    </WrapPanel>

                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Deposit:" />
                        <Button
                            Width="140"
                            Margin="0,0,8,8"
                            Command="{Binding DepositInventoryCommand}"
                            Content="Inventory"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="140"
                            Margin="0,0,8,8"
                            Command="{Binding DepositEquipmentCommand}"
                            Content="Equipment"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="140"
                            Margin="0,0,8,8"
                            Command="{Binding DepositSummonCommand}"
                            Content="Summon"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="160"
                            Margin="0,0,0,8"
                            Command="{Binding DepositMoneyPouchCommand}"
                            Content="Money Pouch"
                            Style="{StaticResource AccentButton}" />
                    </WrapPanel>

                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Deposit Box:" />
                        <Button
                            Width="120"
                            Margin="0,0,8,8"
                            Command="{Binding DepositBoxOpenCommand}"
                            Content="Open"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="120"
                            Margin="0,0,8,8"
                            Command="{Binding DepositBoxCloseCommand}"
                            Content="Close"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="140"
                            Margin="0,0,8,8"
                            Command="{Binding DepositBoxDepositInventoryCommand}"
                            Content="Deposit Inv"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="140"
                            Margin="0,0,8,8"
                            Command="{Binding DepositBoxDepositEquipmentCommand}"
                            Content="Deposit Equip"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="160"
                            Margin="0,0,8,8"
                            Command="{Binding DepositBoxDepositMoneyCommand}"
                            Content="Deposit Money"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="140"
                            Margin="0,0,0,8"
                            Command="{Binding DepositBoxDepositAllCommand}"
                            Content="Deposit All"
                            Style="{StaticResource AccentButton}" />
                    </WrapPanel>

                    <WrapPanel Margin="0,0,0,12">
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Collection Box:" />
                        <Button
                            Width="120"
                            Margin="0,0,8,8"
                            Command="{Binding CollectionBoxOpenCommand}"
                            Content="Open"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="120"
                            Margin="0,0,8,8"
                            Command="{Binding CollectionBoxCloseCommand}"
                            Content="Close"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="160"
                            Margin="0,0,8,8"
                            Command="{Binding CollectionBoxCollectInvCommand}"
                            Content="Collect Inv"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="160"
                            Margin="0,0,0,8"
                            Command="{Binding CollectionBoxCollectBankCommand}"
                            Content="Collect Bank"
                            Style="{StaticResource AccentButton}" />
                    </WrapPanel>

                    <!--  Divider  -->
                    <Border
                        Height="1"
                        Margin="0,0,0,12"
                        Background="{DynamicResource App.BorderBrush}" />

                    <!--  Stack Lookups Section  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Stack Lookups" />
                    <WrapPanel Margin="0,0,0,12">
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Item ID:" />
                        <TextBox
                            Width="120"
                            Margin="0,0,8,8"
                            Text="{Binding IdInput}" />
                        <Button
                            Width="140"
                            Margin="0,0,12,8"
                            Command="{Binding GetStackByIdCommand}"
                            Content="Get Stack (ID)"
                            Style="{StaticResource AccentButton}" />
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Item Name:" />
                        <TextBox
                            Width="180"
                            Margin="0,0,8,8"
                            Text="{Binding NameInput}" />
                        <Button
                            Width="160"
                            Margin="0,0,0,8"
                            Command="{Binding GetStackByNameCommand}"
                            Content="Get Stack (Name)"
                            Style="{StaticResource AccentButton}" />
                    </WrapPanel>

                    <TextBlock Margin="0,0,0,12" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource App.SubtleForegroundBrush}" />
                                <Setter Property="Text" Value="{Binding StackResult, StringFormat=Result: {0}}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StackResult}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StackResult}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!--  Divider  -->
                    <Border
                        Height="1"
                        Margin="0,0,0,12"
                        Background="{DynamicResource App.BorderBrush}" />

                    <!--  Actions Section  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Item Actions" />
                    <WrapPanel>
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Action #:" />
                        <TextBox
                            Width="80"
                            Margin="0,0,12,8"
                            Text="{Binding ActionIndex}" />
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Offset:" />
                        <TextBox
                            Width="80"
                            Margin="0,0,12,8"
                            Text="{Binding Offset}" />
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Item ID:" />
                        <TextBox
                            Width="120"
                            Margin="0,0,8,8"
                            Text="{Binding IdInput}" />
                        <Button
                            Width="140"
                            Margin="0,0,12,8"
                            Command="{Binding DoActionByIdCommand}"
                            Content="Invoke by ID"
                            Style="{StaticResource AccentButton}" />
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Item Name:" />
                        <TextBox
                            Width="180"
                            Margin="0,0,8,8"
                            Text="{Binding NameInput}" />
                        <Button
                            Width="160"
                            Margin="0,0,0,8"
                            Command="{Binding DoActionByNameCommand}"
                            Content="Invoke by Name"
                            Style="{StaticResource AccentButton}" />
                    </WrapPanel>

                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="11"
                        FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Text" Value="{Binding ActionResult}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActionResult}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ActionResult}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </StackPanel>
                </Expander>
            </Border>

            <!--  Items Grid Card  -->
            <Border
                behaviors:PanelLayoutBehavior.PanelKey="bank-items"
                Margin="0,12,0,0"
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <Expander Header="Bank Items" IsExpanded="True">
                    <StackPanel Margin="0,10,0,0">
                    <TextBlock
                        Margin="0,4,0,12"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Load and view all items currently in the bank." />
                    <WrapPanel Margin="0,0,0,12">
                        <Button
                            Width="140"
                            Margin="0,0,12,0"
                            Command="{Binding LoadItemsCommand}"
                            Content="Load Items"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="100"
                            Command="{Binding ClearItemsCommand}"
                            Content="Clear" />
                        <TextBlock
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource App.SubtleForegroundBrush}">
                            <Run Text="Items:" />
                            <Run
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding ItemCount, Mode=OneWay}" />
                        </TextBlock>
                    </WrapPanel>

                    <!--  Items DataGrid  -->
                    <Border Background="{DynamicResource App.CardBrush}" CornerRadius="8">
                        <DataGrid
                            Height="360"
                            Margin="5"
                            AutoGenerateColumns="False"
                            Background="{DynamicResource App.BackgroundBrush}"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserSortColumns="True"
                            EnableColumnVirtualization="True"
                            EnableRowVirtualization="True"
                            Foreground="{DynamicResource App.ForegroundBrush}"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding Items}"
                            RowBackground="{DynamicResource App.CardBrush}"
                            ScrollViewer.CanContentScroll="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="50"
                                    Binding="{Binding Slot}"
                                    Header="Slot" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding Id}"
                                    Header="ID" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="150"
                                    Binding="{Binding Name}"
                                    Header="Name" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding Stack}"
                                    Header="Stack" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Category}"
                                    Header="Category" />
                                <DataGridTemplateColumn Width="170" Header="Flags">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemFlagBadgesTemplate}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
