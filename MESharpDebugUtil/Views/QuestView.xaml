<UserControl
    x:Class="MESharp.Views.QuestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:MESharp.ViewModels"
    Background="{DynamicResource App.BackgroundBrush}"
    Foreground="{DynamicResource App.ForegroundBrush}"
    d:DataContext="{d:DesignInstance viewModels:QuestViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Controls row -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button
                Margin="0,0,6,0"
                Padding="10,4"
                Command="{Binding LoadQuestsCommand}"
                Content="Load Quests" />
            <TextBox
                Width="240"
                Margin="0,0,6,0"
                VerticalContentAlignment="Center"
                Text="{Binding QuestName, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="Quest name (display name or list name)" />
            <Button
                Margin="0,0,6,0"
                Padding="10,4"
                Command="{Binding GetQuestCommand}"
                Content="Get Quest" />
            <Button
                Margin="0,0,6,0"
                Padding="10,4"
                Command="{Binding WatchBeginCommand}"
                Content="Watch: Begin" />
            <Button
                Padding="10,4"
                Command="{Binding WatchDiffCommand}"
                Content="Watch: Diff" />
        </StackPanel>

        <!-- Main content: quest list | details + changes -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="{Binding QuestCount, StringFormat='Quests ({0})'}">
                <ListBox
                    ItemsSource="{Binding Quests}"
                    SelectedItem="{Binding SelectedQuest, Mode=TwoWay}" />
            </GroupBox>

            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Quest Detail">
                    <ScrollViewer>
                        <TextBox
                            IsReadOnly="True"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{DynamicResource App.ForegroundBrush}"
                            FontFamily="Consolas"
                            TextWrapping="Wrap"
                            Text="{Binding Details, Mode=OneWay}" />
                    </ScrollViewer>
                </GroupBox>

                <GroupBox Grid.Row="1" Margin="0,8,0,0" Header="Varbit Changes (last diff)">
                    <DataGrid
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding Changes}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding VarbitId}" Header="Varbit" Width="120" />
                            <DataGridTextColumn Binding="{Binding OldValue}" Header="Old" Width="100" />
                            <DataGridTextColumn Binding="{Binding NewValue}" Header="New" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="6,4" Background="{DynamicResource App.PanelBrush}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Kind="BookOpenPageVariant" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Status}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
