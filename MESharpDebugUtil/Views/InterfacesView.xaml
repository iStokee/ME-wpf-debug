<UserControl
    x:Class="MESharp.Views.InterfacesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:MESharp.Views.Behaviors"
    xmlns:controls="clr-namespace:MESharp.Views.Controls"
    xmlns:conv="clr-namespace:MESharp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:InterfacesViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <Style x:Key="InterfacePanelCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource App.CardBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style x:Key="InterfacePanelTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            </Style>

            <Style x:Key="InterfacePanelSectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="Margin" Value="0,8,0,4" />
            </Style>

            <Style x:Key="InterfaceKeyLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource App.SubtleForegroundBrush}" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <Style x:Key="InterfaceValueText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                <Setter Property="Margin" Value="12,0,0,0" />
            </Style>

            <Style
                x:Key="InterfacePanelButton"
                BasedOn="{StaticResource SecondaryCommandButton}"
                TargetType="Button">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Margin" Value="0,0,8,8" />
            </Style>

            <Style x:Key="InterfaceToolbarButton" BasedOn="{StaticResource InterfacePanelButton}" TargetType="Button">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="MinWidth" Value="116" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="InterfaceInputTextBox" TargetType="TextBox">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource App.BackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="InterfaceCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
            </Style>

            <Style x:Key="InterfaceTreeItemStyle" TargetType="TreeViewItem">
                <EventSetter Event="Expanded" Handler="OnInterfaceTreeItemExpanded" />
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="Padding" Value="5,3" />
                <Setter Property="Margin" Value="2,4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
                <Setter Property="Background" Value="{DynamicResource App.BackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsSelected" Value="True" />
                            <Condition Property="IsSelectionActive" Value="False" />
                        </MultiTrigger.Conditions>
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="InterfaceTreeNodeCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="InterfaceColumnSplitterStyle" TargetType="GridSplitter">
                <Setter Property="Width" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
                <Setter Property="ResizeDirection" Value="Columns" />
                <Setter Property="ShowsPreview" Value="True" />
                <Setter Property="Margin" Value="0,10,0,10" />
            </Style>

            <Style x:Key="InterfaceSectionExpanderStyle" TargetType="Expander">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        Margin="5"
        behaviors:PanelLayoutBehavior.PageKey="interfaces-view-v2"
        behaviors:PanelLayoutBehavior.ColumnKey="left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <controls:SectionHeader
            Title="Interface Scanner"
            Grid.Row="0"
            Margin="0,0,0,10"
            Description="Scan and visualize RuneScape 3 interface components."
            HelpCommand="{Binding DataContext.ShowApiDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
            IconKind="ViewDashboardOutline" />

        <!--  Controls  -->
        <Border
            Grid.Row="1"
            behaviors:PanelLayoutBehavior.PanelKey="controls"
            behaviors:PanelLayoutBehavior.IsHeightResizable="False"
            Margin="0,0,0,10"
            Padding="10"
            Background="{DynamicResource App.CardBrush}"
            BorderBrush="{DynamicResource App.BorderBrush}"
            BorderThickness="1"
            CornerRadius="5">
            <Expander Header="Controls" IsExpanded="True">
                <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Command="{Binding LoadInterfacesCommand}"
                    Style="{StaticResource AccentButton}"
                    MinHeight="32"
                    MinWidth="128"
                    Padding="14,5"
                    Margin="0,0,10,8">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="Refresh" />
                        <TextBlock Text="Load Interfaces" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Command="{Binding ClearCommand}"
                    Style="{StaticResource InterfaceToolbarButton}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="Close" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="10,0,10,8"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <CheckBox
                        Content="Freeze"
                        Style="{StaticResource InterfaceCheckBoxStyle}"
                        IsChecked="{Binding FreezeRefresh}" />
                    <CheckBox
                        Content="Auto Refresh"
                        Style="{StaticResource InterfaceCheckBoxStyle}"
                        IsChecked="{Binding AutoRefresh}" />
                    <CheckBox
                        Content="Include Hidden"
                        Style="{StaticResource InterfaceCheckBoxStyle}"
                        IsChecked="{Binding IncludeHidden}" />
                    <CheckBox
                        Content="Text Only"
                        Style="{StaticResource InterfaceCheckBoxStyle}"
                        IsChecked="{Binding TextOnly}" />
                    <CheckBox
                        Content="Highlight Selection"
                        Style="{StaticResource InterfaceCheckBoxStyle}"
                        IsChecked="{Binding HighlightSelection}" />
                    <CheckBox
                        Content="Keep Highlight"
                        Style="{StaticResource InterfaceCheckBoxStyle}"
                        IsChecked="{Binding KeepHighlight}" />
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Text="Highlight ms:" />
                    <TextBox
                        Width="70"
                        Style="{StaticResource InterfaceInputTextBox}"
                        Text="{Binding HighlightDurationMs, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Text="Root ID:" />
                    <TextBox
                        Width="80"
                        Margin="0,0,10,0"
                        Style="{StaticResource InterfaceInputTextBox}"
                        Text="{Binding RootIdText, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        Content="Focus Root"
                        Style="{StaticResource InterfaceCheckBoxStyle}"
                        IsChecked="{Binding FocusRoot}" />
                    <Button
                        Margin="0,0,12,0"
                        Command="{Binding UseSelectedRootCommand}"
                        Style="{StaticResource InterfaceToolbarButton}">
                        <TextBlock Text="Use Selected Root" />
                    </Button>
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Text="Index filters:" />
                    <CheckBox
                        Content="[1]"
                        Style="{StaticResource InterfaceCheckBoxStyle}"
                        IsChecked="{Binding FilterIndex1}" />
                    <CheckBox
                        Content="[2]"
                        Style="{StaticResource InterfaceCheckBoxStyle}"
                        IsChecked="{Binding FilterIndex2}" />
                    <CheckBox
                        Content="[3]"
                        Style="{StaticResource InterfaceCheckBoxStyle}"
                        IsChecked="{Binding FilterIndex3}" />
                    <TextBlock
                        Margin="14,0,6,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Text="Find:" />
                    <TextBox
                        Width="260"
                        Margin="0,0,8,0"
                        Style="{StaticResource InterfaceInputTextBox}"
                        Text="{Binding FindQuery, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Search by id tuple (id1:id2:id3), memloc (0x...), path, or text." />
                    <Button
                        Command="{Binding FindInterfaceCommand}"
                        Style="{StaticResource InterfaceToolbarButton}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Kind="Magnify" />
                            <TextBlock Text="Find Match" />
                        </StackPanel>
                    </Button>
                    <CheckBox
                        Content="Filter XY"
                        Style="{StaticResource InterfaceCheckBoxStyle}"
                        IsChecked="{Binding FilterByPoint}" />
                    <TextBlock
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Text="X:" />
                    <TextBox
                        Width="70"
                        Margin="0,0,6,0"
                        Style="{StaticResource InterfaceInputTextBox}"
                        Text="{Binding PointXText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Text="Y:" />
                    <TextBox
                        Width="70"
                        Margin="0,0,6,0"
                        Style="{StaticResource InterfaceInputTextBox}"
                        Text="{Binding PointYText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Text="R:" />
                    <TextBox
                        Width="46"
                        Style="{StaticResource InterfaceInputTextBox}"
                        Text="{Binding PointRadius, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Margin="0,8,0,0"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding ExpandAllCommand}"
                        Style="{StaticResource InterfaceToolbarButton}">
                        <TextBlock Text="Expand All" />
                    </Button>
                    <Button
                        Margin="0,0,12,0"
                        Command="{Binding CollapseAllCommand}"
                        Style="{StaticResource InterfaceToolbarButton}">
                        <TextBlock Text="Collapse All" />
                    </Button>
                    <Button
                        Margin="0,0,12,0"
                        Command="{Binding CancelExpandAllCommand}"
                        Style="{StaticResource InterfaceToolbarButton}">
                        <TextBlock Text="Cancel Expand" />
                    </Button>
                    <CheckBox
                        Content="Show Known Only"
                        Style="{StaticResource InterfaceCheckBoxStyle}"
                        IsChecked="{Binding ShowKnownOnly}" />
                    <CheckBox
                        Content="Show Diff Only"
                        Style="{StaticResource InterfaceCheckBoxStyle}"
                        IsChecked="{Binding ShowDiffOnly}" />
                    <Button
                        Margin="0,0,12,0"
                        Command="{Binding ResetListDiffBaselineCommand}"
                        Style="{StaticResource InterfaceToolbarButton}">
                        <TextBlock Text="Reset Diff Baseline" />
                    </Button>
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                        Text="{Binding ExpandAllStatus}" />
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                        Text="{Binding DiffStatus}" />
                </StackPanel>
                </Grid>
            </Expander>
        </Border>

        <!--  Interface Tree  -->
        <Border
            Grid.Row="2"
            behaviors:PanelLayoutBehavior.PanelKey="interface-tree-details"
            Margin="0,0,0,10"
            Background="{DynamicResource App.CardBrush}"
            BorderBrush="{DynamicResource App.BorderBrush}"
            BorderThickness="1"
            CornerRadius="5">
            <Expander Header="Interface Tree &amp; Details" IsExpanded="True">
                <Grid
                    Margin="0,10,0,0"
                    behaviors:GridColumnLayoutBehavior.LayoutKey="interfaces-view-tree-columns"
                    behaviors:GridColumnLayoutBehavior.ColumnIndexes="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="1.2*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Margin="10,10,6,10"
                    Background="{DynamicResource App.BackgroundBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Border
                        Margin="8"
                        Background="{DynamicResource App.CardBrush}"
                        BorderBrush="{DynamicResource App.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasInterfaces}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <TreeView
                                    Margin="4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VirtualizingStackPanel.IsVirtualizing="True"
                                    VirtualizingStackPanel.VirtualizationMode="Recycling"
                                    ScrollViewer.CanContentScroll="True"
                                    ItemContainerStyle="{StaticResource InterfaceTreeItemStyle}"
                                    ItemsSource="{Binding AllInterfaces}"
                                    SelectedItemChanged="OnSelectedInterfaceChanged">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <Border Style="{StaticResource InterfaceTreeNodeCardStyle}">
                                                <StackPanel Margin="1">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding DisplayText}" />
                                                    <TextBlock
                                                        Margin="0,1,0,0"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                                        Text="{Binding CoordinatesText}" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource PrimaryBrush}"
                                                        Text="{Binding Text}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{Binding HasText, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock
                                                        Margin="0,1,0,0"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource PrimaryBrush}"
                                                        Text="{Binding ItemText}"
                                                        Visibility="{Binding HasItem, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                                        Text="{Binding KnownLabel}"
                                                        Visibility="{Binding HasKnownLabel, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Border>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </ScrollViewer>

                            <Border
                                Margin="8"
                                Padding="14"
                                Background="{DynamicResource App.BackgroundBrush}"
                                BorderBrush="{DynamicResource App.BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasInterfaces}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel VerticalAlignment="Center">
                                    <iconPacks:PackIconMaterial
                                        Width="24"
                                        Height="24"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Center"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Kind="ViewList" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource App.ForegroundBrush}"
                                        Text="No interfaces loaded" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                        Text="Use 'Load Interfaces' in Controls to scan the game UI."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Border>

                <GridSplitter
                    Grid.Column="1"
                    Style="{StaticResource InterfaceColumnSplitterStyle}" />

                <Border
                    Grid.Column="2"
                    Margin="6,10,10,10"
                    Background="{DynamicResource App.BackgroundBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <Border Style="{StaticResource InterfacePanelCard}">
                                <Expander IsExpanded="True" Style="{StaticResource InterfaceSectionExpanderStyle}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                Kind="InformationOutline" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource InterfacePanelTitle}"
                                                Text="Selection Details" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock
                                            Margin="0,4,0,8"
                                            FontSize="11"
                                            Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                            Text="{Binding SelectedInterfaceLabel}" />

                                    <TextBlock Style="{StaticResource InterfacePanelSectionTitle}" Text="Identity" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Id1" />
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.Id1}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Id2" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.Id2}" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Id3" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.Id3}" />
                                        <TextBlock
                                            Grid.Row="3"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Known" />
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterfaceKnownLabel}" />

                                        <TextBlock
                                            Grid.Row="4"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="X" />
                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.X}" />
                                        <TextBlock
                                            Grid.Row="5"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Y" />
                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.Y}" />
                                        <TextBlock
                                            Grid.Row="6"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="W" />
                                        <TextBlock
                                            Grid.Row="6"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.Width}" />
                                        <TextBlock
                                            Grid.Row="7"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="H" />
                                        <TextBlock
                                            Grid.Row="7"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.Height}" />
                                        <TextBlock
                                            Grid.Row="8"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Box X" />
                                        <TextBlock
                                            Grid.Row="8"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.BoxX}" />
                                        <TextBlock
                                            Grid.Row="9"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Box Y" />
                                        <TextBlock
                                            Grid.Row="9"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.BoxY}" />
                                        <TextBlock
                                            Grid.Row="10"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Scroll" />
                                        <TextBlock
                                            Grid.Row="10"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.ScrollY}" />
                                        <TextBlock
                                            Grid.Row="11"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Mem" />
                                        <TextBlock
                                            Grid.Row="11"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.MemLoc, StringFormat=0x{0:X}}" />
                                        <TextBlock
                                            Grid.Row="12"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Top" />
                                        <TextBlock
                                            Grid.Row="12"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.MemLocTop, StringFormat=0x{0:X}}" />
                                    </Grid>
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <Border Style="{StaticResource InterfacePanelCard}">
                                <Expander IsExpanded="True" Style="{StaticResource InterfaceSectionExpanderStyle}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                Kind="TextBoxOutline" />
                                            <TextBlock Style="{StaticResource InterfacePanelTitle}" Text="Text &amp; Item" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource InterfacePanelSectionTitle}" Text="Text" />
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{Binding SelectedInterfaceTextItem}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                        Text="{Binding SelectedInterface.TextIds}"
                                        TextWrapping="Wrap" />

                                    <TextBlock Style="{StaticResource InterfacePanelSectionTitle}" Text="Item" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Item" />
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.ItemId}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Stack" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.ItemStack}" />
                                    </Grid>
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <Border Style="{StaticResource InterfacePanelCard}">
                                <Expander IsExpanded="False" Style="{StaticResource InterfaceSectionExpanderStyle}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                Kind="VectorPolyline" />
                                            <TextBlock Style="{StaticResource InterfacePanelTitle}" Text="Paths" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource InterfacePanelSectionTitle}" Text="Paths" />
                                    <TextBlock
                                        Style="{StaticResource InterfaceKeyLabel}"
                                        Text="Memory address" />
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        Text="{Binding SelectedInterface.FullPath}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource InterfaceKeyLabel}"
                                        Text="Interface layers" />
                                    <TextBlock
                                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                        Text="{Binding SelectedInterface.FullIdPath}"
                                        TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <Border Margin="0,10,0,0" Style="{StaticResource InterfacePanelCard}">
                                <Expander IsExpanded="False" Style="{StaticResource InterfaceSectionExpanderStyle}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                Kind="ChatProcessingOutline" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource InterfacePanelTitle}"
                                                Text="Dialogs" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,10,0,0">

                                    <TextBlock
                                        Margin="0,4,0,8"
                                        FontSize="11"
                                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                        Text="Helpers for dialog continue/select. (Moved from Utilities.)" />

                                    <TextBlock Style="{StaticResource InterfacePanelSectionTitle}" Text="Option Text" />
                                    <TextBox Margin="0,4,0,10" Text="{Binding DialogOptionText}" />

                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,8,0"
                                            Padding="10,4"
                                            Command="{Binding DialogSelectCommand}"
                                            Content="Select" />
                                        <Button
                                            Padding="10,4"
                                            Command="{Binding DialogContinueCommand}"
                                            Content="Continue" />
                                    </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <Border Style="{StaticResource InterfacePanelCard}">
                                <Expander IsExpanded="False" Style="{StaticResource InterfaceSectionExpanderStyle}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                Kind="PlayCircleOutline" />
                                            <TextBlock Style="{StaticResource InterfacePanelTitle}" Text="Actions" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,8,8"
                                            Command="{Binding RefreshSelectedCommand}"
                                            Style="{StaticResource InterfacePanelButton}">
                                            <TextBlock Text="Refresh Selected" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="0,0,0,8"
                                            Command="{Binding UseSelectedRootCommand}"
                                            Style="{StaticResource InterfacePanelButton}">
                                            <TextBlock Text="Use as Root" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,0,8,0"
                                            Command="{Binding HighlightSelectedCommand}"
                                            Style="{StaticResource InterfacePanelButton}">
                                            <TextBlock Text="Highlight Selected" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Command="{Binding ClearHighlightCommand}"
                                            Style="{StaticResource InterfacePanelButton}">
                                            <TextBlock Text="Clear Highlight" />
                                        </Button>
                                    </Grid>
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <Border Margin="0" Style="{StaticResource InterfacePanelCard}">
                                <Expander IsExpanded="False" Style="{StaticResource InterfaceSectionExpanderStyle}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                Kind="FileSend" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource InterfacePanelTitle}"
                                                Text="Overrides" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,10,0,0">
                                    <TextBlock
                                        Margin="0,4,0,6"
                                        FontSize="11"
                                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                        Text="Save friendly keys for interface IDs and reload them later." />
                                    <TextBlock
                                        Margin="0,4,0,8"
                                        FontSize="11"
                                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                        Text="{Binding OverridesPath}"
                                        TextWrapping="Wrap" />

                                    <TextBlock Style="{StaticResource InterfaceKeyLabel}" Text="New key" />
                                    <TextBox Margin="0,4,0,6" Text="{Binding NewOverrideKey, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Margin="0,0,0,10"
                                        Command="{Binding CaptureOverrideCommand}"
                                        Style="{StaticResource InterfacePanelButton}"
                                        ToolTip="Save the selected interface as the key above.">
                                        <TextBlock Text="Capture Selected" />
                                    </Button>

                                    <ListBox
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemsSource="{Binding Overrides}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,0,6"
                                                    Padding="6"
                                                    Background="{DynamicResource App.BackgroundBrush}"
                                                    BorderBrush="{DynamicResource App.BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Text="{Binding Display}"
                                                            TextWrapping="Wrap" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            Command="{Binding DataContext.RemoveOverrideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource InterfacePanelButton}"
                                                            ToolTip="Remove this override from the list.">
                                                            <TextBlock Text="Remove" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <WrapPanel>
                                        <Button
                                            Margin="0,0,8,0"
                                            Command="{Binding LoadOverridesCommand}"
                                            Style="{StaticResource InterfacePanelButton}"
                                            ToolTip="Load overrides from the JSON file and refresh the list.">
                                            <TextBlock Text="Load JSON" />
                                        </Button>
                                        <Button
                                            Command="{Binding ExportOverridesCommand}"
                                            Style="{StaticResource InterfacePanelButton}"
                                            ToolTip="Write the current list to the JSON file.">
                                            <TextBlock Text="Export JSON" />
                                        </Button>
                                    </WrapPanel>
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                </Grid>
            </Expander>
        </Border>

        <!--  Compact Status Bar  -->
        <Border
            Grid.Row="3"
            Margin="0,0,0,0"
            Padding="10,8"
            Background="{DynamicResource App.CardBrush}"
            BorderBrush="{DynamicResource App.BorderBrush}"
            BorderThickness="1"
            CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,18,0"
                    Orientation="Horizontal">
                    <iconPacks:PackIconMaterial
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Kind="ViewList" />
                    <TextBlock VerticalAlignment="Center" Text="Interfaces:" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Text="{Binding InterfaceCount, Mode=OneWay}" />
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Text="Known:" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Text="{Binding KnownInterfaceCount, Mode=OneWay}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource App.SubtleForegroundBrush}"
                    Text="{Binding StatusMessage}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
