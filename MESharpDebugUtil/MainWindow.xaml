<Window
    x:Class="MESharp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:MESharp.Converters"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:views="clr-namespace:MESharp.Views"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    Title="MESharp Debug Util"
    Width="1200"
    Height="900"
    MinWidth="900"
    Background="Transparent"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <!--  Enable OS-level chrome for smoother dragging on the top caption area  -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="40"
            CornerRadius="10"
            GlassFrameThickness="0"
            ResizeBorderThickness="5"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <vm:MainWindowViewModel x:Key="MainWindowViewModel" />
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:ObjectEqualsConverter x:Key="ObjectEqualsConverter" />

            <!--  Local fallback for title bar buttons (ensures resources exist in script host)  -->
            <Style x:Key="WindowControlButton" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource App.SubtleForegroundBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimarySoftBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource App.MutedBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style
                x:Key="CloseWindowButton"
                BasedOn="{StaticResource WindowControlButton}"
                TargetType="Button">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource DangerHoverBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource DangerPressedBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource DangerPressedBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  Local fallback for section help buttons  -->
            <Style x:Key="HeaderHelpButton" TargetType="Button">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource App.SubtleForegroundBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource App.MutedBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  Local fallback command button styles (protects hot-reload when theme dictionaries aren't ready)  -->
            <Style x:Key="PrimaryCommandButton" TargetType="Button">
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimarySoftBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Opacity" Value="0.92" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.6" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style
                x:Key="SecondaryCommandButton"
                BasedOn="{StaticResource PrimaryCommandButton}"
                TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource App.BackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimarySoftBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Opacity" Value="0.92" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.6" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  DataTemplates for Views  -->
            <DataTemplate DataType="{x:Type vm:GameViewModel}">
                <views:GameView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ChatViewModel}">
                <views:ChatView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SkillsViewModel}">
                <views:SkillsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlayersViewModel}">
                <views:PlayersView />
            </DataTemplate>
            <!--<DataTemplate DataType="{x:Type vm:EquipmentViewModel}">
                <views:EquipmentView />
            </DataTemplate>-->
            <!--<DataTemplate DataType="{x:Type vm:BankViewModel}">
                <views:BankView />
            </DataTemplate>-->
            <!--<DataTemplate DataType="{x:Type vm:LootViewModel}">
                <views:LootView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MaterialCacheViewModel}">
                <views:MaterialCacheView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TradeWindowViewModel}">
                <views:TradeWindowView />
            </DataTemplate>-->
            <DataTemplate DataType="{x:Type vm:ItemsUnifiedViewModel}">
                <views:ItemsUnifiedView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GrandExchangeViewModel}">
                <views:GrandExchangeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ObjectsUnifiedViewModel}">
                <views:ObjectsUnifiedView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InterfacesViewModel}">
                <views:InterfacesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DungeoneeringDebugViewModel}">
                <views:DungeoneeringDebugView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MiscApiViewModel}">
                <views:MiscApiView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VarbitViewModel}">
                <views:VarbitView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:QuestViewModel}">
                <views:QuestView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ApiDocsViewModel}">
                <views:ApiDocsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:KnowledgeViewModel}">
                <views:KnowledgeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:McpViewModel}">
                <views:McpView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HelpViewModel}">
                <views:HelpView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HowToUseViewModel}">
                <views:HowToUseView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ThemeSettingsViewModel}">
                <views:ThemeSettingsView />
            </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <Border
        Background="{DynamicResource App.BackgroundBrush}"
        BorderBrush="{DynamicResource PrimaryBrush}"
        BorderThickness="2"
        CornerRadius="0 0 0 0">

        <DockPanel>
            <!--  Custom Title Bar  -->
            <Border
                Height="40"
                Background="{DynamicResource App.CardBrush}"
                DockPanel.Dock="Top">
                <Grid x:Name="TitleBarGrid" MouseLeftButtonDown="OnTitleBarMouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Width="18"
                            Height="18"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Kind="Bug" />
                        <TextBlock
                            Margin="5,-2,0,0"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource App.ForegroundBrush}"
                            Text="MESharp Debug Util" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Width="18"
                            Height="18"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Kind="TimerOutline" />
                        <TextBlock
                            Margin="5,0,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource App.ForegroundBrush}"
                            Text="Session:" />
                        <TextBlock
                            Margin="5,2.5,5,0"
                            FontFamily="Consolas"
                            FontSize="14"
                            Foreground="{DynamicResource App.ForegroundBrush}"
                            Text="{Binding SessionRuntimeString}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Width="40"
                            Height="28"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnMinimizeClick"
                            Style="{StaticResource WindowControlButton}"
                            ToolTip="Minimize">
                            <iconPacks:PackIconMaterial Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Kind="WindowMinimize" />
                        </Button>
                        <Button
                            Width="40"
                            Height="28"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnMaximizeClick"
                            Style="{StaticResource WindowControlButton}"
                            ToolTip="Maximize/Restore">
                            <iconPacks:PackIconMaterial Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Kind="WindowMaximize" />
                        </Button>
                        <Button
                            Width="40"
                            Height="28"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnCloseClick"
                            Style="{StaticResource CloseWindowButton}"
                            ToolTip="Close">
                            <iconPacks:PackIconMaterial Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Kind="Close" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Divider under title bar  -->
            <Border
                Height="1"
                Background="{DynamicResource PrimaryBrush}"
                DockPanel.Dock="Top" />
            <!--  Top Tab Bar with Horizontal Scrolling  -->
            <Border
                Height="56"
                Margin="4,5,4,0"
                Background="{DynamicResource App.CardBrush}"
                DockPanel.Dock="Top">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    PanningMode="HorizontalOnly"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowApiDocsCommand}"
                            IsChecked="{Binding IsApiDocsSelected, Mode=OneWay}"
                            ToolTip="Browse MESharp API documentation">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="BookOpenPageVariant" />
                                <TextBlock Text="API Docs" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowKnowledgeCommand}"
                            IsChecked="{Binding IsKnowledgeSelected, Mode=OneWay}"
                            ToolTip="Search and curate shared MESharp knowledge">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="Brain" />
                                <TextBlock Text="Knowledge" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowMcpCommand}"
                            IsChecked="{Binding IsMcpSelected, Mode=OneWay}"
                            ToolTip="MCP bridge status, request activity, and tool catalog">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="ServerNetwork" />
                                <TextBlock Text="MCP" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowGameCommand}"
                            IsChecked="{Binding IsGameSelected, Mode=OneWay}"
                            ToolTip="Game">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="ApplicationCog" />
                                <TextBlock Text="Game" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowChatCommand}"
                            IsChecked="{Binding IsChatSelected, Mode=OneWay}"
                            ToolTip="Chat">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="Message" />
                                <TextBlock Text="Chat" />
                            </StackPanel>
                        </ToggleButton>
                        <!--  Apply the new style to the navigation buttons  -->
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowSkillsCommand}"
                            IsChecked="{Binding IsSkillsSelected, Mode=OneWay}"
                            ToolTip="Skills">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="Trophy" />
                                <TextBlock Text="Skills" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowPlayersCommand}"
                            IsChecked="{Binding IsPlayersSelected, Mode=OneWay}"
                            ToolTip="Players - LocalPlayer and Nearby Players">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="AccountMultiple" />
                                <TextBlock Text="Players" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowItemsUnifiedCommand}"
                            IsChecked="{Binding IsItemsUnifiedSelected, Mode=OneWay}"
                            ToolTip="Items - All Containers">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="PackageVariantClosed" />
                                <TextBlock Text="Items" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowGrandExchangeCommand}"
                            IsChecked="{Binding IsGrandExchangeSelected, Mode=OneWay}"
                            ToolTip="Grand Exchange">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="Store" />
                                <TextBlock Text="GE" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowObjectsUnifiedCommand}"
                            IsChecked="{Binding IsObjectsUnifiedSelected, Mode=OneWay}"
                            ToolTip="Objects - NPCs and Game Objects">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="CubeOutline" />
                                <TextBlock Text="Objects" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowVarbitCommand}"
                            IsChecked="{Binding IsVarbitSelected, Mode=OneWay}"
                            ToolTip="Varbits">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="Memory" />
                                <TextBlock Text="Varbits" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowQuestCommand}"
                            IsChecked="{Binding IsQuestSelected, Mode=OneWay}"
                            ToolTip="Quest API">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="BookOpenPageVariant" />
                                <TextBlock Text="Quest" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowInterfacesCommand}"
                            IsChecked="{Binding IsInterfacesSelected, Mode=OneWay}"
                            ToolTip="Interfaces Debug">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="MonitorDashboard" />
                                <TextBlock Text="Interfaces" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowDungeoneeringDebugCommand}"
                            IsChecked="{Binding IsDungeoneeringDebugSelected, Mode=OneWay}"
                            ToolTip="Dungeoneering-specific debug probes">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="MapSearch" />
                                <TextBlock Text="Dungeoneering" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowMiscApiCommand}"
                            IsChecked="{Binding IsMiscApiSelected, Mode=OneWay}"
                            ToolTip="Misc API helpers">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="Tools" />
                                <TextBlock Text="Misc API" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowHelpCommand}"
                            IsChecked="{Binding IsHelpSelected, Mode=OneWay}"
                            ToolTip="Help">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="HelpCircleOutline" />
                                <TextBlock Text="Help" />
                            </StackPanel>
                        </ToggleButton>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  Content Area  -->
            <ContentControl Margin="4" Content="{Binding CurrentViewModel}" />
        </DockPanel>
    </Border>
</Window>
