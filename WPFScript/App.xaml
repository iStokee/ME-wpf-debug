<Application
    x:Class="MESharp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MESharp"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Default to Light theme; ThemeManager can swap at runtime  -->
                <ResourceDictionary Source="Themes/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Acrylic "glass" brush  -->
            <Color x:Key="AcrylicBackgroundColor">#CCFFFFFF</Color>
            <SolidColorBrush x:Key="AcrylicBackgroundBrush" Color="{DynamicResource AcrylicBackgroundColor}" />

            <!--  Default Primary color resources to prevent white fill on mouseover before theme loads  -->
            <Color x:Key="PrimaryColor">#FF3F51B5</Color>
            <SolidColorBrush x:Key="PrimaryBrush" Color="#FF3F51B5" />
            <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="PrimarySoftBrush" Color="#333F51B5" />

        </ResourceDictionary>
    </Application.Resources>

</Application>
