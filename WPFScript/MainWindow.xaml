<Window x:Class="MESharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:MESharp.ViewModels"
        xmlns:conv="clr-namespace:MESharp.Converters"
        mc:Ignorable="d"
        Title="Skills Tracker" 
        Height="500" Width="900"
        Background="#FF232323">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToStringConverter x:Key="BoolToString"/>
        <conv:ToOpacityBrushConverter x:Key="ToOpacityBrush"/>
        <!-- overall window & card background -->
        <SolidColorBrush x:Key="AppBackground"    Color="#5f5f62"/>
        <SolidColorBrush x:Key="CardBackground"   Color="#44444a"/>

        <!-- Outer “chrome” outline -->
        <Style x:Key="SkillChromeBorderStyle" TargetType="Border">
            <!-- spacing between cards -->
            <Setter Property="Margin" Value="6"/>
            <!-- gap between chrome and gradient -->
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="CornerRadius" Value="10"/>
            <!-- 2px larger than inner -->
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <!-- 40% white -->
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Inner gradient border -->
        <Style x:Key="SkillCardStyle" TargetType="Border">
            <!-- NO margin or padding here! -->
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderThickness" Value="6"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush>
                        <GradientStop Color="{Binding PrimaryBrush.Color}"   Offset="0"/>
                        <GradientStop Color="{Binding SecondaryBrush.Color}" Offset="0.33"/>
                        <GradientStop Color="{Binding PrimaryBrush.Color}" Offset="0.66"/>
                        <GradientStop Color="{Binding SecondaryBrush.Color}" Offset="0.99"/>

                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- text styles for consistent padding & alignment -->
        <Style x:Key="SkillTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Margin"    Value="0,4,0,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        
        <Style x:Key="SkillTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SkillTextBlockStyle}">
            <Setter Property="FontSize"     Value="17"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Margin"       Value="0,0,0,0"/>
        </Style>

        <!-- A “list” card: same outer chrome, but horizontal layout -->
        <DataTemplate x:Key="ListSkillTemplate">
            <Border Style="{StaticResource SkillChromeBorderStyle}">
                <Border Style="{StaticResource SkillCardStyle}">
                    <StackPanel Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
                        <!-- Name -->
                        <TextBlock Text="{Binding Name}"
                     Style="{StaticResource SkillTitleTextStyle}"
                     Width="120"/>
                        <!-- Spacer -->
                        <Separator Width="16" Visibility="Hidden"/>
                        <!-- Metrics -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Xp, StringFormat=N0}" Style="{StaticResource SkillTextBlockStyle}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding XpGained, StringFormat=N0}" Style="{StaticResource SkillTextBlockStyle}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding XpPerHour, StringFormat=N0}" Style="{StaticResource SkillTextBlockStyle}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding XpToNext, StringFormat=N0}" Style="{StaticResource SkillTextBlockStyle}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding EtaString}" Style="{StaticResource SkillTextBlockStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </DataTemplate>

        <!-- 1) The “grid” card (copy of your existing inline DataTemplate) -->
        <DataTemplate x:Key="GridSkillTemplate">
            <Border Style="{StaticResource SkillChromeBorderStyle}">
                <Border Style="{StaticResource SkillCardStyle}">
                    <StackPanel Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
                        <!-- Name -->
                        <TextBlock Text="{Binding Name}"
                     Style="{StaticResource SkillTitleTextStyle}"
                     Width="120"/>
                        <!-- Spacer -->
                        <Separator Width="16" Visibility="Hidden"/>
                        <!-- Metrics -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Xp, StringFormat=N0}" Style="{StaticResource SkillTextBlockStyle}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding XpGained, StringFormat=N0}" Style="{StaticResource SkillTextBlockStyle}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding XpPerHour, StringFormat=N0}" Style="{StaticResource SkillTextBlockStyle}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding XpToNext, StringFormat=N0}" Style="{StaticResource SkillTextBlockStyle}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding EtaString}" Style="{StaticResource SkillTextBlockStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </DataTemplate>

        <!-- Two ItemsPanelTemplates -->
        <ItemsPanelTemplate x:Key="GridItemsPanel">
            <WrapPanel ItemWidth="225" Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        
        <ItemsPanelTemplate x:Key="ListItemsPanel">
            <StackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>

        <!-- Stylized Dark ToggleButton -->
        <Style x:Key="DarkToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#393943"/>
            <Setter Property="BorderBrush" Value="#595967"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border 
                    x:Name="border"
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- MouseOver/Focus -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#51515f"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#8888a3"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#99ccff"/>
                            </Trigger>
                            <!-- Pressed -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22222b"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#bbf"/>
                            </Trigger>
                            <!-- Checked (Toggled) -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#23233a"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#51a8ff"/>
                                <Setter Property="Foreground" Value="#51a8ff"/>
                            </Trigger>
                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#333337"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#26262a"/>
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <DockPanel Margin="12">
        <!-- Header: toggle + session runtime -->
        <StackPanel DockPanel.Dock="Top" 
                Orientation="Horizontal" 
                VerticalAlignment="Center"
                Margin="0,0,0,8">
            <ToggleButton
                Style="{StaticResource DarkToggleButtonStyle}"
                Content="{Binding IsListView, Converter={StaticResource BoolToString}, ConverterParameter='List View|Grid View'}"
                IsChecked="{Binding IsListView, Mode=TwoWay}"
                Margin="0,0,16,0"/>
            <ToggleButton
                Style="{StaticResource DarkToggleButtonStyle}"
                Content="Show Only Active"
                IsChecked="{Binding ShowOnlyActive, Mode=TwoWay}"/>
            <TextBlock Text="Session runtime:" 
                 Margin="24,0,4,0" 
                 VerticalAlignment="Center"
                 FontWeight="SemiBold" Foreground="White"
                       FontSize="15"/>
            <TextBlock Text="{Binding SessionRuntimeString}" 
                 VerticalAlignment="Center"
                 Margin="5,0,4,-5" 
                 FontFamily="Consolas"
                 Foreground="White" FontSize="15"/>
        </StackPanel>

        <!-- Scrollable grid of uniform cards -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SkillsView}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="225" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="ItemTemplate" Value="{StaticResource GridSkillTemplate}"/>
                        <Setter Property="ItemsPanel"   Value="{StaticResource GridItemsPanel}"/>

                        <Style.Triggers>
                            <!-- when IsListView is true, switch to list -->
                            <DataTrigger Binding="{Binding IsListView}" Value="True">
                                <Setter Property="ItemTemplate" Value="{StaticResource ListSkillTemplate}"/>
                                <Setter Property="ItemsPanel"   Value="{StaticResource ListItemsPanel}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- outer chrome -->
                        <Border Style="{StaticResource SkillChromeBorderStyle}">
                            <!-- inner gradient card -->
                            <Border Style="{StaticResource SkillCardStyle}">
                                <StackPanel Margin="6">
                                    <!-- Card Header: Level, Name, and Colored Bar -->
                                    <StackPanel Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width=".25*"/>
                                                <ColumnDefinition Width=".75*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Level badge: slightly rounded, lightly colored background -->
                                            <Border Grid.Column="0" 
                                                    Background="{Binding SecondaryBrush, Converter={StaticResource ToOpacityBrush}, ConverterParameter=0.40}"
                                                    CornerRadius="6"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    MinWidth="30"
                                                    Height="24"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Level}" 
                                                    VerticalAlignment="Center" 
                                                    HorizontalAlignment="Center" 
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    FontFamily="Consolas"
                                                    Padding="4,0,4,0"
                                                    FontSize="16"/>
                                            </Border>

                                            <!-- Skill name, slightly larger font, left-aligned -->
                                            <TextBlock Grid.Column="1" 
                                                Margin=" 7 0 0 0"
                                               Text="{Binding Name}"
                                               Style="{StaticResource SkillTitleTextStyle}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"/>
                                        </Grid>
                                        <!-- The colored bar sits directly under the name for emphasis -->
                                        <Rectangle Margin="0,5,0,0" Height="3" HorizontalAlignment="Stretch">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="{Binding SecondaryBrush.Color}" Offset="0"/>
                                                    <GradientStop Color="{Binding PrimaryBrush.Color}" Offset=".25"/>
                                                    <GradientStop Color="{Binding SecondaryBrush.Color}" Offset=".5"/>
                                                    <GradientStop Color="{Binding PrimaryBrush.Color}" Offset=".75"/>
                                                    <GradientStop Color="{Binding SecondaryBrush.Color}" Offset=".99"/>
                                                    
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </StackPanel>

                                    <Grid Margin="0,4,0,0">
                                    <!-- two equal-width columns -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- five rows, one per metric -->
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <!-- XP -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                         Text="Total XP:"
                                         Style="{StaticResource SkillTextBlockStyle}"
                                         HorizontalAlignment="Right" Margin=" 0 0 5 2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                         Text="{Binding Xp, StringFormat=N0}"
                                         Style="{StaticResource SkillTextBlockStyle}"
                                         HorizontalAlignment="Left" Margin="5 0 0 2 " />

                                    <!-- Gain -->
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                         Text="Gained XP:"
                                         Style="{StaticResource SkillTextBlockStyle}"
                                         HorizontalAlignment="Right" Margin=" 0 0 5 2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                         Text="{Binding XpGained, StringFormat=N0}"
                                         Style="{StaticResource SkillTextBlockStyle}"
                                         HorizontalAlignment="Left" Margin="5 0 0 2 " />

                                    <!-- XP/hr -->
                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                         Text="XP/hr:"
                                         Style="{StaticResource SkillTextBlockStyle}"
                                         HorizontalAlignment="Right" Margin=" 0 0 5 2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                         Text="{Binding XpPerHour, StringFormat=N0}"
                                         Style="{StaticResource SkillTextBlockStyle}"
                                         HorizontalAlignment="Left" Margin="5 0 0 2 " />

                                    <!-- To lvl -->
                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                         Text="XP to lvl:"
                                         Style="{StaticResource SkillTextBlockStyle}"
                                         HorizontalAlignment="Right" Margin=" 0 0 5 2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                         Text="{Binding XpToNext, StringFormat=N0}"
                                         Style="{StaticResource SkillTextBlockStyle}" 
                                         HorizontalAlignment="Left" Margin="5 0 0 2 " />

                                    <!-- ETA -->
                                    <TextBlock Grid.Row="4" Grid.Column="0"
                                         Text="ETA:"
                                         Style="{StaticResource SkillTextBlockStyle}"
                                         HorizontalAlignment="Right" Margin=" 0 0 5 2"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1"
                                         Text="{Binding EtaString}"
                                         Style="{StaticResource SkillTextBlockStyle}"
                                         HorizontalAlignment="Left" Margin="5 0 0 2 " />

                                </Grid>
                            </StackPanel>
                        </Border>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</Window>
