<Window
    x:Class="MESharp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:MESharp.Converters"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:views="clr-namespace:MESharp.Views"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    Title="MESharp Debug Util"
    Width="1200"
    Height="900"
    MinWidth="900"
    Background="Transparent"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <!--  Enable OS-level chrome for smoother dragging on the top caption area  -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="40"
            CornerRadius="10"
            GlassFrameThickness="0"
            ResizeBorderThickness="5"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <vm:MainWindowViewModel x:Key="MainWindowViewModel" />
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <!--  DataTemplates for Views  -->
            <DataTemplate DataType="{x:Type vm:GameViewModel}">
                <views:GameView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ChatViewModel}">
                <views:ChatView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SkillsViewModel}">
                <views:SkillsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlayersViewModel}">
                <views:PlayersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
                <views:InventoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NpcViewModel}">
                <views:NPCsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EquipmentViewModel}">
                <views:EquipmentView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ObjectsViewModel}">
                <views:ObjectsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BankViewModel}">
                <views:BankView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LootViewModel}">
                <views:LootView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MaterialCacheViewModel}">
                <views:MaterialCacheView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TradeWindowViewModel}">
                <views:TradeWindowView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ItemContainersViewModel}">
                <views:ItemContainersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ItemsUnifiedViewModel}">
                <views:ItemsUnifiedView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ObjectsUnifiedViewModel}">
                <views:ObjectsUnifiedView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InterfacesViewModel}">
                <views:InterfacesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VarbitViewModel}">
                <views:VarbitView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ApiDocsViewModel}">
                <views:ApiDocsView />
            </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <Border
        Background="{DynamicResource App.BackgroundBrush}"
        BorderThickness="2"
        CornerRadius="0 0 0 0">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource PrimaryColor}" />
        </Border.Effect>

        <DockPanel>
            <!--  Custom Title Bar  -->
            <Border
                Height="40"
                Background="{DynamicResource App.CardBrush}"
                DockPanel.Dock="Top">
                <Grid x:Name="TitleBarGrid" MouseLeftButtonDown="OnTitleBarMouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Width="18"
                            Height="18"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Kind="Bug" />
                        <TextBlock
                            Margin="5,-2,0,0"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource App.ForegroundBrush}"
                            Text="MESharp Debug Util" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Width="18"
                            Height="18"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Kind="TimerOutline" />
                        <TextBlock
                            Margin="5,0,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource App.ForegroundBrush}"
                            Text="Session:" />
                        <TextBlock
                            Margin="5,2.5,5,0"
                            FontFamily="Consolas"
                            FontSize="14"
                            Foreground="{DynamicResource App.ForegroundBrush}"
                            Text="{Binding SessionRuntimeString}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Width="40"
                            Height="28"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnMinimizeClick"
                            Style="{StaticResource WindowControlButton}"
                            ToolTip="Minimize">
                            <iconPacks:PackIconMaterial Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Kind="WindowMinimize" />
                        </Button>
                        <Button
                            Width="40"
                            Height="28"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnMaximizeClick"
                            Style="{StaticResource WindowControlButton}"
                            ToolTip="Maximize/Restore">
                            <iconPacks:PackIconMaterial Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Kind="WindowMaximize" />
                        </Button>
                        <Button
                            Width="40"
                            Height="28"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnCloseClick"
                            Style="{StaticResource CloseWindowButton}"
                            ToolTip="Close">
                            <iconPacks:PackIconMaterial Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Kind="Close" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Divider under title bar  -->
            <Border
                Height="1"
                Background="{DynamicResource PrimaryBrush}"
                DockPanel.Dock="Top" />
            <!--  Top Tab Bar with Horizontal Scrolling  -->
            <Border
                Height="56"
                Margin="4,5,4,0"
                Background="{DynamicResource App.CardBrush}"
                DockPanel.Dock="Top">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    PanningMode="HorizontalOnly"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowGameCommand}"
                            IsChecked="{Binding IsGameSelected, Mode=OneWay}"
                            ToolTip="Game">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="ApplicationCog" />
                                <TextBlock Text="Game" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowChatCommand}"
                            IsChecked="{Binding IsChatSelected, Mode=OneWay}"
                            ToolTip="Chat">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="Message" />
                                <TextBlock Text="Chat" />
                            </StackPanel>
                        </ToggleButton>
                        <!--  Apply the new style to the navigation buttons  -->
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowSkillsCommand}"
                            IsChecked="{Binding IsSkillsSelected, Mode=OneWay}"
                            ToolTip="Skills">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="Trophy" />
                                <TextBlock Text="Skills" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowPlayersCommand}"
                            IsChecked="{Binding IsPlayersSelected, Mode=OneWay}"
                            ToolTip="Players - LocalPlayer and Nearby Players">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="AccountMultiple" />
                                <TextBlock Text="Players" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowItemsUnifiedCommand}"
                            IsChecked="{Binding IsItemsUnifiedSelected, Mode=OneWay}"
                            ToolTip="Items - All Containers">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="PackageVariantClosed" />
                                <TextBlock Text="Items" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowObjectsUnifiedCommand}"
                            IsChecked="{Binding IsObjectsUnifiedSelected, Mode=OneWay}"
                            ToolTip="Objects - NPCs and Game Objects">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="CubeOutline" />
                                <TextBlock Text="Objects" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowVarbitCommand}"
                            IsChecked="{Binding IsVarbitSelected, Mode=OneWay}"
                            ToolTip="Varbits">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="Memory" />
                                <TextBlock Text="Varbits" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowApiDocsCommand}"
                            IsChecked="{Binding IsApiDocsSelected, Mode=OneWay}"
                            ToolTip="API Docs">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="BookOutline" />
                                <TextBlock Text="API Docs" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowInterfacesCommand}"
                            IsChecked="{Binding IsInterfacesSelected, Mode=OneWay}"
                            ToolTip="Interfaces Debug">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="MonitorDashboard" />
                                <TextBlock Text="Interfaces" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton
                            Margin="5,0,5,0"
                            Command="{Binding ShowSettingsCommand}"
                            IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"
                            ToolTip="Settings">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                    Kind="Cog" />
                                <TextBlock Text="Settings" />
                            </StackPanel>
                        </ToggleButton>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  Content Area  -->
            <ContentControl Margin="4" Content="{Binding CurrentViewModel}" />
        </DockPanel>
    </Border>
</Window>
