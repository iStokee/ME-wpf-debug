<Window
    x:Class="MESharp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:MESharp.Converters"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:views="clr-namespace:MESharp.Views"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    Title="MESharp Debug Util"
    Width="1000"
    Height="900"
    MinWidth="650"
    Background="{DynamicResource App.BackgroundBrush}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <!--  Enable OS-level chrome for smoother dragging on the top caption area  -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="40"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="5"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <vm:MainWindowViewModel x:Key="MainWindowViewModel" />
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />

            <!--  DataTemplates for Views  -->
            <DataTemplate DataType="{x:Type vm:SkillsViewModel}">
                <views:SkillsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
                <views:InventoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NpcViewModel}">
                <views:NPCsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EquipmentViewModel}">
                <views:EquipmentView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ObjectsViewModel}">
                <views:ObjectsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BankViewModel}">
                <views:BankView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>

            <!--  Stylized ToggleButton, theme-aware (no hard-coded hover bg)  -->
            <Style x:Key="DarkToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource App.CardBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                x:Name="border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#666" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>



    <DockPanel>
        <!--  Custom Title Bar  -->
        <Border
            Height="40"
            Background="{DynamicResource App.CardBrush}"
            DockPanel.Dock="Top">
            <Grid x:Name="TitleBarGrid" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <iconPacks:PackIconMaterial
                        Width="18"
                        Height="18"
                        Margin="0,0,8,0"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Kind="Bug" />
                    <TextBlock FontWeight="SemiBold" Text="MESharp Debug Util" />
                </StackPanel>
                <Border
                    Grid.Column="1"
                    Margin="0,0,25,0"
                    Padding="8,5,8,5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{DynamicResource App.CardBrush}"
                    BorderBrush="{DynamicResource PrimaryBrush}"
                    BorderThickness="0,0,0,0"
                    CornerRadius="12">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Width="18"
                            Height="18"
                            Margin="6,0,6,0"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Kind="TimerOutline" />
                        <TextBlock
                            Margin="0,0,6,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource App.SubtleForegroundBrush}"
                            Text="Session:" />
                        <TextBlock
                            Margin="0,2,6,0"
                            FontFamily="Consolas"
                            FontSize="14"
                            Foreground="{DynamicResource App.ForegroundBrush}"
                            Text="{Binding SessionRuntimeString}" />
                    </StackPanel>
                </Border>
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="40"
                        Height="28"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnMinimizeClick"
                        Style="{StaticResource IconButton}"
                        ToolTip="Minimize">
                        <iconPacks:PackIconMaterial Kind="WindowMinimize" />
                    </Button>
                    <Button
                        Width="40"
                        Height="28"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnMaximizeClick"
                        Style="{StaticResource IconButton}"
                        ToolTip="Maximize/Restore">
                        <iconPacks:PackIconMaterial Kind="WindowMaximize" />
                    </Button>
                    <Button
                        Width="40"
                        Height="28"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnCloseClick"
                        Style="{StaticResource IconButton}"
                        ToolTip="Close">
                        <iconPacks:PackIconMaterial Kind="Close" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Divider under title bar  -->
        <Border
            Height="1"
            Background="{DynamicResource PrimaryBrush}"
            DockPanel.Dock="Top" />
        <!--  Top Tab Bar  -->
        <Border
            Height="48"
            Margin="4,5,4,0"
            Background="{DynamicResource App.CardBrush}"
            DockPanel.Dock="Top">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <!--  Apply the new style to the navigation buttons  -->
                <ToggleButton
                    Margin="5,0,5,0"
                    Command="{Binding ShowSkillsCommand}"
                    IsChecked="{Binding IsSkillsSelected, Mode=OneWay}"
                    Style="{StaticResource DarkToggleButtonStyle}"
                    ToolTip="Skills">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Kind="Trophy" />
                        <TextBlock Text="Skills" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton
                    Margin="5,0,5,0"
                    Command="{Binding ShowInventoryCommand}"
                    IsChecked="{Binding IsInventorySelected, Mode=OneWay}"
                    Style="{StaticResource DarkToggleButtonStyle}"
                    ToolTip="Inventory">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Kind="ViewList" />
                        <TextBlock Text="Inventory" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton
                    Margin="5,0,5,0"
                    Command="{Binding ShowNpcsCommand}"
                    IsChecked="{Binding IsNpcsSelected, Mode=OneWay}"
                    Style="{StaticResource DarkToggleButtonStyle}"
                    ToolTip="NPCs">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Kind="Robot" />
                        <TextBlock Text="NPCs" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton
                    Margin="5,0,5,0"
                    Command="{Binding ShowEquipmentCommand}"
                    IsChecked="{Binding IsEquipmentSelected, Mode=OneWay}"
                    Style="{StaticResource DarkToggleButtonStyle}"
                    ToolTip="Equipment">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Kind="Shield" />
                        <TextBlock Text="Equipment" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton
                    Margin="5,0,5,0"
                    Command="{Binding ShowObjectsCommand}"
                    IsChecked="{Binding IsObjectsSelected, Mode=OneWay}"
                    Style="{StaticResource DarkToggleButtonStyle}"
                    ToolTip="Objects">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Kind="Cube" />
                        <TextBlock Text="Objects" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton
                    Margin="5,0,5,0"
                    Command="{Binding ShowBankCommand}"
                    IsChecked="{Binding IsBankSelected, Mode=OneWay}"
                    Style="{StaticResource DarkToggleButtonStyle}"
                    ToolTip="Bank">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Kind="Bank" />
                        <TextBlock Text="Bank" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton
                    Margin="5,0,5,0"
                    Command="{Binding ShowSettingsCommand}"
                    IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"
                    Style="{StaticResource DarkToggleButtonStyle}"
                    ToolTip="Settings">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Kind="Cog" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Border>

        <!--  Content Area  -->
        <ContentControl Margin="4" Content="{Binding CurrentViewModel}" />
    </DockPanel>
</Window>
