<Controls:MetroWindow
    x:Class="MESharp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:conv="clr-namespace:MESharp.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mdControls="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
    xmlns:views="clr-namespace:MESharp.Views"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    Title="Debug Utility"
    Width="1000"
    Height="900"
    MinWidth="650"
    BorderThickness="0"
    WindowTransitionsEnabled="True">

    <Controls:MetroWindow.Resources>
        <ResourceDictionary>
            <vm:MainWindowViewModel x:Key="MainWindowViewModel" />
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />

            <!--  DataTemplates for Views  -->
            <DataTemplate DataType="{x:Type vm:SkillsViewModel}">
                <views:SkillsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
                <views:InventoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NpcViewModel}">
                <views:NPCsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>

            <!--  NEW: Theme-Aware Toggle Button Style for Top Navigation  -->
            <Style
                x:Key="NavToggleButtonStyle"
                BasedOn="{StaticResource MaterialDesignFlatToggleButton}"
                TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  Stylized Dark ToggleButton  -->
            <Style x:Key="DarkToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                x:Name="border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <!--  MouseOver/Focus  -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#51515f" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#8888a3" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#99ccff" />
                                </Trigger>
                                <!--  Pressed  -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#22222b" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#bbf" />
                                </Trigger>
                                <!--  Checked (Toggled)  -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF232323" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </Trigger>
                                <!--  Disabled  -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#333337" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#26262a" />
                                    <Setter Property="Foreground" Value="#666" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Controls:MetroWindow.Resources>



    <DockPanel>
        <!--  Top Tab Bar  -->
        <Border
            Height="48"
            Margin="4,5,4,0"
            Background="#FF232323"
            DockPanel.Dock="Top">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <!--  Apply the new style to the navigation buttons  -->
                <ToggleButton
                    Margin="5,0,5,0"
                    Command="{Binding ShowSkillsCommand}"
                    IsChecked="{Binding IsSkillsSelected, Mode=OneWay}"
                    Style="{StaticResource DarkToggleButtonStyle}"
                    ToolTip="Skills">
                    <StackPanel Orientation="Horizontal">
                        <mdControls:PackIcon
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Kind="Trophy" />
                        <TextBlock Text="Skills" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton
                    Margin="5,0,5,0"
                    Command="{Binding ShowInventoryCommand}"
                    IsChecked="{Binding IsInventorySelected, Mode=OneWay}"
                    Style="{StaticResource DarkToggleButtonStyle}"
                    ToolTip="Inventory">
                    <StackPanel Orientation="Horizontal">
                        <mdControls:PackIcon
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Kind="ViewList" />
                        <TextBlock Text="Inventory" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton
                    Margin="5,0,5,0"
                    Command="{Binding ShowNpcsCommand}"
                    IsChecked="{Binding IsNpcsSelected, Mode=OneWay}"
                    Style="{StaticResource DarkToggleButtonStyle}"
                    ToolTip="NPCs">
                    <StackPanel Orientation="Horizontal">
                        <mdControls:PackIcon
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Kind="Robot" />
                        <TextBlock Text="NPCs" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Border>



        <!--  Status Bar at the Bottom  -->
        <Border
            Height="30"
            Background="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
            DockPanel.Dock="Bottom">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  FIX: Explicitly set the Foreground for all TextBlocks in the StatusBar  -->
                <!--  Accent header  -->
                <materialDesign:ColorZone CornerRadius="0" Mode="PrimaryMid">
                    <TextBlock
                        Margin="16,0"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Style="{StaticResource MaterialDesignBody1TextBlock}"
                        Text="{Binding CurrentPageName}" />
                </materialDesign:ColorZone>
                <materialDesign:ColorZone
                    Grid.Column="1"
                    CornerRadius="0"
                    Mode="PrimaryMid">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                        <TextBlock
                            Margin="0,0,5,0"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary.Dark.Foreground}"
                            Text="Session:" />

                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary.Dark.Foreground}"
                            Text="{Binding SessionRuntimeString}" />

                        <Button
                            Grid.Column="2"
                            Margin="12,0,5,0"
                            Command="{Binding ShowSettingsCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            ToolTip="Settings">
                            <!--  FIX: Set the icon's foreground color  -->
                            <mdControls:PackIcon Foreground="{DynamicResource MaterialDesign.Brush.Primary.Dark.Foreground}" Kind="Cog" />
                        </Button>

                    </StackPanel>
                </materialDesign:ColorZone>
            </Grid>
        </Border>

        <!--  Content Area  -->
        <ContentControl Margin="4" Content="{Binding CurrentViewModel}" />
    </DockPanel>
</Controls:MetroWindow>