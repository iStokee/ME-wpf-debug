<UserControl
    x:Class="MESharp.Views.ObjectsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource App.BackgroundBrush}"
    Foreground="{DynamicResource App.ForegroundBrush}">

    <ScrollViewer>
        <StackPanel Margin="12">
            <GroupBox Header="Objects">
                <StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="12"
                            Text="Select object types to load:" />
                        <WrapPanel>
                            <CheckBox
                                Margin="0,0,12,8"
                                Content="Object [0]"
                                IsChecked="{Binding IncludeObject}" />
                            <CheckBox
                                Margin="0,0,12,8"
                                Content="NPC [1]"
                                IsChecked="{Binding IncludeNpc}" />
                            <CheckBox
                                Margin="0,0,12,8"
                                Content="Player [2]"
                                IsChecked="{Binding IncludePlayer}" />
                            <CheckBox
                                Margin="0,0,12,8"
                                Content="Ground [3]"
                                IsChecked="{Binding IncludeGroundItem}" />
                            <CheckBox
                                Margin="0,0,12,8"
                                Content="Highlight [4]"
                                IsChecked="{Binding IncludeHighlight}" />
                            <CheckBox
                                Margin="0,0,12,8"
                                Content="Projectile [5]"
                                IsChecked="{Binding IncludeProjectile}" />
                            <CheckBox
                                Margin="0,0,12,8"
                                Content="Tile [8]"
                                IsChecked="{Binding IncludeTile}" />
                            <CheckBox
                                Margin="0,0,12,8"
                                Content="Object [12]"
                                IsChecked="{Binding IncludeObject12}" />
                        </WrapPanel>
                    </StackPanel>

                    <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
                        <CheckBox
                            Margin="0,0,12,0"
                            Content="Interactable only"
                            IsChecked="{Binding OnlyInteractable}" />
                        <CheckBox
                            Margin="0,0,12,0"
                            Content="Live refresh"
                            IsChecked="{Binding LiveRefresh}" />
                        <Button
                            Width="100"
                            Height="30"
                            Margin="0,0,12,0"
                            Command="{Binding RefreshCommand}"
                            Content="Refresh"
                            Style="{StaticResource AccentButton}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource App.MutedBrush}"
                            Text="Refresh runs automatically when types change." />
                    </WrapPanel>

                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Filter (name or ID):" />
                        <TextBox
                            Width="220"
                            Margin="8,0,0,0"
                            Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource App.MutedBrush}"
                            Text="Use * for wildcard." />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Action index:" />
                        <ComboBox
                            Width="100"
                            Margin="8,0,0,0"
                            ItemContainerStyle="{StaticResource AppComboBoxItem}"
                            ItemsSource="{Binding ActionIndices}"
                            SelectedItem="{Binding ActionIndex}"
                            Style="{StaticResource AppComboBox}" />
                        <Button
                            Width="100"
                            Height="30"
                            Margin="12,0,0,0"
                            Command="{Binding DoActionCommand}"
                            Content="DoAction"
                            Style="{StaticResource AccentButton}" />
                    </StackPanel>

                    <DataGrid
                        Margin="0"
                        AutoGenerateColumns="False"
                        Background="{DynamicResource App.CardBrush}"
                        CanUserResizeColumns="False"
                        CanUserResizeRows="False"
                        CanUserSortColumns="True"
                        Foreground="{DynamicResource App.ForegroundBrush}"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding ObjectsView}"
                        RowHeaderWidth="0"
                        RowHeight="28"
                        SelectedItem="{Binding SelectedObject, Mode=TwoWay}"
                        SelectionMode="Single"
                        SelectionUnit="FullRow">
                        <DataGrid.ColumnHeaderStyle>
                            <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource App.CardBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="Padding" Value="6,4" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                                    </Trigger>
                                    <Trigger Property="SortDirection" Value="Ascending">
                                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                                    </Trigger>
                                    <Trigger Property="SortDirection" Value="Descending">
                                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Id}"
                                Header="ID"
                                SortMemberPath="Id" />
                            <DataGridTextColumn
                                Width="200"
                                Binding="{Binding Name}"
                                Header="Name"
                                SortMemberPath="Name" />
                            <DataGridTextColumn
                                Width="160"
                                Binding="{Binding Action}"
                                Header="Action"
                                SortMemberPath="Action" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding TypeLabel}"
                                Header="Type"
                                SortMemberPath="Type" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Distance, StringFormat={}{0:F1}}"
                                Header="Dist"
                                SortMemberPath="Distance" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Floor}"
                                Header="Floor"
                                SortMemberPath="Floor" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Life}"
                                Header="Life"
                                SortMemberPath="Life" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Animation}"
                                Header="Anim"
                                SortMemberPath="Animation" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding CombatLevel}"
                                Header="Cmb"
                                SortMemberPath="CombatLevel" />
                            <DataGridTemplateColumn Width="180" Header="Tile">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Tile.x}" />
                                            <Run Text="," />
                                            <Run Text="{Binding Tile.y}" />
                                            <Run Text="," />
                                            <Run Text="{Binding Tile.z}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
