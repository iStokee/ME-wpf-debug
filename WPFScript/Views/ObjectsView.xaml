<UserControl
    x:Class="MESharp.Views.ObjectsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Background="{DynamicResource App.BackgroundBrush}"
    Foreground="{DynamicResource App.ForegroundBrush}">

    <ScrollViewer>
        <StackPanel Margin="24">

            <!--  Header  -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial
                        Width="24"
                        Height="24"
                        Margin="0,0,8,0"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Kind="Cube" />
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Objects" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Style="{StaticResource HeaderHelpButton}"
                    ToolTip="Open API docs"
                    Command="{Binding DataContext.ShowApiDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <iconPacks:PackIconMaterial
                        Width="18"
                        Height="18"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Kind="HelpCircleOutline" />
                </Button>
            </Grid>

            <!--  Object Type Selection Card  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Object Types" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Select which object types to load. Refresh runs automatically when types change." />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <CheckBox
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,16,8"
                            Content="Object [0]"
                            IsChecked="{Binding IncludeObject}" />
                        <CheckBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,16,8"
                            Content="NPC [1]"
                            IsChecked="{Binding IncludeNpc}" />
                        <CheckBox
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="0,0,16,8"
                            Content="Player [2]"
                            IsChecked="{Binding IncludePlayer}" />
                        <CheckBox
                            Grid.Row="0"
                            Grid.Column="3"
                            Margin="0,0,16,8"
                            Content="Ground [3]"
                            IsChecked="{Binding IncludeGroundItem}" />

                        <CheckBox
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,16,8"
                            Content="Highlight [4]"
                            IsChecked="{Binding IncludeHighlight}" />
                        <CheckBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,16,8"
                            Content="Projectile [5]"
                            IsChecked="{Binding IncludeProjectile}" />
                        <CheckBox
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,0,16,8"
                            Content="Tile [8]"
                            IsChecked="{Binding IncludeTile}" />
                        <CheckBox
                            Grid.Row="1"
                            Grid.Column="3"
                            Margin="0,0,16,8"
                            Content="Object [12]"
                            IsChecked="{Binding IncludeObject12}" />

                        <CheckBox
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,0,16,0"
                            Content="Interactable only"
                            IsChecked="{Binding OnlyInteractable}" />
                        <CheckBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,16,0"
                            Content="Live refresh"
                            IsChecked="{Binding LiveRefresh}" />
                    </Grid>
                    <Button
                        Width="100"
                        Height="30"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh"
                        Style="{StaticResource AccentButton}" />
                </StackPanel>
            </Border>

            <!--  Filter Card  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Filter" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Filter by name or ID (use * for wildcard)." />

                    <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Filter:" />
                        <TextBox
                            Width="240"
                            Margin="0,0,12,0"
                            Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!--  Objects List Card  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Nearby Objects" />

                    <Grid>
                        <DataGrid
                            Height="460"
                            AutoGenerateColumns="False"
                        Background="{DynamicResource App.BackgroundBrush}"
                        CanUserResizeColumns="False"
                        CanUserResizeRows="False"
                        CanUserSortColumns="True"
                        Foreground="{DynamicResource App.ForegroundBrush}"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding ObjectsView}"
                        RowHeaderWidth="0"
                        RowHeight="28"
                        SelectedItem="{Binding SelectedObject, Mode=TwoWay}"
                        SelectionMode="Single"
                        SelectionUnit="FullRow">
                        <DataGrid.ColumnHeaderStyle>
                            <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource App.CardBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="Padding" Value="6,4" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                                    </Trigger>
                                    <Trigger Property="SortDirection" Value="Ascending">
                                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                                    </Trigger>
                                    <Trigger Property="SortDirection" Value="Descending">
                                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Id}"
                                Header="ID"
                                SortMemberPath="Id" />
                            <DataGridTextColumn
                                Width="200"
                                Binding="{Binding Name}"
                                Header="Name"
                                SortMemberPath="Name" />
                            <DataGridTextColumn
                                Width="160"
                                Binding="{Binding Action}"
                                Header="Action"
                                SortMemberPath="Action" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding TypeLabel}"
                                Header="Type"
                                SortMemberPath="Type" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Distance, StringFormat={}{0:F1}}"
                                Header="Dist"
                                SortMemberPath="Distance" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Floor}"
                                Header="Floor"
                                SortMemberPath="Floor" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Life}"
                                Header="Life"
                                SortMemberPath="Life" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Animation}"
                                Header="Anim"
                                SortMemberPath="Animation" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding CombatLevel}"
                                Header="Cmb"
                                SortMemberPath="CombatLevel" />
                            <DataGridTemplateColumn Width="180" Header="Tile">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Tile.x}" />
                                            <Run Text="," />
                                            <Run Text="{Binding Tile.y}" />
                                            <Run Text="," />
                                            <Run Text="{Binding Tile.z}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!--  Empty State Message  -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="No objects loaded. Select object types and click 'Refresh'.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasObjects}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                </StackPanel>
            </Border>

            <!--  Actions Card  -->
            <Border
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Actions" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Perform actions on objects by filter or selected item." />

                    <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Action index:" />
                        <ComboBox
                            Width="100"
                            Margin="0,0,12,0"
                            ItemContainerStyle="{StaticResource AppComboBoxItem}"
                            ItemsSource="{Binding ActionIndices}"
                            SelectedItem="{Binding ActionIndex}"
                            Style="{StaticResource AppComboBox}" />
                        <Button
                            Width="100"
                            Height="30"
                            Command="{Binding DoActionCommand}"
                            Content="DoAction"
                            Style="{StaticResource AccentButton}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
