<UserControl
    x:Class="MESharp.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:controls="clr-namespace:MESharp.Views.Controls"
    Background="{DynamicResource App.BackgroundBrush}"
    Foreground="{DynamicResource App.ForegroundBrush}">

    <ScrollViewer>
        <StackPanel Margin="5">

            <!--  Header  -->
            <controls:SectionHeader
                Margin="0,0,0,16"
                Title="Chat"
                Description="Monitor live chat events and capture message streams."
                IconKind="Message"
                HelpCommand="{Binding DataContext.ShowApiDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

            <!--  Controls Card  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Event Capture" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Monitor and capture chat events in real-time." />

                    <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
                        <CheckBox
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Content="Capture live events"
                            IsChecked="{Binding CaptureEvents, Mode=TwoWay}"
                            IsEnabled="{Binding EventsSupported}" />
                        <Button
                            Width="120"
                            Command="{Binding ClearEventsCommand}"
                            Content="Clear Events"
                            Style="{StaticResource AccentButton}" />
                    </WrapPanel>

                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Text="{Binding EventsStatusMessage}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EventsSupported}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!--  Chat Events Card  -->
            <Border
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Live Events" />

                    <Grid>
                        <DataGrid
                            Height="460"
                            Margin="5"
                            AutoGenerateColumns="False"
                            Background="{DynamicResource App.BackgroundBrush}"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserSortColumns="True"
                            Foreground="{DynamicResource App.ForegroundBrush}"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding LiveEvents}"
                            RowBackground="{DynamicResource App.CardBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="50"
                                    Binding="{Binding Sequence}"
                                    Header="#" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding Time}"
                                    Header="Time" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding Channel}"
                                    Header="Channel" />
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding Names}"
                                    Header="Names" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="200"
                                    Binding="{Binding Text}"
                                    Header="Text" />
                                <DataGridTextColumn
                                    Width="150"
                                    Binding="{Binding Details}"
                                    Header="Details" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding Tick}"
                                    Header="Tick" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource App.MutedBrush}"
                            Text="No live events captured yet. Enable 'Capture live events' above or trigger chat activity.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEvents}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EventsSupported}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Chat Messages Card  -->
            <Border
                Margin="0,16,0,0"
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Chat Message History" />
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Load recent chat messages from memory."
                        TextWrapping="Wrap" />

                    <Button
                        Width="150"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"
                        Command="{Binding GetMessagesCommand}"
                        Content="Load Messages"
                        Style="{StaticResource AccentButton}" />

                    <DataGrid
                        Height="200"
                        Margin="5"
                        AutoGenerateColumns="False"
                        Background="{DynamicResource App.BackgroundBrush}"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserSortColumns="True"
                        Foreground="{DynamicResource App.ForegroundBrush}"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Messages}"
                        RowBackground="{DynamicResource App.CardBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding Name}"
                                Header="Name" />
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="200"
                                Binding="{Binding Text}"
                                Header="Text" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding Timestamp}"
                                Header="Timestamp" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!--  Find Message Card  -->
            <Border
                Margin="0,16,0,0"
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Find Message" />
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Search for a specific message in chat history."
                        TextWrapping="Wrap" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Text="{Binding FindMessageText, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Text="Limit:" />

                        <TextBox
                            Grid.Column="2"
                            Width="60"
                            VerticalAlignment="Center"
                            Text="{Binding FindMessageLimit}" />
                    </Grid>

                    <Button
                        Width="120"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"
                        Command="{Binding TryFindMessageCommand}"
                        Content="Search"
                        Style="{StaticResource AccentButton}" />

                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource App.ForegroundBrush}"
                        Text="{Binding FoundMessageResult}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  Friend Chat Card  -->
            <Border
                Margin="0,16,0,0"
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Friend Chat Members" />
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Load list of friend chat members."
                        TextWrapping="Wrap" />

                    <Button
                        Width="180"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"
                        Command="{Binding GetFriendChatCommand}"
                        Content="Load Friend Chat"
                        Style="{StaticResource AccentButton}" />

                    <ListBox
                        Height="120"
                        Background="{DynamicResource App.BackgroundBrush}"
                        ItemsSource="{Binding FriendChatMembers}" />
                </StackPanel>
            </Border>

            <!--  Portable Time Card  -->
            <Border
                Margin="0,16,0,0"
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Portable Timer" />
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Check portable skilling station time remaining."
                        TextWrapping="Wrap" />

                    <Button
                        Width="150"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"
                        Command="{Binding GetPortableTimeCommand}"
                        Content="Check Time"
                        Style="{StaticResource AccentButton}" />

                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Text="{Binding PortableTimeRemaining}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
