<UserControl
    x:Class="MESharp.Views.InventoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    Background="#FF232323"
    Foreground="White">

    <ScrollViewer>
        <StackPanel Margin="12">

            <!--  Inventory State  -->
            <GroupBox Header="Inventory State">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Button
                        Width="80"
                        Command="{Binding RefreshStateCommand}"
                        Content="Refresh" />
                    <TextBlock
                        Margin="5,0,5,0"
                        FontWeight="SemiBold"
                        Text="Open:" />
                    <TextBlock Margin="5,0,5,0" Text="{Binding IsOpen}" />
                    <TextBlock
                        Margin="5,0,5,0"
                        FontWeight="SemiBold"
                        Text="Full:" />
                    <TextBlock Margin="5,0,5,0" Text="{Binding IsFull}" />
                    <TextBlock
                        Margin="5,0,5,0"
                        FontWeight="SemiBold"
                        Text="Empty:" />
                    <TextBlock Margin="5,0,5,0" Text="{Binding IsEmpty}" />
                    <TextBlock
                        Margin="5,0,5,0"
                        FontWeight="SemiBold"
                        Text="Free Slots:" />
                    <TextBlock Margin="5,0,5,0" Text="{Binding FreeSlots}" />
                </StackPanel>
            </GroupBox>

            <!--  All Items  -->
            <GroupBox Header="All Items">
                <StackPanel>
                    <Button
                        Width="80"
                        Margin="0,0,0,8"
                        Command="{Binding LoadAllCommand}"
                        Content="Load All" />
                    <ListView
                        Height="200"
                        Background="#FF232323"
                        ItemsSource="{Binding AllItems}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn
                                    Width="50"
                                    DisplayMemberBinding="{Binding Slot}"
                                    Header="Slot" />
                                <GridViewColumn
                                    Width="50"
                                    DisplayMemberBinding="{Binding Id}"
                                    Header="ID" />
                                <GridViewColumn
                                    Width="150"
                                    DisplayMemberBinding="{Binding Name}"
                                    Header="Name" />
                                <GridViewColumn
                                    Width="70"
                                    DisplayMemberBinding="{Binding Amount}"
                                    Header="Amount" />
                                <GridViewColumn
                                    Width="70"
                                    DisplayMemberBinding="{Binding Exp}"
                                    Header="XP" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </GroupBox>

            <!--  Find  -->
            <GroupBox Header="Find by ID">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox
                            Width="80"
                            md:HintAssist.Hint="Item ID"
                            Text="{Binding IdInput, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Width="60"
                            Command="{Binding FindByIdCommand}"
                            Content="Find" />
                    </StackPanel>
                    <ListView
                        Height="100"
                        Margin="0,8,0,0"
                        Background="#FF232323"
                        ItemsSource="{Binding FindByIdResults}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn
                                    Width="50"
                                    DisplayMemberBinding="{Binding Id}"
                                    Header="ID" />
                                <GridViewColumn
                                    Width="150"
                                    DisplayMemberBinding="{Binding Name}"
                                    Header="Name" />
                                <GridViewColumn
                                    Width="50"
                                    DisplayMemberBinding="{Binding Slot}"
                                    Header="Slot" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Find by Name">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox
                            Width="150"
                            md:HintAssist.Hint="substring…"
                            Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Width="60"
                            Command="{Binding FindByNameCommand}"
                            Content="Find" />
                    </StackPanel>
                    <ListView
                        Height="100"
                        Margin="0,8,0,0"
                        Background="#FF232323"
                        ItemsSource="{Binding FindByNameResults}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn
                                    Width="50"
                                    DisplayMemberBinding="{Binding Id}"
                                    Header="ID" />
                                <GridViewColumn
                                    Width="150"
                                    DisplayMemberBinding="{Binding Name}"
                                    Header="Name" />
                                <GridViewColumn
                                    Width="50"
                                    DisplayMemberBinding="{Binding Slot}"
                                    Header="Slot" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </GroupBox>

            <!--  Contains  -->
            <GroupBox Header="Contains">
                <StackPanel>
                    <!--  single ID  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBox
                            Width="80"
                            md:HintAssist.Hint="ID…"
                            Text="{Binding IdInput}" />
                        <Button
                            Width="100"
                            Command="{Binding ContainsIdCommand}"
                            Content="Contains ID" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding ContainsIdResult}" />
                    </StackPanel>
                    <!--  comma-separated  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBox
                            Width="150"
                            md:HintAssist.Hint="e.g. 1001,1002"
                            Text="{Binding ContainsIdsInput}" />
                        <Button
                            Width="100"
                            Command="{Binding ContainsAnyCommand}"
                            Content="Contains Any" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding ContainsAnyResult}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox
                            Width="150"
                            md:HintAssist.Hint="…"
                            Text="{Binding ContainsIdsInput}" />
                        <Button
                            Width="100"
                            Command="{Binding ContainsAllCommand}"
                            Content="Contains All" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding ContainsAllResult}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!--  Count Of  -->
            <GroupBox Header="Count Of">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox
                            Width="80"
                            md:HintAssist.Hint="ID…"
                            Text="{Binding IdInput}" />
                        <Button
                            Width="80"
                            Command="{Binding CountOfIdCommand}"
                            Content="Count ID" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding CountOfIdResult}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox
                            Width="150"
                            md:HintAssist.Hint="name…"
                            Text="{Binding NameInput}" />
                        <Button
                            Width="80"
                            Command="{Binding CountOfNameCommand}"
                            Content="Count Name" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding CountOfNameResult}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!--  Actions  -->
            <GroupBox Header="Actions">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <ComboBox
                        Width="100"
                        ItemsSource="{Binding ActionTypes}"
                        SelectedItem="{Binding SelectedAction}" />
                    <CheckBox
                        VerticalAlignment="Center"
                        Content="By ID"
                        IsChecked="{Binding UseIdForAction}" />
                    <TextBox
                        Width="150"
                        md:HintAssist.Hint="ID or name…"
                        Text="{Binding ActionInput}" />
                    <Button
                        Width="80"
                        Command="{Binding ExecuteActionCommand}"
                        Content="Execute" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding ActionResult}" />
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
