<UserControl
    x:Class="MESharp.Views.InventoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Background="{DynamicResource App.BackgroundBrush}"
    Foreground="{DynamicResource App.ForegroundBrush}">

    <ScrollViewer>
        <StackPanel Margin="24">

            <!--  Header  -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial
                        Width="24"
                        Height="24"
                        Margin="0,0,8,0"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Kind="ViewList" />
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Inventory" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Style="{StaticResource HeaderHelpButton}"
                    ToolTip="Open API docs"
                    Command="{Binding DataContext.ShowApiDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <iconPacks:PackIconMaterial
                        Width="18"
                        Height="18"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Kind="HelpCircleOutline" />
                </Button>
            </Grid>

            <!--  Status Card  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Status" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Current inventory state and quick loading." />

                    <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
                        <Button
                            Width="130"
                            Height="30"
                            Margin="0,0,12,8"
                            Command="{Binding RefreshStateCommand}"
                            Content="Refresh State"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="110"
                            Height="30"
                            Margin="0,0,12,8"
                            Command="{Binding LoadAllCommand}"
                            Content="Load Items"
                            Style="{StaticResource AccentButton}" />
                        <StackPanel Margin="0,0,12,8" Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource App.BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Open:" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontSize="12"
                                Text="{Binding IsOpen}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8" Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource App.BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Full:" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontSize="12"
                                Text="{Binding IsFull}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8" Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource App.BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Empty:" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontSize="12"
                                Text="{Binding IsEmpty}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8" Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource App.BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsItemSelected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Selected:" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontSize="12"
                                Text="{Binding IsItemSelected}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8" Orientation="Horizontal">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Free Slots:" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontSize="12"
                                Text="{Binding FreeSlots}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!--  Filter and Actions Card (Combined)  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Filter and Actions" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Filter items and perform actions by name or ID." />

                    <!--  Filter Section  -->
                    <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Filter:" />
                        <TextBox
                            Width="300"
                            Margin="0,0,12,0"
                            Text="{Binding QuickFilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Content="Treat as IDs"
                            IsChecked="{Binding TreatAsIds}" />
                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource App.BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QuickContains}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="Contains:" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding QuickContains}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource App.BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ContainsAnyFlag}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="Any:" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding ContainsAnyResult}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource App.BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ContainsAllFlag}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="All:" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding ContainsAllResult}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource App.BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCount}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="Count:" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding QuickCount}" />
                        </StackPanel>
                    </WrapPanel>

                    <!--  Divider  -->
                    <Border
                        Height="1"
                        Margin="0,12,0,12"
                        Background="{DynamicResource App.BorderBrush}" />

                    <!--  Actions Section  -->
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Action:" />
                        <ComboBox
                            Width="140"
                            Margin="0,0,12,0"
                            ItemContainerStyle="{StaticResource AppComboBoxItem}"
                            ItemsSource="{Binding ActionTypes}"
                            SelectedItem="{Binding SelectedAction}"
                            Style="{StaticResource AppComboBox}" />
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Using:" />
                        <TextBox
                            Width="260"
                            Margin="0,0,12,0"
                            Text="{Binding ActionInput}" />
                        <CheckBox
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Content="By ID"
                            IsChecked="{Binding UseIdForAction}" />
                        <Button
                            Width="120"
                            Height="30"
                            Command="{Binding ExecuteActionCommand}"
                            Content="Execute"
                            Style="{StaticResource AccentButton}" />
                    </WrapPanel>

                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding ActionResult}" />
                </StackPanel>
            </Border>

            <!--  Items List Card  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Items" />

                    <DataGrid
                        Height="460"
                        Margin="5"
                        AutoGenerateColumns="False"
                        Background="{DynamicResource App.BackgroundBrush}"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserSortColumns="True"
                        Foreground="{DynamicResource App.ForegroundBrush}"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding ItemsView}"
                        RowBackground="{DynamicResource App.CardBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="60"
                                Binding="{Binding Slot}"
                                Header="Slot" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Id}"
                                Header="ID" />
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="200"
                                Binding="{Binding Name}"
                                Header="Name" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding Amount}"
                                Header="Amount" />
                            <DataGridTemplateColumn Width="170" Header="Flags">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemFlagBadgesTemplate}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding Exp}"
                                Header="XP" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
