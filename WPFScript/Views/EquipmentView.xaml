<UserControl
    x:Class="MESharp.Views.EquipmentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Background="{DynamicResource App.BackgroundBrush}"
    Foreground="{DynamicResource App.ForegroundBrush}">

    <ScrollViewer>
        <StackPanel Margin="24">

            <!--  Header  -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial
                        Width="24"
                        Height="24"
                        Margin="0,0,8,0"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Kind="Shield" />
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Equipment" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Style="{StaticResource HeaderHelpButton}"
                    ToolTip="Open API docs"
                    Command="{Binding DataContext.ShowApiDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <iconPacks:PackIconMaterial
                        Width="18"
                        Height="18"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Kind="HelpCircleOutline" />
                </Button>
            </Grid>

            <!--  Status Card  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Status" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Current equipment panel state and quick loading." />

                    <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
                        <Button
                            Width="130"
                            Margin="0,0,12,8"
                            Command="{Binding RefreshStateCommand}"
                            Content="Refresh State"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="110"
                            Margin="0,0,12,8"
                            Command="{Binding LoadItemsCommand}"
                            Content="Load Items"
                            Style="{StaticResource AccentButton}" />
                        <StackPanel Margin="0,0,12,8" Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource App.BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Open:" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontSize="12"
                                Text="{Binding IsOpen}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8" Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource App.BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Empty:" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontSize="12"
                                Text="{Binding IsEmpty}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8" Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource App.BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Full:" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontSize="12"
                                Text="{Binding IsFull}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!--  Filter & Actions Card  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Filter and Actions" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Filter equipped items by name or IDs and perform actions." />

                    <!--  Filter Section  -->
                    <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Filter:" />
                        <TextBox
                            Width="300"
                            Margin="0,0,12,0"
                            Text="{Binding QuickFilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Count:" />
                        <TextBlock
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{Binding QuickCount}" />
                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource App.BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ContainsAnyFlag}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="Any:" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding ContainsAnyResult}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource App.BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ContainsAllFlag}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="All:" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding ContainsAllResult}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource App.BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ContainsOnlyFlag}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="Only:" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding ContainsOnlyResult}" />
                        </StackPanel>
                    </WrapPanel>

                    <!--  Divider  -->
                    <Border
                        Height="1"
                        Margin="0,12,0,12"
                        Background="{DynamicResource App.BorderBrush}" />

                    <!--  Actions Section  -->
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Action:" />
                        <Button
                            Width="120"
                            Height="30"
                            Command="{Binding AutoUnequipCommand}"
                            Content="Unequip"
                            Style="{StaticResource AccentButton}"
                            ToolTip="Uses ID if numeric, else Name" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!--  Equipped Items List Card  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Equipped Items" />

                    <Grid>
                        <DataGrid
                            Height="460"
                            Margin="5"
                            AutoGenerateColumns="False"
                            Background="{DynamicResource App.BackgroundBrush}"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserSortColumns="True"
                            Foreground="{DynamicResource App.ForegroundBrush}"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding QuickItems}"
                            RowBackground="{DynamicResource App.CardBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Slot}"
                                    Header="Slot" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Id}"
                                    Header="ID" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="200"
                                    Binding="{Binding Name}"
                                    Header="Name" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding Amount}"
                                    Header="Amount" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Xp}"
                                    Header="XP" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!--  Empty State Message  -->
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource App.MutedBrush}"
                            Text="No items equipped. Click 'Load Items' to refresh.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
