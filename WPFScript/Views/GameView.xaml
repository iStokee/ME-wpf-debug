<UserControl
    x:Class="MESharp.Views.GameView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:controls="clr-namespace:MESharp.Views.Controls"
    Background="{DynamicResource App.BackgroundBrush}"
    Foreground="{DynamicResource App.ForegroundBrush}">

    <ScrollViewer>
        <StackPanel Margin="5">

            <!--  Header  -->
            <controls:SectionHeader
                Margin="0,0,0,16"
                Title="Game"
                Description="Client status, connection info, and session diagnostics."
                IconKind="ApplicationCog"
                HelpCommand="{Binding DataContext.ShowHelpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                HelpCommandParameter="Game"
                HelpToolTip="Open Help" />

            <!--  Game Status Card  -->
            <Border
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Status" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Current game client information and connection status." />

                    <Grid Margin="0,16,0,0">
                        <Grid.Resources>
                            <Style x:Key="LabelTextStyle" TargetType="TextBlock">
                                <Setter Property="Margin" Value="0,6,0,6" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="12" />
                            </Style>
                            <Style x:Key="ValueTextStyle" TargetType="TextBlock">
                                <Setter Property="Margin" Value="16,6,0,6" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontSize" Value="12" />
                            </Style>
                            <Style
                                x:Key="RevealNameToggleStyle"
                                BasedOn="{StaticResource {x:Type ToggleButton}}"
                                TargetType="ToggleButton">
                                <Setter Property="Padding" Value="12,4" />
                                <Setter Property="MinWidth" Value="70" />
                                <Setter Property="Content" Value="Show" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Content" Value="Hide" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource LabelTextStyle}"
                            Text="State:" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding State}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource LabelTextStyle}"
                            Text="ProcessId:" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding ProcessId}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource LabelTextStyle}"
                            Text="Handle:" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding ProcessHandle}" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Style="{StaticResource LabelTextStyle}"
                            Text="HWND:" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding GameWindow}" />

                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Style="{StaticResource LabelTextStyle}"
                            Text="Injected:" />
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="1"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding IsInjected}" />

                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            Style="{StaticResource LabelTextStyle}"
                            Text="LocalPlayer:" />
                        <StackPanel
                            Grid.Row="5"
                            Grid.Column="1"
                            Margin="16,4,10,4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding DisplayedLocalPlayerName}" />
                            <ToggleButton
                                Margin="12,0,0,0"
                                IsChecked="{Binding IsLocalPlayerNameVisible, Mode=TwoWay}"
                                Style="{StaticResource RevealNameToggleStyle}"
                                ToolTip="Reveal or hide the local player name" />
                        </StackPanel>

                        <TextBlock
                            Grid.Row="6"
                            Grid.Column="0"
                            Style="{StaticResource LabelTextStyle}"
                            Text="Version:" />
                        <TextBlock
                            Grid.Row="6"
                            Grid.Column="1"
                            Style="{StaticResource ValueTextStyle}"
                            Text="{Binding Version}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
