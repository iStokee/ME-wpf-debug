<UserControl
    x:Class="MESharp.Views.NavigationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:MESharp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:NavigationViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:BoolToColorConverter x:Key="BoolToColorConverter" />
            <conv:BoolToStringConverter x:Key="BoolToStringConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="12"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Width="26"
                            Height="26"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Kind="MapMarkerPath" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="Navigation &amp; Movement" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                        Text="Test walk-to, waypoint paths, and lodestone teleports directly against the Traversal API."
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                        Text="{Binding LastStatus}" />
                        <Button
                            Padding="10,6"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource AccentButton}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Width="16"
                                Height="16"
                                Margin="0,0,6,0"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Kind="Refresh" />
                            <TextBlock Text="Refresh position" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Live status -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="12"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="Tile position" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontFamily="Consolas"
                        FontSize="13"
                        Text="{Binding TilePosition}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold" Text="Exact position" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontFamily="Consolas"
                        FontSize="13"
                        Text="{Binding ExactPosition}" />
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse
                        Width="14"
                        Height="14"
                        Margin="0,0,6,0"
                        Fill="{Binding IsMoving, Converter={StaticResource BoolToColorConverter}}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding IsMoving, Converter={StaticResource BoolToStringConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <!-- Walk to tile -->
                <Border
                    Margin="0,0,0,10"
                    Padding="12"
                    Background="{DynamicResource App.CardBrush}"
                    CornerRadius="6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Width="20"
                                Height="20"
                                Margin="0,0,6,0"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Kind="CursorDefaultClick" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Walk to tile" />
                        </StackPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock FontWeight="SemiBold" Text="X" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Padding="6"
                                    Text="{Binding TargetX, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock FontWeight="SemiBold" Text="Y" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Padding="6"
                                    Text="{Binding TargetY, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock FontWeight="SemiBold" Text="Z (optional)" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Padding="6"
                                    Text="{Binding TargetZ, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock FontWeight="SemiBold" Text="Stop short (tiles)" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Padding="6"
                                    Text="{Binding StopShortTiles, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock FontWeight="SemiBold" Text="Timeout (ms)" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Padding="6"
                                    Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock FontWeight="SemiBold" Text="Jitter (tiles)" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Padding="6"
                                    Text="{Binding JitterTiles, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Padding="12,8" Command="{Binding WalkToCommand}" Style="{StaticResource AccentButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,6,0"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Kind="Play" />
                                        <TextBlock Text="Walk" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Path walking -->
                <Border
                    Padding="12"
                    Background="{DynamicResource App.CardBrush}"
                    CornerRadius="6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Width="20"
                                Height="20"
                                Margin="0,0,6,0"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Kind="ChartTimelineVariant" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Waypoint path" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,8"
                            Foreground="{DynamicResource App.SubtleForegroundBrush}"
                            Text="One coordinate per line: x,y,z or x y z. Z is optional; 0=use current plane." />
                        <TextBox
                            MinHeight="140"
                            Padding="8"
                            AcceptsReturn="True"
                            Text="{Binding PathInput, UpdateSourceTrigger=PropertyChanged}"
                            VerticalScrollBarVisibility="Auto" />
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Padding="12,8" Command="{Binding WalkPathCommand}" Style="{StaticResource AccentButton}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,6,0"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        Kind="Walk" />
                                    <TextBlock Text="Walk path" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Lodestones + log -->
            <StackPanel Grid.Column="1">
                <Border
                    Margin="0,0,0,10"
                    Padding="12"
                    Background="{DynamicResource App.CardBrush}"
                    CornerRadius="6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Width="20"
                                Height="20"
                                Margin="0,0,6,0"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Kind="TransitTransfer" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Lodestone network" />
                        </StackPanel>

                        <Grid Margin="10,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="SemiBold" Text="Select destination" />
                                <ComboBox
                                    Margin="0,4,0,0"
                                    ItemsSource="{Binding Lodestones}"
                                    SelectedItem="{Binding SelectedLodestone}"
                                    DisplayMemberPath="Display" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Padding="10,6" Command="{Binding TeleportSelectedCommand}" Style="{StaticResource AccentButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,6,0"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Kind="RayStartArrow" />
                                        <TextBlock Text="Teleport" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="10,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="SemiBold" Text="Teleport by name" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Padding="6"
                                    Text="{Binding LodestoneSearch, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                    Text="Partial match is fine (e.g., 'priff', 'edge', 'lunar')." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Padding="10,6" Command="{Binding TeleportByNameCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,6,0"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Kind="ArrowDecisionAuto" />
                                        <TextBlock Text="Send" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="Teleport timeout (ms)" />
                            <TextBox
                                Width="100"
                                Margin="10,0,0,0"
                                Padding="6"
                                Text="{Binding TeleportTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Padding="12"
                    Background="{DynamicResource App.CardBrush}"
                    CornerRadius="6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Width="18"
                                Height="18"
                                Margin="0,0,6,0"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Kind="FormatListChecks" />
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Activity log" />
                        </StackPanel>
                        <ListBox
                            Margin="0,8,0,0"
                            ItemsSource="{Binding ActivityLog}"
                            MaxHeight="240" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
