<UserControl
    x:Class="MESharp.Views.NavigationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:MESharp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:NavigationViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:BoolToColorConverter x:Key="BoolToColorConverter" />
            <conv:BoolToStringConverter x:Key="BoolToStringConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="12"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Width="26"
                            Height="26"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Kind="MapMarkerPath" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="Navigation &amp; Movement" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                        Text="Test walk-to, waypoint paths, and lodestone teleports directly against the Traversal API."
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                        Text="{Binding LastStatus}" />
                    <Button
                        Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryCommandButton}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Width="16"
                                Height="16"
                                Margin="0,0,6,0"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Kind="Refresh" />
                            <TextBlock Text="Refresh position" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Live status  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="12"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="Tile position" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontFamily="Consolas"
                        FontSize="13"
                        Text="{Binding TilePosition}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold" Text="Exact position" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontFamily="Consolas"
                        FontSize="13"
                        Text="{Binding ExactPosition}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse
                        Width="14"
                        Height="14"
                        Margin="0,0,6,0"
                        Fill="{Binding IsMoving, Converter={StaticResource BoolToColorConverter}}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding IsMoving, Converter={StaticResource BoolToStringConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Main content  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <!--  Walk to tile  -->
                <Border
                    Margin="0,0,0,10"
                    Padding="12"
                    Background="{DynamicResource App.CardBrush}"
                    CornerRadius="6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Width="20"
                                Height="20"
                                Margin="0,0,6,0"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Kind="CursorDefaultClick" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Walk to tile" />
                        </StackPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,0,0">
                                <TextBlock FontWeight="SemiBold" Text="X" />
                                <DockPanel Margin="0,4,0,0">
                                    <StackPanel
                                        Width="28"
                                        DockPanel.Dock="Right"
                                        Orientation="Vertical">
                                        <Button
                                            Height="22"
                                            Padding="0"
                                            Command="{Binding NudgeXPositiveCommand}">
                                            <iconPacks:PackIconMaterial
                                                Width="14"
                                                Height="14"
                                                Kind="ChevronUp" />
                                        </Button>
                                        <Button
                                            Height="22"
                                            Padding="0"
                                            Command="{Binding NudgeXNegativeCommand}">
                                            <iconPacks:PackIconMaterial
                                                Width="14"
                                                Height="14"
                                                Kind="ChevronDown" />
                                        </Button>
                                    </StackPanel>
                                    <TextBox Padding="6" Text="{Binding TargetX, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock FontWeight="SemiBold" Text="Y" />
                                <DockPanel Margin="0,4,0,0">
                                    <StackPanel
                                        Width="28"
                                        DockPanel.Dock="Right"
                                        Orientation="Vertical">
                                        <Button
                                            Height="22"
                                            Padding="0"
                                            Command="{Binding NudgeYPositiveCommand}">
                                            <iconPacks:PackIconMaterial
                                                Width="14"
                                                Height="14"
                                                Kind="ChevronUp" />
                                        </Button>
                                        <Button
                                            Height="22"
                                            Padding="0"
                                            Command="{Binding NudgeYNegativeCommand}">
                                            <iconPacks:PackIconMaterial
                                                Width="14"
                                                Height="14"
                                                Kind="ChevronDown" />
                                        </Button>
                                    </StackPanel>
                                    <TextBox Padding="6" Text="{Binding TargetY, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock FontWeight="SemiBold" Text="Z (optional)" />
                                <DockPanel Margin="0,4,0,0">
                                    <StackPanel
                                        Width="28"
                                        DockPanel.Dock="Right"
                                        Orientation="Vertical">
                                        <Button
                                            Height="22"
                                            Padding="0"
                                            Command="{Binding NudgeZPositiveCommand}">
                                            <iconPacks:PackIconMaterial
                                                Width="14"
                                                Height="14"
                                                Kind="ChevronUp" />
                                        </Button>
                                        <Button
                                            Height="22"
                                            Padding="0"
                                            Command="{Binding NudgeZNegativeCommand}">
                                            <iconPacks:PackIconMaterial
                                                Width="14"
                                                Height="14"
                                                Kind="ChevronDown" />
                                        </Button>
                                    </StackPanel>
                                    <TextBox Padding="6" Text="{Binding TargetZ, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock FontWeight="SemiBold" Text="Stop short (tiles)" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Padding="6"
                                    Text="{Binding StopShortTiles, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel
                            Margin="0,10,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button Command="{Binding UseCurrentTileCommand}" Style="{StaticResource SecondaryCommandButton}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,6,0"
                                        Kind="CrosshairsGps" />
                                    <TextBlock Text="Use current tile" />
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Nudge step" />
                                <TextBox
                                    Width="60"
                                    Padding="6"
                                    Text="{Binding NudgeStep, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock FontWeight="SemiBold" Text="Timeout (ms)" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Padding="6"
                                    Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock FontWeight="SemiBold" Text="Jitter (tiles)" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Padding="6"
                                    Text="{Binding JitterTiles, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal">
                                <Button Command="{Binding WalkToCommand}" Style="{StaticResource PrimaryCommandButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial
                                            Width="20"
                                            Height="20"
                                            Margin="0,-2,6,0"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Kind="Play" />
                                        <TextBlock Text="Walk" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Margin="10,0,0,0"
                                    Command="{Binding ClickToCommand}"
                                    Style="{StaticResource SecondaryCommandButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,6,0"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Kind="CursorDefaultClick" />
                                        <TextBlock Text="Click only" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Path walking  -->
                <Border
                    Padding="12"
                    Background="{DynamicResource App.CardBrush}"
                    CornerRadius="6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Width="20"
                                Height="20"
                                Margin="0,0,6,0"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Kind="ChartTimelineVariant" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Waypoint path" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,8"
                            Foreground="{DynamicResource App.SubtleForegroundBrush}"
                            Text="One coordinate per line: x,y,z or x y z. Z is optional; 0=use current plane." />
                        <TextBox
                            MinHeight="140"
                            Padding="8"
                            AcceptsReturn="True"
                            Text="{Binding PathInput, UpdateSourceTrigger=PropertyChanged}"
                            VerticalScrollBarVisibility="Auto" />
                        <StackPanel
                            Margin="0,10,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button Command="{Binding WalkPathCommand}" Style="{StaticResource PrimaryCommandButton}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,6,0"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        Kind="Walk" />
                                    <TextBlock Text="Walk path" />
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="10,0,0,0"
                                Command="{Binding ClickPathCommand}"
                                Style="{StaticResource SecondaryCommandButton}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,6,0"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        Kind="CursorDefaultClick" />
                                    <TextBlock Text="Click path (no wait)" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Route builder / library  -->
                <Border
                    Margin="0,10,0,0"
                    Padding="12"
                    Background="{DynamicResource App.CardBrush}"
                    CornerRadius="6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Width="20"
                                Height="20"
                                Margin="0,0,6,0"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Kind="MapMarkerMultipleOutline" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Route builder" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,10"
                            Foreground="{DynamicResource App.SubtleForegroundBrush}"
                            Text="Capture waypoints from your position or target tile, name the route, and save it for reuse in other tools." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.05*" />
                            </Grid.ColumnDefinitions>

                            <!-- Builder -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock FontWeight="SemiBold" Text="Route name" />
                                <TextBox
                                    Margin="0,4,0,8"
                                    Padding="6"
                                    Text="{Binding RouteName, UpdateSourceTrigger=PropertyChanged}" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding AddCurrentWaypointCommand}" Style="{StaticResource SecondaryCommandButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                Kind="CrosshairsGps" />
                                            <TextBlock Text="Add current tile" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Margin="8,0,0,0"
                                        Command="{Binding AddTargetWaypointCommand}"
                                        Style="{StaticResource SecondaryCommandButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                Kind="CursorDefaultGesture" />
                                            <TextBlock Text="Add target" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Margin="8,0,0,0"
                                        Command="{Binding ClearRouteCommand}"
                                        Style="{StaticResource SecondaryCommandButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,6,0"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                Kind="Broom" />
                                            <TextBlock Text="Clear" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <ListBox
                                    Margin="0,10,0,0"
                                    Background="{DynamicResource App.BackgroundBrush}"
                                    BorderBrush="{DynamicResource PrimarySoftBrush}"
                                    BorderThickness="1"
                                    ItemsSource="{Binding CurrentRoute}"
                                    SelectedItem="{Binding SelectedWaypoint}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontFamily="Consolas" Text="{Binding}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <Button Command="{Binding RemoveWaypointCommand}" Style="{StaticResource SecondaryCommandButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                Kind="Delete" />
                                            <TextBlock Text="Remove selected" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Library -->
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" Text="Saved routes" />
                                <ComboBox
                                    Margin="0,4,0,0"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding SavedRoutes}"
                                    SelectedItem="{Binding SelectedRoute}" />
                                <TextBlock
                                    Margin="0,4,0,8"
                                    FontSize="11"
                                    Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                    Text="{Binding RouteStorePath}" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding SaveRouteCommand}" Style="{StaticResource PrimaryCommandButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                Kind="ContentSave" />
                                            <TextBlock Text="Save/overwrite" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Margin="8,0,0,0"
                                        Command="{Binding LoadRouteCommand}"
                                        Style="{StaticResource SecondaryCommandButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                Kind="FileSend" />
                                            <TextBlock Text="Load into path" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                    Text="Saved routes are stored as JSON for sharing; loading will hydrate the waypoint editor and path textbox." />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Lodestones + log  -->
            <StackPanel Grid.Column="1">
                <Border
                    Margin="0,0,0,10"
                    Padding="12"
                    Background="{DynamicResource App.CardBrush}"
                    CornerRadius="6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Width="20"
                                Height="20"
                                Margin="0,0,6,0"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Kind="TransitTransfer" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Lodestone network" />
                        </StackPanel>

                        <Grid Margin="10,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="SemiBold" Text="Select destination" />
                                <ComboBox
                                    Margin="0,4,0,0"
                                    DisplayMemberPath="Display"
                                    ItemsSource="{Binding Lodestones}"
                                    SelectedItem="{Binding SelectedLodestone}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal">
                                <Button
                                    Margin="8,0,0,0"
                                    Command="{Binding TeleportSelectedCommand}"
                                    Style="{StaticResource PrimaryCommandButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial
                                            Width="24"
                                            Height="24"
                                            Margin="0,-2,6,0"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Kind="RayStartArrow" />
                                        <TextBlock Text="Teleport" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="10,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="SemiBold" Text="Teleport by name" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Padding="6"
                                    Text="{Binding LodestoneSearch, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                    Text="Partial match is fine (e.g., 'priff', 'edge', 'lunar')." />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal">
                                <Button
                                    Margin="8,0,0,0"
                                    Command="{Binding TeleportByNameCommand}"
                                    Style="{StaticResource SecondaryCommandButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,6,0"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Kind="ArrowDecisionAuto" />
                                        <TextBlock Text="Send" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal">
                                <Button Command="{Binding WaitWhileMovingCommand}" Style="{StaticResource SecondaryCommandButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,6,0"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Kind="TimerSand" />
                                        <TextBlock Text="Wait stop" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <StackPanel
                            Margin="0,10,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold" Text="Teleport timeout (ms)" />
                            <TextBox
                                Width="100"
                                Margin="10,0,0,0"
                                Padding="6"
                                Text="{Binding TeleportTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Button Command="{Binding WaitUntilWithinCommand}" Style="{StaticResource SecondaryCommandButton}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,6,0"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        Kind="MapMarkerCheck" />
                                    <TextBlock Text="Wait arrival" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Padding="12"
                    Background="{DynamicResource App.CardBrush}"
                    CornerRadius="6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Width="18"
                                Height="18"
                                Margin="0,0,6,0"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Kind="FormatListChecks" />
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="Activity log" />
                        </StackPanel>
                        <ListBox
                            MaxHeight="240"
                            Margin="0,8,0,0"
                            Background="{DynamicResource App.BackgroundBrush}"
                            BorderBrush="{DynamicResource PrimarySoftBrush}"
                            BorderThickness="1"
                            FontFamily="Consolas"
                            FontSize="12"
                            Foreground="{DynamicResource App.ForegroundBrush}"
                            ItemsSource="{Binding ActivityLog}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="6,3" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
