<UserControl
    x:Class="MESharp.Views.WebwalkGraphView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:WebwalkGraphViewModel}"
    d:DesignHeight="860"
    d:DesignWidth="1200">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="{DynamicResource App.CardBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="90" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Top status bar ──────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="8,8,8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding LastStatus}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0" Foreground="Gray">
                    <Run Text="Tile: " /><Run Text="{Binding CurrentTile, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshGraphCommand}" Margin="4,0" Padding="10,4" />
                <Button Grid.Column="3" Content="Open File" Command="{Binding OpenGraphFileCommand}" Padding="10,4" />
            </Grid>
        </Border>

        <!-- ── Main three-column layout ───────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="8,8,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Col 0: Recorder + Node editor + Edge editor ───────────────── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Recorder -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Route Recorder" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" Margin="0" />
                                <TextBlock Text=" ● REC" Foreground="#FF4444" FontWeight="Bold" FontSize="11"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Route name" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding RecordRouteName, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Interval (s)" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding RecordIntervalSeconds}" />
                                <TextBlock Grid.Column="2" Text="Min dist" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />
                                <TextBox Grid.Column="3" Text="{Binding MinWaypointDistance}" />
                            </Grid>

                            <WrapPanel Margin="0,4,0,6">
                                <Button Content="▶ Start" Command="{Binding StartRecordingCommand}" Padding="10,4" Margin="0,0,6,0" />
                                <Button Content="■ Stop" Command="{Binding StopRecordingCommand}" Padding="10,4" Margin="0,0,6,0" />
                                <Button Content="Clear" Command="{Binding ClearRecordingCommand}" Padding="10,4" Margin="0,0,6,0" />
                                <Button Content="Save Route" Command="{Binding SaveRecordingAsRouteCommand}" Padding="10,4" Margin="0,0,6,0" />
                                <Button Content="Save Route + Edge" Command="{Binding SaveRecordingAndEdgeCommand}" Padding="10,4" />
                            </WrapPanel>

                            <TextBlock Text="Recorded tiles (newest first):" Foreground="Gray" FontSize="11" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding RecordingSummary}" Foreground="Gray" FontSize="11" Margin="0,0,0,4" />
                            <ListBox ItemsSource="{Binding RecordedTiles}" MaxHeight="100" FontSize="11"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </StackPanel>
                    </Border>

                    <!-- Node editor -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Add / Update Node" Style="{StaticResource SectionHeader}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Node ID" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding NewNodeId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding NewNodeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="X / Y / Z" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBox Text="{Binding NewNodeX}" Width="70" Margin="0,0,4,0" />
                                    <TextBox Text="{Binding NewNodeY}" Width="70" Margin="0,0,4,0" />
                                    <TextBox Text="{Binding NewNodeZ}" Width="50" />
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Tags" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding NewNodeTags, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                                           ToolTip="Comma-separated, e.g.: bank, lumbridge, safe" />

                                <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Use Current Tile" Command="{Binding UseCurrentTileForNodeCommand}" Padding="10,4" Margin="0,0,6,0" />
                                    <Button Grid.Column="1" Content="Save Node" Command="{Binding SaveNodeCommand}" Padding="10,4" />
                                </Grid>

                                <WrapPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                    <Button Content="Load Selected" Command="{Binding LoadSelectedNodeCommand}" Padding="8,3" Margin="0,0,6,0" />
                                    <Button Content="Use as From" Command="{Binding UseSelectedNodeAsFromCommand}" Padding="8,3" Margin="0,0,6,0" />
                                    <Button Content="Use as To" Command="{Binding UseSelectedNodeAsToCommand}" Padding="8,3" Margin="0,0,6,0" />
                                    <Button Content="Delete Node" Command="{Binding DeleteSelectedNodeCommand}" Padding="8,3" />
                                </WrapPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Edge editor -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Add / Update Edge" Style="{StaticResource SectionHeader}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Edge ID" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding NewEdgeId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="From node" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding NewEdgeFrom, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                                           ToolTip="Use * for global teleport (available from anywhere)" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="To node" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding NewEdgeTo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Kind" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox  Grid.Row="3" Grid.Column="1" Text="{Binding NewEdgeKind}" IsEditable="True" Margin="0,0,0,4">
                                    <ComboBoxItem Content="route" />
                                </ComboBox>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Route ID" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding NewEdgeRouteId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                                           ToolTip="Required when Kind=route. Auto-filled after saving a recording." />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Route pick" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox  Grid.Row="5" Grid.Column="1"
                                           ItemsSource="{Binding Routes}"
                                           SelectedItem="{Binding SelectedRoute}"
                                           DisplayMemberPath="Id"
                                           Margin="0,0,0,4"
                                           ToolTip="Pick a known route, then apply it to the edge." />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Cost (ms)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox   Grid.Row="6" Grid.Column="1" Text="{Binding NewEdgeCostMs}" Margin="0,0,0,4" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Danger lvl" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox   Grid.Row="7" Grid.Column="1" Text="{Binding NewEdgeDangerLevel}" Margin="0,0,0,4"
                                           ToolTip="0=safe, 1=PVP risk, 2+=wilderness" />

                                <WrapPanel Grid.Row="8" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                    <Button Content="Use Route" Command="{Binding UseSelectedRouteForEdgeCommand}" Padding="8,4" Margin="0,0,6,0" />
                                    <Button Content="Validate Route" Command="{Binding ValidateSelectedRouteCommand}" Padding="8,4" Margin="0,0,6,0" />
                                    <Button Content="Load Edge" Command="{Binding LoadSelectedEdgeCommand}" Padding="8,4" Margin="0,0,6,0" />
                                    <Button Content="Delete Edge" Command="{Binding DeleteSelectedEdgeCommand}" Padding="8,4" Margin="0,0,6,0" />
                                    <Button Content="Save Edge" Command="{Binding SaveEdgeCommand}" Padding="10,4" />
                                </WrapPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── Splitter ────────────────────────────────────────────────────── -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- ── Col 2: Node list + Edge list ──────────────────────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="150" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Nodes -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}">
                            <Run Text="Nodes (" /><Run Text="{Binding Nodes.Count, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" FontSize="11"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="110" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="100" />
                                <DataGridTextColumn Header="X" Binding="{Binding X}" Width="55" />
                                <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="55" />
                                <DataGridTextColumn Header="Z" Binding="{Binding Z}" Width="40" />
                                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="35" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- Routes -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}">
                            <Run Text="Routes (" /><Run Text="{Binding Routes.Count, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Routes}" SelectedItem="{Binding SelectedRoute}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" FontSize="11"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="160" />
                                <DataGridTextColumn Header="Cat" Binding="{Binding Category}" Width="70" />
                                <DataGridTextColumn Header="WP" Binding="{Binding WaypointCount}" Width="42" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- Edges -->
                <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}">
                            <Run Text="Edges (" /><Run Text="{Binding Edges.Count, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Edges}" SelectedItem="{Binding SelectedEdge}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" FontSize="11"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBrokenRef}" Value="True">
                                            <Setter Property="Background" Value="#40FF4444" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100" />
                                <DataGridTextColumn Header="From" Binding="{Binding From}" Width="90" />
                                <DataGridTextColumn Header="To" Binding="{Binding To}" Width="90" />
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="70" />
                                <DataGridTextColumn Header="Route" Binding="{Binding RouteId}" Width="80" />
                                <DataGridTextColumn Header="Cost" Binding="{Binding CostMs}" Width="55" />
                                <DataGridTextColumn Header="Issue" Binding="{Binding IssueSummary}" Width="120" />
                                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="35" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Splitter ────────────────────────────────────────────────────── -->
            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- ── Col 4: Validation + Activity log ──────────────────────────── -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="180" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Path preview -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Path Preview" Style="{StaticResource SectionHeader}" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="From" Style="{StaticResource FieldLabel}" Width="60" />
                            <TextBox Grid.Column="1" Text="{Binding PathFromNodeId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="2" Text="To" Style="{StaticResource FieldLabel}" Width="40" />
                            <TextBox Grid.Column="3" Text="{Binding PathToNodeId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                            <Button Grid.Column="4" Content="Preview" Command="{Binding PreviewPathCommand}" Padding="8,3" Margin="0,0,6,0" />
                            <Button Grid.Column="5" Content="Run" Command="{Binding RunPreviewPathCommand}" Padding="8,3" Margin="0,0,6,0" />
                            <Button Grid.Column="6" Content="Stop" Command="{Binding StopPathCommand}" Padding="8,3" />
                        </Grid>
                        <TextBlock Text="{Binding PathPreview}" TextWrapping="Wrap" FontSize="11" Foreground="Gray" />
                        <TextBlock Text="{Binding PathRunStatus}" TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <!-- Validation header -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Validation" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                    <Button Content="Validate" Command="{Binding ValidateGraphCommand}" Padding="8,3" Margin="8,0,0,0" />
                    <Border Padding="6,2" CornerRadius="4" Background="#40FF4444" Margin="8,0,0,0"
                            Visibility="{Binding HasValidationErrors, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="ERRORS" FontSize="11" FontWeight="Bold" Foreground="#FFDD44" />
                    </Border>
                    <Border Padding="6,2" CornerRadius="4" Background="#40FFAA00" Margin="6,0,0,0"
                            Visibility="{Binding HasValidationWarnings, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="WARNINGS" FontSize="11" FontWeight="Bold" Foreground="#FFDD44" />
                    </Border>
                </StackPanel>

                <!-- Validation list -->
                <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,0">
                    <ListBox ItemsSource="{Binding ValidationIssues}" FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" />
                </Border>

                <GridSplitter Grid.Row="5" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- Activity log header -->
                <TextBlock Grid.Row="6" Text="Activity Log" Style="{StaticResource SectionHeader}" Margin="0,4,0,4" />

                <!-- Activity log -->
                <Border Grid.Row="7" Style="{StaticResource Card}" Margin="0,0,0,0">
                    <ListBox ItemsSource="{Binding ActivityLog}" FontSize="11" FontFamily="Consolas"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" />
                </Border>
            </Grid>
        </Grid>

        <!-- ── Bottom hint bar ─────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="8,0,8,8">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="InformationOutline" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="Gray" />
                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="Gray"
                           Text="Record a route by walking in-game, then wire it to a route edge. Teleport edges are supported by the shared graph layer and MCP tooling." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
