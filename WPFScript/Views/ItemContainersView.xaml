<UserControl
    x:Class="MESharp.Views.ItemContainersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:MESharp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ItemContainersViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">


    <UserControl.Resources>
        <ResourceDictionary>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="10"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="5">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Item Container Inspector" />
                <TextBlock
                    Foreground="{DynamicResource App.SubtleForegroundBrush}"
                    Text="View detailed metadata for all item containers (Inventory, Bank, Equipment, Loot, Familiar, Trade, Material Cache)"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  Controls  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="10"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,15,0"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Text="Container:" />
                    <ComboBox
                        Width="150"
                        ItemsSource="{Binding AvailableContainers}"
                        SelectedItem="{Binding SelectedContainer}" />
                </StackPanel>

                <CheckBox
                    Grid.Column="1"
                    Margin="0,0,15,0"
                    VerticalAlignment="Center"
                    Content="Include Coordinates"
                    IsChecked="{Binding IncludeCoordinates}" />

                <Button
                    Grid.Column="2"
                    Margin="0,0,10,0"
                    Padding="15,5"
                    Command="{Binding LoadItemsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="Refresh" />
                        <TextBlock Text="Load Items" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="3"
                    Padding="15,5"
                    Command="{Binding ClearCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="Close" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!--  Data Grid  -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,10"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid
                    Grid.Row="0"
                    Margin="5"
                    AutoGenerateColumns="False"
                    BorderThickness="0"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Items}"
                    RowBackground="{DynamicResource App.CardBrush}"
                    SelectedItem="{Binding SelectedItem}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="50"
                            Binding="{Binding Slot}"
                            Header="Slot" />
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding Id}"
                            Header="ID" />
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="150"
                            Binding="{Binding Name}"
                            Header="Name" />
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding Stack}"
                            Header="Stack" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding Category}"
                            Header="Category" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding GELimit}"
                            Header="GE Limit" />
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding HighAlch}"
                            Header="High Alch" />
                        <DataGridCheckBoxColumn
                            Width="70"
                            Binding="{Binding IsNoted, Mode=OneWay}"
                            Header="Noted" />
                        <DataGridCheckBoxColumn
                            Width="80"
                            Binding="{Binding IsStackable, Mode=OneWay}"
                            Header="Stackable" />
                        <DataGridCheckBoxColumn
                            Width="85"
                            Binding="{Binding IsTradeable, Mode=OneWay}"
                            Header="Tradeable" />
                        <DataGridCheckBoxColumn
                            Width="85"
                            Binding="{Binding IsBankable, Mode=OneWay}"
                            Header="Bankable" />
                        <DataGridCheckBoxColumn
                            Width="80"
                            Binding="{Binding IsAlchable, Mode=OneWay}"
                            Header="Alchable" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding ScreenX, StringFormat=F1}"
                            Header="Screen X" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding ScreenY, StringFormat=F1}"
                            Header="Screen Y" />
                    </DataGrid.Columns>
                </DataGrid>

                <!--  Selected Item Details  -->
                <Border
                    Grid.Row="1"
                    Margin="5"
                    Padding="10"
                    Background="{DynamicResource App.BackgroundBrush}"
                    CornerRadius="3"
                    Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,5"
                            FontWeight="SemiBold"
                            Text="Selected Item Details" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,10,2"
                                Text="Interface IDs: " />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding SelectedItem.InterfaceId1, StringFormat='{}{0}'}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,10,2"
                                Text="Screen Position: " />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Foreground="{DynamicResource PrimaryBrush}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="X: {0:F1}, Y: {1:F1}, Z: {2:F1}">
                                        <Binding Path="SelectedItem.ScreenX" />
                                        <Binding Path="SelectedItem.ScreenY" />
                                        <Binding Path="SelectedItem.ScreenZ" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,0,10,2"
                                Text="Properties: " />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Foreground="{DynamicResource PrimaryBrush}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Noted:{0} | Stack:{1} | Trade:{2} | Bank:{3} | Alch:{4}">
                                        <Binding Path="SelectedItem.IsNoted" />
                                        <Binding Path="SelectedItem.IsStackable" />
                                        <Binding Path="SelectedItem.IsTradeable" />
                                        <Binding Path="SelectedItem.IsBankable" />
                                        <Binding Path="SelectedItem.IsAlchable" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!--  Status Bar  -->
        <Border
            Grid.Row="3"
            Padding="10"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,20,0"
                    Orientation="Horizontal">
                    <iconPacks:PackIconMaterial
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Kind="ViewList" />
                    <TextBlock VerticalAlignment="Center" Text="Items: " />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Text="{Binding ItemCount, Mode=OneWay}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource App.SubtleForegroundBrush}"
                    Text="{Binding StatusMessage}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
