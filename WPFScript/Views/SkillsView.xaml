<UserControl
    x:Class="MESharp.Views.SkillsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:MESharp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MESharp.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    Background="#FF232323"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <vm:SkillsViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  MahApps core  -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.Teal.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <RotateTransform x:Key="BorderRotateTransform" Angle="0" CenterX="0.5" CenterY="0.5" />

            <LinearGradientBrush x:Key="AnimatedBorderBrush" MappingMode="RelativeToBoundingBox" Transform="{StaticResource BorderRotateTransform}" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Offset="0" Color="{Binding PrimaryBrush.Color}" />
                <GradientStop Offset="0.33" Color="{Binding SecondaryBrush.Color}" />
                <GradientStop Offset="0.66" Color="{Binding PrimaryBrush.Color}" />
                <GradientStop Offset="0.99" Color="{Binding SecondaryBrush.Color}" />
            </LinearGradientBrush>

            <conv:BoolToStringConverter x:Key="BoolToString" />
            <conv:ToOpacityBrushConverter x:Key="ToOpacityBrush" />
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />

            <!--  overall window & card background  -->
            <SolidColorBrush x:Key="AppBackground" Color="#5f5f62" />
            <SolidColorBrush x:Key="CardBackground" Color="#44444a" />

            <!--  Outer “chrome” outline  -->
            <Style x:Key="SkillChromeBorderStyle" TargetType="Border">
                <!--  spacing between cards  -->
                <Setter Property="Margin" Value="6" />
                <!--  gap between chrome and gradient  -->
                <Setter Property="Padding" Value="0" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="CornerRadius" Value="10" />
                <!--  2px larger than inner  -->
                <Setter Property="BorderBrush" Value="#66FFFFFF" />
                <!--  40% white  -->
                <Setter Property="BorderThickness" Value="2" />
            </Style>

            <!--  Inner gradient border  -->
            <Style x:Key="SkillCardStyle" TargetType="Border">
                <!--  NO margin or padding here!  -->
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="{StaticResource CardBackground}" />
                <Setter Property="BorderThickness" Value="4" />
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <LinearGradientBrush>
                            <GradientStop Offset="0" Color="{Binding PrimaryBrush.Color}" />
                            <GradientStop Offset="0.33" Color="{Binding SecondaryBrush.Color}" />
                            <GradientStop Offset="0.66" Color="{Binding PrimaryBrush.Color}" />
                            <GradientStop Offset="0.99" Color="{Binding SecondaryBrush.Color}" />

                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  text styles for consistent padding & alignment  -->
            <Style x:Key="SkillTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style
                x:Key="SkillTitleTextStyle"
                BasedOn="{StaticResource SkillTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,0" />
            </Style>

            <!--  A “list” card: same outer chrome, but horizontal layout  -->
            <DataTemplate x:Key="ListSkillTemplate">
                <Border Style="{StaticResource SkillChromeBorderStyle}">
                    <Border Style="{StaticResource SkillCardStyle}">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Level badge  -->
                            <Border
                                Grid.Column="0"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Background="{Binding SecondaryBrush, Converter={StaticResource ToOpacityBrush}, ConverterParameter=0.4}"
                                CornerRadius="4">
                                <TextBlock Style="{StaticResource SkillTitleTextStyle}" Text="{Binding Level}" />
                            </Border>

                            <!--  Name  -->
                            <TextBlock
                                Grid.Column="1"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SkillTitleTextStyle}"
                                Text="{Binding Name}" />

                            <!--  compact metrics  -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="5,0,20,0"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="Total XP" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="5,0,20,0"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="{Binding Xp, StringFormat=N0}" />

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="15,0,20,0"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="Gained XP" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="15,0,20,0"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="{Binding XpGained, StringFormat=N0}" />

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="15,0,20,0"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="XP/hr" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="15,0,20,0"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="{Binding XpPerHour, StringFormat=N0}" />

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Margin="15,0,20,0"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="Next lvl" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Margin="15,0,20,0"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="{Binding XpToNext, StringFormat=N0}" />

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="4"
                                    Margin="15,0,20,0"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="ETA" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="4"
                                    Margin="15,0,20,0"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="{Binding EtaString}" />

                            </Grid>
                        </Grid>
                    </Border>
                </Border>
            </DataTemplate>

            <!--  1) The “grid” card (copy of your existing inline DataTemplate)  -->
            <DataTemplate x:Key="GridSkillTemplate">
                <Border Style="{StaticResource SkillChromeBorderStyle}">
                    <Border Style="{StaticResource SkillCardStyle}">
                        <StackPanel Margin="6">
                            <!--  Header: Level + Name + colored bar  -->
                            <StackPanel Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Level badge  -->
                                    <Border
                                        Grid.Column="0"
                                        Padding="6,2"
                                        VerticalAlignment="Center"
                                        Background="{Binding SecondaryBrush, Converter={StaticResource ToOpacityBrush}, ConverterParameter=0.4}"
                                        CornerRadius="6">
                                        <TextBlock Style="{StaticResource SkillTitleTextStyle}" Text="{Binding Level}" />
                                    </Border>

                                    <!--  Skill name  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SkillTitleTextStyle}"
                                        Text="{Binding Name}" />
                                </Grid>

                                <!--  colored underline  -->
                                <Rectangle
                                    Height="3"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Stretch">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Offset="0" Color="{Binding SecondaryBrush.Color}" />
                                            <GradientStop Offset="0.25" Color="{Binding PrimaryBrush.Color}" />
                                            <GradientStop Offset="0.5" Color="{Binding SecondaryBrush.Color}" />
                                            <GradientStop Offset="0.75" Color="{Binding PrimaryBrush.Color}" />
                                            <GradientStop Offset="1" Color="{Binding SecondaryBrush.Color}" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </StackPanel>

                            <!--  Metrics grid  -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <!--  labels / values  -->
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,5,2"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="Total XP:" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="5,0,0,2"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="{Binding Xp, StringFormat=N0}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,5,2"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="Gained XP:" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="5,0,0,2"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="{Binding XpGained, StringFormat=N0}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,0,5,2"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="XP/hr:" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="5,0,0,2"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="{Binding XpPerHour, StringFormat=N0}" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,0,5,2"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="XP to lvl:" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="5,0,0,2"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="{Binding XpToNext, StringFormat=N0}" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Margin="0,0,5,2"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="ETA:" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Margin="5,0,0,2"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SkillTextBlockStyle}"
                                    Text="{Binding EtaString}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>
            </DataTemplate>

            <!--  Two ItemsPanelTemplates  -->
            <ItemsPanelTemplate x:Key="GridItemsPanel">
                <WrapPanel ItemWidth="225" Orientation="Horizontal" />
            </ItemsPanelTemplate>

            <ItemsPanelTemplate x:Key="ListItemsPanel">
                <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>

            <!--  Stylized Dark ToggleButton  -->
            <Style x:Key="DarkToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="#393943" />
                <Setter Property="BorderBrush" Value="#595967" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                x:Name="border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <!--  MouseOver/Focus  -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#51515f" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#8888a3" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#99ccff" />
                                </Trigger>
                                <!--  Pressed  -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#22222b" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#bbf" />
                                </Trigger>
                                <!--  Checked (Toggled)  -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#23233a" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#51a8ff" />
                                    <Setter Property="Foreground" Value="#51a8ff" />
                                </Trigger>
                                <!--  Disabled  -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#333337" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#26262a" />
                                    <Setter Property="Foreground" Value="#666" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>


    <DockPanel Margin="12">
        <!--  Header: toggle + session runtime  -->
        <StackPanel
            Margin="0,0,0,8"
            VerticalAlignment="Center"
            DockPanel.Dock="Top"
            Orientation="Horizontal">

            <!--  List View Toggle  -->
            <ToggleButton
                Width="36"
                Height="36"
                Margin="0,0,10,0"
                Padding="0"
                IsChecked="{Binding IsListView, Mode=TwoWay}"
                Style="{StaticResource DarkToggleButtonStyle}"
                ToolTip="Switch to List View">
                <materialDesign:PackIcon
                    Width="20"
                    Height="20"
                    Kind="ViewList" />
            </ToggleButton>

            <!--  Grid View Toggle  -->
            <ToggleButton
                Width="36"
                Height="36"
                Margin="0,0,10,0"
                Padding="0"
                IsChecked="{Binding IsListView, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"
                Style="{StaticResource DarkToggleButtonStyle}"
                ToolTip="Switch to Grid View">
                <materialDesign:PackIcon
                    Width="20"
                    Height="20"
                    Kind="ViewGrid" />
            </ToggleButton>

            <!--  Keep your “Show Only Active” next  -->
            <ToggleButton
                Content="Active Only"
                IsChecked="{Binding ShowOnlyActive, Mode=TwoWay}"
                Style="{StaticResource DarkToggleButtonStyle}"
                ToolTip="Show only skills with XP gains" />
        </StackPanel>

        <!--  Scrollable grid of uniform cards  -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SkillsView}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <!--  default to grid  -->
                        <Setter Property="ItemTemplate" Value="{StaticResource GridSkillTemplate}" />
                        <Setter Property="ItemsPanel" Value="{StaticResource GridItemsPanel}" />

                        <Style.Triggers>
                            <!--  when IsListView == true, switch to list  -->
                            <DataTrigger Binding="{Binding IsListView}" Value="True">
                                <Setter Property="ItemTemplate" Value="{StaticResource ListSkillTemplate}" />
                                <Setter Property="ItemsPanel" Value="{StaticResource ListItemsPanel}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>


        </ScrollViewer>

    </DockPanel>

</UserControl>
