<UserControl
    x:Class="MESharp.Views.PlayersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:MESharp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:controls="clr-namespace:MESharp.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:PlayersViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:BoolToStringConverter x:Key="BoolToStringConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!--  Main Content Area  -->
        <Grid Grid.Column="0" Margin="0,0,5,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <controls:SectionHeader
                Grid.Row="0"
                Margin="0,0,0,10"
                Title="Players"
                Description="LocalPlayer status and nearby player interactions."
                IconKind="Account"
                HelpCommand="{Binding DataContext.ShowApiDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

            <!--  LocalPlayer Status Card  -->
            <Border
                Grid.Row="1"
                Margin="0,0,0,10"
                Padding="12"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="5">
                <Expander Header="LocalPlayer Status" IsExpanded="True">
                    <Grid Margin="0,10,0,0">
                        <Grid.Resources>
                            <Style x:Key="LabelTextStyle" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                                <Setter Property="Margin" Value="0,4,0,4" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="11" />
                            </Style>
                            <Style x:Key="ValueTextStyle" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                                <Setter Property="Margin" Value="10,4,0,4" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontSize" Value="11" />
                            </Style>
                        </Grid.Resources>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Column 1: Position & Movement  -->
                        <Border
                            Grid.Column="0"
                            Margin="0,0,5,0"
                            Padding="8"
                            Background="{DynamicResource App.BackgroundBrush}"
                            CornerRadius="4">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Text="Position &amp; Movement" />
                                <Rectangle
                                    Height="2"
                                    Margin="0,4,0,6"
                                    Fill="{DynamicResource PrimaryBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelTextStyle}"
                                        Text="Logged In:" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Style="{StaticResource ValueTextStyle}"
                                        Text="{Binding IsLoggedIn, Converter={StaticResource BoolToStringConverter}}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelTextStyle}"
                                        Text="Tile Pos:" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueTextStyle}"
                                        Text="{Binding TilePosition}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelTextStyle}"
                                        Text="Exact Pos:" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueTextStyle}"
                                        Text="{Binding ExactPosition}" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelTextStyle}"
                                        Text="Moving:" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Style="{StaticResource ValueTextStyle}"
                                        Text="{Binding IsMoving, Converter={StaticResource BoolToStringConverter}}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  Column 2: Combat & Activity  -->
                        <Border
                            Grid.Column="1"
                            Margin="5,0,5,0"
                            Padding="8"
                            Background="{DynamicResource App.BackgroundBrush}"
                            CornerRadius="4">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Text="Combat &amp; Activity" />
                                <Rectangle
                                    Height="2"
                                    Margin="0,4,0,6"
                                    Fill="{DynamicResource PrimaryBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelTextStyle}"
                                        Text="In Combat:" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Style="{StaticResource ValueTextStyle}"
                                        Text="{Binding IsInCombat, Converter={StaticResource BoolToStringConverter}}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelTextStyle}"
                                        Text="Animation:" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueTextStyle}"
                                        Text="{Binding Animation}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelTextStyle}"
                                        Text="Hover:" />
                                    <ProgressBar
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Height="16"
                                        Margin="10,4,0,4"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource App.CardBrush}"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Maximum="100"
                                        Value="{Binding HoverProgress}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  Column 3: Target & Distance Tool  -->
                        <Border
                            Grid.Column="2"
                            Margin="5,0,0,0"
                            Padding="8"
                            Background="{DynamicResource App.BackgroundBrush}"
                            CornerRadius="4">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Text="Target &amp; Distance" />
                                <Rectangle
                                    Height="2"
                                    Margin="0,4,0,6"
                                    Fill="{DynamicResource PrimaryBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelTextStyle}"
                                        Text="Target:" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueTextStyle}"
                                        Text="{Binding InteractingWith}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding InteractingWith}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource LabelTextStyle}"
                                        Text="Target ID:" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource ValueTextStyle}"
                                        Text="{Binding InteractingWithId}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,8,0,4"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                        Text="Distance Calculator:" />
                                </Grid>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,2"
                                        FontSize="10"
                                        Foreground="{DynamicResource App.ForegroundBrush}"
                                        Text="To:" />
                                    <StackPanel
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        Orientation="Horizontal">
                                        <TextBox
                                            Width="40"
                                            Margin="0,0,2,0"
                                            FontSize="10"
                                            Text="{Binding DistanceToX, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox
                                            Width="40"
                                            Margin="2,0,2,0"
                                            FontSize="10"
                                            Text="{Binding DistanceToY, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox
                                            Width="40"
                                            Margin="2,0,0,0"
                                            FontSize="10"
                                            Text="{Binding DistanceToZ, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,2"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource App.ForegroundBrush}"
                                        Text="Dist:" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="4,2,0,2"
                                        FontFamily="Consolas"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Text="{Binding CalculatedDistance, StringFormat={}{0:F2}}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Expander>
            </Border>

            <!--  Nearby Players Controls  -->
            <Border
                Grid.Row="2"
                Margin="0,0,0,10"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Controls Bar  -->
                    <Border
                        Grid.Row="0"
                        Padding="10"
                        BorderBrush="{DynamicResource App.SubtleForegroundBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Max Distance:" />

                            <TextBox
                                Grid.Column="1"
                                Width="60"
                                Margin="0,0,15,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource App.BackgroundBrush}"
                                Foreground="{DynamicResource App.ForegroundBrush}"
                                Text="{Binding MaxDistance}" />

                            <TextBlock
                                Grid.Column="2"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Filter:" />

                            <TextBox
                                Grid.Column="3"
                                Margin="0,0,15,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource App.BackgroundBrush}"
                                Foreground="{DynamicResource App.ForegroundBrush}"
                                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox
                                Grid.Column="4"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Content="Auto Refresh"
                                IsChecked="{Binding AutoRefresh}" />

                            <StackPanel Grid.Column="5" Orientation="Horizontal">
                                <Button
                                    Margin="0,0,5,0"
                                    Command="{Binding LoadPlayersCommand}"
                                    Style="{StaticResource SecondaryCommandButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Kind="Refresh" />
                                        <TextBlock Text="Load" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ClearCommand}" Style="{StaticResource SecondaryCommandButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Kind="Close" />
                                        <TextBlock Text="Clear" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Players DataGrid  -->
                    <DataGrid
                        Grid.Row="1"
                        Margin="5"
                        AlternatingRowBackground="{DynamicResource App.CardBrush}"
                        AutoGenerateColumns="False"
                        Background="{DynamicResource App.BackgroundBrush}"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserSortColumns="True"
                        Foreground="{DynamicResource App.ForegroundBrush}"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding PlayersView}"
                        RowBackground="{DynamicResource App.BackgroundBrush}"
                        SelectedItem="{Binding SelectedPlayer}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource App.CardBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                                <Setter Property="FontSize" Value="12" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="120"
                                Binding="{Binding Name}"
                                Header="Name"
                                SortMemberPath="Name" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Distance, StringFormat={}{0:F1}}"
                                Header="Distance"
                                SortMemberPath="Distance" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Health}"
                                Header="Health"
                                SortMemberPath="Health" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Animation}"
                                Header="Anim"
                                SortMemberPath="Animation" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding CombatLevel}"
                                Header="Combat Lv"
                                SortMemberPath="CombatLevel" />
                            <DataGridTextColumn
                                Width="60"
                                Binding="{Binding X}"
                                Header="X"
                                SortMemberPath="X" />
                            <DataGridTextColumn
                                Width="60"
                                Binding="{Binding Y}"
                                Header="Y"
                                SortMemberPath="Y" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Id}"
                                Header="ID"
                                SortMemberPath="Id" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!--  Status Bar  -->
            <Border
                Grid.Row="3"
                Padding="10"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Margin="0,0,20,0"
                        Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Kind="AccountMultiple" />
                        <TextBlock VerticalAlignment="Center" Text="Players: " />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Text="{Binding PlayerCount, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                        Text="{Binding StatusMessage}" />
                </Grid>
            </Border>
        </Grid>

        <!--  Action Panel  -->
        <Border
            Grid.Column="1"
            Width="320"
            Margin="6,0,0,0"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="6">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="0,0,0,12" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </StackPanel.Resources>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource App.ForegroundBrush}"
                        Text="Player Actions" />
                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="11"
                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                        Text="{Binding SelectedPlayer.Name, TargetNullValue='Select a player from the list'}" />

                    <Border
                        Padding="20"
                        Background="{DynamicResource App.BackgroundBrush}"
                        CornerRadius="6">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,14"
                                FontSize="12"
                                Foreground="{DynamicResource App.ForegroundBrush}"
                                Text="Actions use Max Distance and the selected player"
                                TextWrapping="Wrap" />

                            <Button Command="{Binding AttackCommand}" Style="{StaticResource PrimaryCommandButton}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        Kind="Sword" />
                                    <TextBlock VerticalAlignment="Center" Text="Attack" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding FollowCommand}" Style="{StaticResource SecondaryCommandButton}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        Kind="Walk" />
                                    <TextBlock VerticalAlignment="Center" Text="Follow" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding TradeCommand}" Style="{StaticResource SecondaryCommandButton}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        Kind="Handshake" />
                                    <TextBlock VerticalAlignment="Center" Text="Trade" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ExamineCommand}" Style="{StaticResource SecondaryCommandButton}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        Kind="Magnify" />
                                    <TextBlock VerticalAlignment="Center" Text="Examine" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
