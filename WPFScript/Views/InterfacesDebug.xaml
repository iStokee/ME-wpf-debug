
<Page x:Class="ME_wpf_debug.InterfacesDebug"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ME_wpf_debug"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="InterfacesDebug">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel>
                <TextBlock Text="Interfaces" FontSize="20" FontWeight="Bold" Margin="10"/>
                <Button Content="Refresh" Click="Refresh_Click" Margin="10"/>
                <TreeView x:Name="InterfacesTreeView" Margin="10">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}"/>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
