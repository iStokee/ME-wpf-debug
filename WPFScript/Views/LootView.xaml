<UserControl x:Class="MESharp.Views.LootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:MESharp.ViewModels"
             Background="{DynamicResource App.BackgroundBrush}"
             Foreground="{DynamicResource App.ForegroundBrush}">

    <UserControl.Resources />

    <UserControl.DataContext>
        <vm:LootViewModel />
    </UserControl.DataContext>

    <ScrollViewer>
        <StackPanel Margin="24">
            <!--  Header  -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial
                        Width="24"
                        Height="24"
                        Margin="0,0,8,0"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Kind="PackageVariant" />
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Loot Window" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Style="{StaticResource HeaderHelpButton}"
                    ToolTip="Open API docs"
                    Command="{Binding DataContext.ShowApiDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <iconPacks:PackIconMaterial
                        Width="18"
                        Height="18"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Kind="HelpCircleOutline" />
                </Button>
            </Grid>

            <!--  Controls Card  -->
            <Border
                Padding="16"
                Margin="0,0,0,12"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Controls" />
                    <TextBlock
                        Margin="0,4,0,12"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Load and view items from the loot window." />
                    <WrapPanel>
                        <Button
                            Width="140"
                            Margin="0,0,12,0"
                            Command="{Binding LoadItemsCommand}"
                            Content="Load Items"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="100"
                            Command="{Binding ClearCommand}"
                            Content="Clear" />
                        <TextBlock
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource App.SubtleForegroundBrush}">
                            <Run Text="Items:" />
                            <Run
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding ItemCount, Mode=OneWay}" />
                        </TextBlock>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!--  Items Grid  -->
            <Border
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <DataGrid
                    Margin="5"
                    AutoGenerateColumns="False"
                    Background="{DynamicResource App.BackgroundBrush}"
                    BorderThickness="0"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserSortColumns="True"
                    Foreground="{DynamicResource App.ForegroundBrush}"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Items}"
                    RowBackground="{DynamicResource App.CardBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="50"
                            Binding="{Binding Slot}"
                            Header="Slot" />
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding Id}"
                            Header="ID" />
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="150"
                            Binding="{Binding Name}"
                            Header="Name" />
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding Stack}"
                            Header="Stack" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding Category}"
                            Header="Category" />
                        <DataGridTemplateColumn
                            Width="170"
                            Header="Flags">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemFlagBadgesTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
