<Window x:Class="MESharp.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick Color"
        Width="360" Height="260"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.CardBrush}"
        Foreground="{DynamicResource App.ForegroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource App.BackgroundBrush}" CornerRadius="6" Padding="8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="#" VerticalAlignment="Center"/>
                <TextBox x:Name="HexText" Width="120" Margin="4,0,0,0"/>
                <Button Content="Apply" Margin="8,0,0,0" Click="OnApplyHex"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Red"/>
                <Slider x:Name="Red" Minimum="0" Maximum="255" ValueChanged="OnSliderChanged"/>
                <TextBlock Text="Green" Margin="0,8,0,0"/>
                <Slider x:Name="Green" Minimum="0" Maximum="255" ValueChanged="OnSliderChanged"/>
                <TextBlock Text="Blue" Margin="0,8,0,0"/>
                <Slider x:Name="Blue" Minimum="0" Maximum="255" ValueChanged="OnSliderChanged"/>
            </StackPanel>
            <Border Grid.Column="1" Margin="12,0,0,0" Background="{DynamicResource App.BackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="1">
                <Grid>
                    <Border x:Name="Preview" Background="Black" CornerRadius="6"/>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Preview"/>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="80" Margin="0,0,8,0" Content="OK" IsDefault="True" Click="OnOk"/>
            <Button Width="80" Content="Cancel" IsCancel="True"/>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>

