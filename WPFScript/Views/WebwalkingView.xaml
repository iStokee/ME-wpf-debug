<UserControl
    x:Class="MESharp.Views.WebwalkingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:WebwalkingViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1100">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="{DynamicResource App.CardBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource App.SubtleForegroundBrush}" />
        </Style>

        <Style x:Key="ListPanel" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource App.BackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style x:Key="RouteListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="{DynamicResource App.BackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="0,0,0,8" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <iconPacks:PackIconMaterial Width="20" Height="20" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}" Kind="MapSearch" />
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Webwalking Tooling" />
                            <TextBlock Style="{StaticResource HintText}" Text="Route planning and execution surface. Use this tab to build reusable travel chains; use Navigation for low-level API tests." />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <Button
                            Width="28"
                            Height="28"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Command="{Binding ShowHelpCommand}"
                            Content="?"
                            Style="{StaticResource SecondaryCommandButton}"
                            ToolTip="Open full Webwalking guide" />
                        <TextBlock Margin="0,0,14,0" VerticalAlignment="Center" FontFamily="Consolas" Style="{StaticResource HintText}" Text="{Binding CurrentTile, StringFormat=Tile: {0}}" />
                        <TextBlock Margin="0,0,14,0" VerticalAlignment="Center" FontFamily="Consolas" Style="{StaticResource HintText}" Text="{Binding RunStatus}" />
                        <TextBlock VerticalAlignment="Center" FontFamily="Consolas" Style="{StaticResource HintText}" Text="{Binding LastStatus}" />
                    </StackPanel>
                </DockPanel>
            </Border>

                <Border Grid.Row="1" Margin="0,0,0,10" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="How To Use" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource HintText}" Text="1) Pick a route in the catalog or create a new one." />
                    <TextBlock Style="{StaticResource HintText}" Text="2) Build/edit waypoints in the middle column and save." />
                    <TextBlock Style="{StaticResource HintText}" Text="3) Use the right column to edit selected waypoint details and run routes." />
                    <TextBlock Style="{StaticResource HintText}" Text="Tip: transition waypoints are for ladders/gates/doors (supply object IDs when needed)." />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock FontWeight="SemiBold" Text="Step 1: Route Catalog" />
                                    <TextBlock Margin="0,2,0,6" Style="{StaticResource HintText}" Text="Search by route name, category, or tags." />
                                </StackPanel>
                                <Button
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Content="?"
                                    ToolTip="Pick a route from library, then load it into editor. Use New Draft to start from scratch."
                                    Style="{StaticResource SecondaryCommandButton}" />
                            </DockPanel>
                            <TextBox Padding="6" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <ListBox
                            Grid.Row="1"
                            Style="{StaticResource ListPanel}"
                            ItemContainerStyle="{StaticResource RouteListItemStyle}"
                            ItemsSource="{Binding FilteredRoutes}"
                            SelectedItem="{Binding SelectedRoute}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource HintText}" Text="{Binding Category}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                            <Button Margin="0,0,6,0" Command="{Binding NewRouteCommand}" Style="{StaticResource SecondaryCommandButton}" Content="New Draft" ToolTip="Start a blank route draft" />
                            <Button Margin="0,0,6,0" Command="{Binding LoadRouteCommand}" Style="{StaticResource SecondaryCommandButton}" Content="Load To Editor" ToolTip="Load selected route into editor" />
                            <Button Margin="0,0,6,0" Command="{Binding DuplicateRouteCommand}" Style="{StaticResource SecondaryCommandButton}" Content="Clone" ToolTip="Create a copy of selected route" />
                            <Button Margin="0,0,6,0" Command="{Binding DeleteRouteCommand}" Style="{StaticResource SecondaryCommandButton}" Content="Delete" ToolTip="Delete selected route" />
                            <Button Margin="0,0,6,0" Command="{Binding MoveRouteUpCommand}" Style="{StaticResource SecondaryCommandButton}" Content="Up" ToolTip="Move selected route up" />
                            <Button Margin="0,0,6,0" Command="{Binding MoveRouteDownCommand}" Style="{StaticResource SecondaryCommandButton}" Content="Down" ToolTip="Move selected route down" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock FontWeight="SemiBold" Text="Step 2: Route Setup" />
                                <TextBlock Margin="0,2,0,6" Style="{StaticResource HintText}" Text="Define route metadata. Use stable names for scripts (e.g. core.wildy_wall.to_green_dragons)." />
                            </StackPanel>
                            <Button
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Content="?"
                                ToolTip="Name is the primary script reference. Category and tags help scripts discover routes dynamically."
                                Style="{StaticResource SecondaryCommandButton}" />
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Margin="0,0,8,0" Padding="6" Text="{Binding RouteName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Route name/id used by scripts (keep stable after adoption)" />
                            <TextBox Grid.Column="1" Padding="6" Text="{Binding RouteCategory, UpdateSourceTrigger=PropertyChanged}" ToolTip="Grouping label like core/custom/slayer" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Margin="0,0,8,0" Padding="6" Text="{Binding RouteDescription, UpdateSourceTrigger=PropertyChanged}" ToolTip="Human-readable description" />
                            <TextBox Grid.Column="1" Padding="6" Text="{Binding RouteTags, UpdateSourceTrigger=PropertyChanged}" ToolTip="Comma-separated tags for filtering" />
                        </Grid>

                        <ListBox
                            Grid.Row="3"
                            Style="{StaticResource ListPanel}"
                            ItemContainerStyle="{StaticResource RouteListItemStyle}"
                            ItemsSource="{Binding CurrentRoute}"
                            SelectedItem="{Binding SelectedWaypoint}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding}" />
                                        <TextBlock Style="{StaticResource HintText}" Text="Select a waypoint to edit details in Step 3." />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="4" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource HintText}" Text="Waypoint actions: current/target adds use your configured editor defaults." />
                            <WrapPanel Margin="0,4,0,0">
                                <Button Margin="0,0,6,0" Command="{Binding AddCurrentWaypointCommand}" Style="{StaticResource SecondaryCommandButton}" Content="Add Current Tile" />
                                <Button Margin="0,0,6,0" Command="{Binding AddTargetWaypointCommand}" Style="{StaticResource SecondaryCommandButton}" Content="Add Target Tile" />
                                <Button Margin="0,0,6,0" Command="{Binding InsertWaypointAboveCommand}" Style="{StaticResource SecondaryCommandButton}" Content="Insert Above" />
                                <Button Margin="0,0,6,0" Command="{Binding InsertWaypointBelowCommand}" Style="{StaticResource SecondaryCommandButton}" Content="Insert Below" />
                                <Button Margin="0,0,6,0" Command="{Binding MoveWaypointUpCommand}" Style="{StaticResource SecondaryCommandButton}" Content="Up" />
                                <Button Margin="0,0,6,0" Command="{Binding MoveWaypointDownCommand}" Style="{StaticResource SecondaryCommandButton}" Content="Down" />
                                <Button Margin="0,0,6,0" Command="{Binding RemoveWaypointCommand}" Style="{StaticResource SecondaryCommandButton}" Content="Remove WP" />
                                <Button Margin="0,0,6,0" Command="{Binding ClearCurrentRouteCommand}" Style="{StaticResource SecondaryCommandButton}" Content="Clear Draft" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <TextBlock FontWeight="SemiBold" Text="Step 3: Waypoint + Execution" />
                            <Button
                                Width="24"
                                Height="24"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Content="?"
                                ToolTip="Edit selected waypoint here. Save route before running so scripts consume the latest metadata."
                                Style="{StaticResource SecondaryCommandButton}" />
                        </DockPanel>
                        <TextBlock Grid.Row="1" Margin="0,2,0,8" Style="{StaticResource HintText}" Text="Edit selected waypoint, then save route and run current or selected route." />

                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Margin="0,0,6,0" Padding="6" Text="{Binding WaypointX}" ToolTip="Waypoint X" />
                            <TextBox Grid.Column="1" Margin="0,0,6,0" Padding="6" Text="{Binding WaypointY}" ToolTip="Waypoint Y" />
                            <TextBox Grid.Column="2" Padding="6" Text="{Binding WaypointZ}" ToolTip="Waypoint Z/plane" />
                        </Grid>

                        <TextBox Grid.Row="3" Margin="0,0,0,8" Padding="6" Text="{Binding WaypointLabel, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional waypoint label" />

                        <Grid Grid.Row="4" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Margin="0,0,6,0" Padding="6" Text="{Binding WaypointAreaRadius}" ToolTip="Arrival area radius" />
                            <TextBox Grid.Column="1" Margin="0,0,6,0" Padding="6" Text="{Binding WaypointArrivalDistance}" ToolTip="Arrival tile distance" />
                            <TextBox Grid.Column="2" Padding="6" Text="{Binding WaypointTimeoutMs}" ToolTip="Waypoint timeout ms" />
                        </Grid>

                        <Grid Grid.Row="5" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Margin="0,0,6,0" Padding="6" Text="{Binding WaypointJitterTiles}" ToolTip="Click jitter tiles" />
                            <TextBox Grid.Column="1" Padding="6" Text="{Binding WaypointTransitionIds, UpdateSourceTrigger=PropertyChanged}" ToolTip="Transition object IDs (comma-separated)" />
                        </Grid>

                        <StackPanel Grid.Row="6">
                            <CheckBox Content="Chain while moving" IsChecked="{Binding WaypointChainWhileMoving}" />
                            <CheckBox Margin="0,4,0,0" Content="Transition waypoint" IsChecked="{Binding WaypointIsTransition}" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,6,0" Padding="6" Text="{Binding TargetX, UpdateSourceTrigger=PropertyChanged}" ToolTip="Target X for Add Target" />
                                <TextBox Grid.Column="1" Margin="0,0,6,0" Padding="6" Text="{Binding TargetY, UpdateSourceTrigger=PropertyChanged}" ToolTip="Target Y for Add Target" />
                                <TextBox Grid.Column="2" Padding="6" Text="{Binding TargetZ, UpdateSourceTrigger=PropertyChanged}" ToolTip="Target Z for Add Target" />
                            </Grid>

                            <WrapPanel Margin="0,8,0,0">
                                <Button Margin="0,0,6,0" Command="{Binding ApplyWaypointEditsCommand}" Style="{StaticResource SecondaryCommandButton}" Content="Apply WP Changes" />
                                <Button Margin="0,0,6,0" Command="{Binding SaveRouteCommand}" Style="{StaticResource PrimaryCommandButton}" Content="Save Route" />
                                <Button Margin="0,0,6,0" Command="{Binding RenameRouteCommand}" Style="{StaticResource SecondaryCommandButton}" Content="Rename Route" />
                            </WrapPanel>

                            <WrapPanel Margin="0,8,0,0">
                                <Button Margin="0,0,6,0" Command="{Binding RunCurrentRouteCommand}" Style="{StaticResource PrimaryCommandButton}" Content="Run Draft" />
                                <Button Margin="0,0,6,0" Command="{Binding RunSelectedRouteCommand}" Style="{StaticResource SecondaryCommandButton}" Content="Run Catalog Route" />
                                <Button Margin="0,0,6,0" Command="{Binding StopRouteCommand}" Style="{StaticResource SecondaryCommandButton}" Content="Stop" />
                            </WrapPanel>

                            <TextBlock Margin="0,8,0,4" FontWeight="SemiBold" Text="Execution Log" />
                            <ListBox Style="{StaticResource ListPanel}" ItemContainerStyle="{StaticResource RouteListItemStyle}" ItemsSource="{Binding ActivityLog}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
