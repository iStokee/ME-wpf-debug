<UserControl
    x:Class="MESharp.Views.InterfacesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:MESharp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:controls="clr-namespace:MESharp.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:InterfacesViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <controls:SectionHeader
            Grid.Row="0"
            Margin="0,0,0,10"
            Title="Interface Scanner"
            Description="Scan and visualize RuneScape 3 interface components."
            IconKind="ViewDashboardOutline"
            HelpCommand="{Binding DataContext.ShowApiDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

        <!--  Controls  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="10"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,10,8"
                    Padding="15,5"
                    Command="{Binding LoadInterfacesCommand}"
                    Style="{StaticResource AccentButton}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="Refresh" />
                        <TextBlock Text="Load Interfaces" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,10,8"
                    Padding="15,5"
                    Command="{Binding ClearCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="Close" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="10,0,10,8"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <CheckBox
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        Content="Freeze"
                        IsChecked="{Binding FreezeRefresh}" />
                    <CheckBox
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        Content="Auto Refresh"
                        IsChecked="{Binding AutoRefresh}" />
                    <CheckBox
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        Content="Include Hidden"
                        IsChecked="{Binding IncludeHidden}" />
                    <CheckBox
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        Content="Text Only"
                        IsChecked="{Binding TextOnly}" />
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        Text="Root ID:" />
                    <TextBox
                        Width="80"
                        Margin="0,0,10,0"
                        VerticalContentAlignment="Center"
                        Text="{Binding RootIdText, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Content="Focus Root"
                        IsChecked="{Binding FocusRoot}" />
                    <Button
                        Margin="0,0,12,0"
                        Padding="10,3"
                        Command="{Binding UseSelectedRootCommand}">
                        <TextBlock Text="Use Selected Root" />
                    </Button>
                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        Text="Index filters:" />
                    <CheckBox
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Content="[1]"
                        IsChecked="{Binding FilterIndex1}" />
                    <CheckBox
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Content="[2]"
                        IsChecked="{Binding FilterIndex2}" />
                    <CheckBox
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Content="[3]"
                        IsChecked="{Binding FilterIndex3}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Interface Tree  -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,10"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <TreeView
                        Margin="5"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding AllInterfaces}"
                        SelectedItemChanged="OnSelectedInterfaceChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="False" />
                                <Setter Property="Padding" Value="2" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Margin="2">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{Binding DisplayText}" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                        Text="{Binding CoordinatesText}" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Text="{Binding Text}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasText, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Text="{Binding ItemText}"
                                        Visibility="{Binding HasItem, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                        Text="{Binding MemLocText}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>

                <Border
                    Grid.Column="1"
                    Margin="0"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="12,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Selection Details" />
                            <TextBlock
                                Margin="0,4,0,10"
                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                Text="{Binding SelectedInterfaceLabel}" />

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Ids" />
                            <TextBlock
                                Margin="0,2,0,8"
                                Text="{Binding SelectedInterface.Id1, StringFormat='Id1: {0}'}" />
                            <TextBlock
                                Margin="0,0,0,8"
                                Text="{Binding SelectedInterface.Id2, StringFormat='Id2: {0}'}" />
                            <TextBlock
                                Margin="0,0,0,8"
                                Text="{Binding SelectedInterface.Id3, StringFormat='Id3: {0}'}" />

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Position" />
                            <TextBlock
                                Margin="0,2,0,8"
                                Text="{Binding SelectedInterface.X, StringFormat='X: {0}'}" />
                            <TextBlock
                                Margin="0,0,0,8"
                                Text="{Binding SelectedInterface.Y, StringFormat='Y: {0}'}" />
                            <TextBlock
                                Margin="0,0,0,8"
                                Text="{Binding SelectedInterface.Width, StringFormat='W: {0}'}" />
                            <TextBlock
                                Margin="0,0,0,8"
                                Text="{Binding SelectedInterface.Height, StringFormat='H: {0}'}" />
                            <TextBlock
                                Margin="0,0,0,8"
                                Text="{Binding SelectedInterface.BoxX, StringFormat='Box X: {0}'}" />
                            <TextBlock
                                Margin="0,0,0,8"
                                Text="{Binding SelectedInterface.BoxY, StringFormat='Box Y: {0}'}" />
                            <TextBlock
                                Margin="0,0,0,8"
                                Text="{Binding SelectedInterface.ScrollY, StringFormat='Scroll: {0}'}" />

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Memory" />
                            <TextBlock
                                Margin="0,2,0,8"
                                Text="{Binding SelectedInterface.MemLoc, StringFormat='Mem: 0x{0:X}'}" />
                            <TextBlock
                                Margin="0,0,0,8"
                                Text="{Binding SelectedInterface.MemLocTop, StringFormat='Top: 0x{0:X}'}" />

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Text" />
                            <TextBlock
                                Margin="0,2,0,6"
                                Text="{Binding SelectedInterface.TextItem}" />
                            <TextBlock
                                Margin="0,0,0,8"
                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                Text="{Binding SelectedInterface.TextIds}" />

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Item" />
                            <TextBlock
                                Margin="0,2,0,6"
                                Text="{Binding SelectedInterface.ItemId, StringFormat='Item: {0}'}" />
                            <TextBlock
                                Margin="0,0,0,8"
                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                Text="{Binding SelectedInterface.ItemStack, StringFormat='Stack: {0}'}" />

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Paths" />
                            <TextBlock
                                Margin="0,2,0,6"
                                Text="{Binding SelectedInterface.FullPath}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,0,0,8"
                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                Text="{Binding SelectedInterface.FullIdPath}"
                                TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Margin="0,0,8,0"
                                    Padding="10,3"
                                    Command="{Binding RefreshSelectedCommand}">
                                    <TextBlock Text="Refresh Selected" />
                                </Button>
                                <Button
                                    Padding="10,3"
                                    Command="{Binding UseSelectedRootCommand}">
                                    <TextBlock Text="Use as Root" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!--  Status Bar  -->
        <Border
            Grid.Row="3"
            Padding="10"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,20,0"
                    Orientation="Horizontal">
                    <iconPacks:PackIconMaterial
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Kind="ViewList" />
                    <TextBlock VerticalAlignment="Center" Text="Interfaces: " />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Text="{Binding InterfaceCount, Mode=OneWay}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource App.SubtleForegroundBrush}"
                    Text="{Binding StatusMessage}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
