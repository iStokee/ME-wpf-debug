<UserControl
    x:Class="MESharp.Views.InterfacesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:MESharp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:InterfacesViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="10"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Interface Scanner" />
                    <TextBlock
                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                        Text="Debug tool to scan and visualize RuneScape 3 interface components"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Style="{StaticResource HeaderHelpButton}"
                    ToolTip="Open API docs"
                    Command="{Binding DataContext.ShowApiDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <iconPacks:PackIconMaterial
                        Width="18"
                        Height="18"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Kind="HelpCircleOutline" />
                </Button>
            </Grid>
        </Border>

        <!--  Controls  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="10"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Padding="15,5"
                    Command="{Binding LoadInterfacesCommand}"
                    Style="{StaticResource AccentButton}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="Refresh" />
                        <TextBlock Text="Load Interfaces" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    Padding="15,5"
                    Command="{Binding ClearCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="Close" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>

                <StackPanel
                    Grid.Column="2"
                    Margin="10,0,10,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <CheckBox
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        Content="Freeze"
                        IsChecked="{Binding FreezeRefresh}" />
                    <CheckBox
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        Content="Auto Refresh"
                        IsChecked="{Binding AutoRefresh}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Interface Tree  -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,10"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TreeView
                    Margin="5"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding AllInterfaces}">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="False" />
                            <Setter Property="Padding" Value="2" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Margin="2">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Text="{Binding DisplayText}" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                    Text="{Binding CoordinatesText}" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Text="{Binding Text}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding HasText, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Text="{Binding ItemText}"
                                    Visibility="{Binding HasItem, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </ScrollViewer>
        </Border>

        <!--  Status Bar  -->
        <Border
            Grid.Row="3"
            Padding="10"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,20,0"
                    Orientation="Horizontal">
                    <iconPacks:PackIconMaterial
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Kind="ViewList" />
                    <TextBlock VerticalAlignment="Center" Text="Interfaces: " />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Text="{Binding InterfaceCount, Mode=OneWay}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource App.SubtleForegroundBrush}"
                    Text="{Binding StatusMessage}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
