<UserControl
    x:Class="MESharp.Views.InterfacesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:MESharp.Views.Behaviors"
    xmlns:controls="clr-namespace:MESharp.Views.Controls"
    xmlns:conv="clr-namespace:MESharp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:InterfacesViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <Style x:Key="InterfacePanelCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource App.CardBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style x:Key="InterfacePanelTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
            </Style>

            <Style x:Key="InterfacePanelSectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                <Setter Property="Margin" Value="0,8,0,4" />
            </Style>

            <Style x:Key="InterfaceKeyLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource App.SubtleForegroundBrush}" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <Style x:Key="InterfaceValueText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                <Setter Property="Margin" Value="12,0,0,0" />
            </Style>

            <Style
                x:Key="InterfacePanelButton"
                BasedOn="{StaticResource SecondaryCommandButton}"
                TargetType="Button">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="MinHeight" Value="34" />
            </Style>

            <Style x:Key="InterfaceTreeItemStyle" TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="False" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Margin" Value="2,1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource App.CardBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        Margin="5"
        behaviors:PanelLayoutBehavior.PageKey="interfaces-view"
        behaviors:PanelLayoutBehavior.ColumnKey="left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <controls:SectionHeader
            Title="Interface Scanner"
            Grid.Row="0"
            Margin="0,0,0,10"
            Description="Scan and visualize RuneScape 3 interface components."
            HelpCommand="{Binding DataContext.ShowApiDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
            IconKind="ViewDashboardOutline" />

        <!--  Controls  -->
        <Border
            Grid.Row="1"
            behaviors:PanelLayoutBehavior.PanelKey="controls"
            Margin="0,0,0,10"
            Padding="10"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="5">
            <Expander Header="Controls" IsExpanded="True">
                <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,10,8"
                    Padding="15,5"
                    Command="{Binding LoadInterfacesCommand}"
                    Style="{StaticResource AccentButton}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="Refresh" />
                        <TextBlock Text="Load Interfaces" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,10,8"
                    Padding="15,5"
                    Command="{Binding ClearCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="Close" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="10,0,10,8"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <CheckBox
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        Content="Freeze"
                        IsChecked="{Binding FreezeRefresh}" />
                    <CheckBox
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        Content="Auto Refresh"
                        IsChecked="{Binding AutoRefresh}" />
                    <CheckBox
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        Content="Include Hidden"
                        IsChecked="{Binding IncludeHidden}" />
                    <CheckBox
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        Content="Text Only"
                        IsChecked="{Binding TextOnly}" />
                    <CheckBox
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Content="Highlight Selection"
                        IsChecked="{Binding HighlightSelection}" />
                    <CheckBox
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Content="Keep Highlight"
                        IsChecked="{Binding KeepHighlight}" />
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Text="Highlight ms:" />
                    <TextBox
                        Width="70"
                        VerticalContentAlignment="Center"
                        Text="{Binding HighlightDurationMs, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Text="Root ID:" />
                    <TextBox
                        Width="80"
                        Margin="0,0,10,0"
                        VerticalContentAlignment="Center"
                        Text="{Binding RootIdText, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Content="Focus Root"
                        IsChecked="{Binding FocusRoot}" />
                    <Button
                        Margin="0,0,12,0"
                        Padding="10,3"
                        Command="{Binding UseSelectedRootCommand}">
                        <TextBlock Text="Use Selected Root" />
                    </Button>
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Text="Index filters:" />
                    <CheckBox
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Content="[1]"
                        IsChecked="{Binding FilterIndex1}" />
                    <CheckBox
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Content="[2]"
                        IsChecked="{Binding FilterIndex2}" />
                    <CheckBox
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Content="[3]"
                        IsChecked="{Binding FilterIndex3}" />
                </StackPanel>
                </Grid>
            </Expander>
        </Border>

        <!--  Status / Info  -->
        <Border
            Grid.Row="2"
            behaviors:PanelLayoutBehavior.PanelKey="status-info"
            Margin="0,0,0,10"
            Padding="10"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="5">
            <Expander Header="Status / Info" IsExpanded="True">
                <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,20,0"
                    Orientation="Horizontal">
                    <iconPacks:PackIconMaterial
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Kind="ViewList" />
                    <TextBlock VerticalAlignment="Center" Text="Interfaces: " />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Text="{Binding InterfaceCount, Mode=OneWay}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource App.SubtleForegroundBrush}"
                    Text="{Binding StatusMessage}" />
                </Grid>
            </Expander>
        </Border>

        <!--  Interface Tree  -->
        <Border
            Grid.Row="3"
            behaviors:PanelLayoutBehavior.PanelKey="interface-tree-details"
            Margin="0,0,0,10"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="5">
            <Expander Header="Interface Tree &amp; Details" IsExpanded="True">
                <Grid
                    Margin="0,10,0,0"
                    behaviors:GridColumnLayoutBehavior.LayoutKey="interfaces-view-tree-columns"
                    behaviors:GridColumnLayoutBehavior.ColumnIndexes="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="1.2*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Margin="10,10,6,10"
                    Background="{DynamicResource App.BackgroundBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Border
                        Margin="8"
                        Background="{DynamicResource App.CardBrush}"
                        BorderBrush="{DynamicResource App.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <TreeView
                                Margin="4"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource InterfaceTreeItemStyle}"
                                ItemsSource="{Binding AllInterfaces}"
                                SelectedItemChanged="OnSelectedInterfaceChanged">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Margin="2">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{Binding DisplayText}" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                                Text="{Binding CoordinatesText}" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                Text="{Binding Text}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding HasText, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                Text="{Binding ItemText}"
                                                Visibility="{Binding HasItem, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                                Text="{Binding MemLocText}" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </ScrollViewer>
                    </Border>
                </Border>

                <GridSplitter
                    Grid.Column="1"
                    Width="6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource App.BorderBrush}"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Columns" />

                <Border
                    Grid.Column="2"
                    Margin="6,10,10,10"
                    Background="{DynamicResource App.BackgroundBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <Border Style="{StaticResource InterfacePanelCard}">
                                <StackPanel>
                                    <DockPanel>
                                        <iconPacks:PackIconMaterial
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource PrimaryBrush}"
                                            Kind="InformationOutline" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource InterfacePanelTitle}"
                                            Text="Selection Details" />
                                    </DockPanel>
                                    <TextBlock
                                        Margin="0,4,0,8"
                                        FontSize="11"
                                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                        Text="{Binding SelectedInterfaceLabel}" />

                                    <TextBlock Style="{StaticResource InterfacePanelSectionTitle}" Text="Identity" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Id1" />
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.Id1}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Id2" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.Id2}" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Id3" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.Id3}" />

                                        <TextBlock
                                            Grid.Row="3"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="X" />
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.X}" />
                                        <TextBlock
                                            Grid.Row="4"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Y" />
                                        <TextBlock
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.Y}" />
                                        <TextBlock
                                            Grid.Row="5"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="W" />
                                        <TextBlock
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.Width}" />
                                        <TextBlock
                                            Grid.Row="6"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="H" />
                                        <TextBlock
                                            Grid.Row="6"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.Height}" />
                                        <TextBlock
                                            Grid.Row="7"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Box X" />
                                        <TextBlock
                                            Grid.Row="7"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.BoxX}" />
                                        <TextBlock
                                            Grid.Row="8"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Box Y" />
                                        <TextBlock
                                            Grid.Row="8"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.BoxY}" />
                                        <TextBlock
                                            Grid.Row="9"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Scroll" />
                                        <TextBlock
                                            Grid.Row="9"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.ScrollY}" />
                                        <TextBlock
                                            Grid.Row="10"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Mem" />
                                        <TextBlock
                                            Grid.Row="10"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.MemLoc, StringFormat=0x{0:X}}" />
                                        <TextBlock
                                            Grid.Row="11"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Top" />
                                        <TextBlock
                                            Grid.Row="11"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.MemLocTop, StringFormat=0x{0:X}}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InterfacePanelCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource InterfacePanelSectionTitle}" Text="Text" />
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{Binding SelectedInterfaceTextItem}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                        Text="{Binding SelectedInterface.TextIds}"
                                        TextWrapping="Wrap" />

                                    <TextBlock Style="{StaticResource InterfacePanelSectionTitle}" Text="Item" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Item" />
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.ItemId}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Style="{StaticResource InterfaceKeyLabel}"
                                            Text="Stack" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{StaticResource InterfaceValueText}"
                                            Text="{Binding SelectedInterface.ItemStack}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InterfacePanelCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource InterfacePanelSectionTitle}" Text="Paths" />
                                    <TextBlock
                                        Style="{StaticResource InterfaceKeyLabel}"
                                        Text="Memory address" />
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        Text="{Binding SelectedInterface.FullPath}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource InterfaceKeyLabel}"
                                        Text="Interface layers" />
                                    <TextBlock
                                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                        Text="{Binding SelectedInterface.FullIdPath}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InterfacePanelCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource InterfacePanelSectionTitle}" Text="Actions" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,8,8"
                                            Command="{Binding RefreshSelectedCommand}"
                                            Style="{StaticResource InterfacePanelButton}">
                                            <TextBlock Text="Refresh Selected" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="0,0,0,8"
                                            Command="{Binding UseSelectedRootCommand}"
                                            Style="{StaticResource InterfacePanelButton}">
                                            <TextBlock Text="Use as Root" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,0,8,0"
                                            Command="{Binding HighlightSelectedCommand}"
                                            Style="{StaticResource InterfacePanelButton}">
                                            <TextBlock Text="Highlight Selected" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Command="{Binding ClearHighlightCommand}"
                                            Style="{StaticResource InterfacePanelButton}">
                                            <TextBlock Text="Clear Highlight" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0" Style="{StaticResource InterfacePanelCard}">
                                <StackPanel>
                                    <DockPanel>
                                        <iconPacks:PackIconMaterial
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource PrimaryBrush}"
                                            Kind="FileSend" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource InterfacePanelTitle}"
                                            Text="Overrides" />
                                    </DockPanel>
                                    <TextBlock
                                        Margin="0,4,0,6"
                                        FontSize="11"
                                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                        Text="Save friendly keys for interface IDs and reload them later." />
                                    <TextBlock
                                        Margin="0,4,0,8"
                                        FontSize="11"
                                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                        Text="{Binding OverridesPath}"
                                        TextWrapping="Wrap" />

                                    <TextBlock Style="{StaticResource InterfaceKeyLabel}" Text="New key" />
                                    <TextBox Margin="0,4,0,6" Text="{Binding NewOverrideKey, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Margin="0,0,0,10"
                                        Command="{Binding CaptureOverrideCommand}"
                                        Style="{StaticResource InterfacePanelButton}"
                                        ToolTip="Save the selected interface as the key above.">
                                        <TextBlock Text="Capture Selected" />
                                    </Button>

                                    <ListBox
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemsSource="{Binding Overrides}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,0,6"
                                                    Padding="6"
                                                    Background="{DynamicResource App.BackgroundBrush}"
                                                    BorderBrush="{DynamicResource App.BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Text="{Binding Display}"
                                                            TextWrapping="Wrap" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            Command="{Binding DataContext.RemoveOverrideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource InterfacePanelButton}"
                                                            ToolTip="Remove this override from the list.">
                                                            <TextBlock Text="Remove" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <WrapPanel>
                                        <Button
                                            Margin="0,0,8,0"
                                            Command="{Binding LoadOverridesCommand}"
                                            Style="{StaticResource InterfacePanelButton}"
                                            ToolTip="Load overrides from the JSON file and refresh the list.">
                                            <TextBlock Text="Load JSON" />
                                        </Button>
                                        <Button
                                            Command="{Binding ExportOverridesCommand}"
                                            Style="{StaticResource InterfacePanelButton}"
                                            ToolTip="Write the current list to the JSON file.">
                                            <TextBlock Text="Export JSON" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                </Grid>
            </Expander>
        </Border>
    </Grid>
</UserControl>
