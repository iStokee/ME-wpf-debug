<UserControl
    x:Class="MESharp.Views.VarbitView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:MESharp.ViewModels"
    Background="{DynamicResource App.BackgroundBrush}"
    Foreground="{DynamicResource App.ForegroundBrush}"
    d:DataContext="{d:DesignInstance viewModels:VarbitViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="24">

            <!--  Header  -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial
                        Width="24"
                        Height="24"
                        Margin="0,0,8,0"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Kind="Numeric" />
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Varbit Reader" />
                </StackPanel>
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource HeaderHelpButton}"
                        ToolTip="Open API docs"
                        Command="{Binding DataContext.ShowApiDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <iconPacks:PackIconMaterial
                            Width="18"
                            Height="18"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Kind="HelpCircleOutline" />
                    </Button>
            </Grid>

            <!--  Varbit lookup card  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Lookup" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Enter a varbit ID to read its current value from the active client." />

                    <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial
                            Width="20"
                            Height="20"
                            Margin="0,0,8,0"
                            Foreground="{DynamicResource App.SubtleForegroundBrush}"
                            Kind="Numeric" />
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Varbit ID:" />
                        <TextBox
                            Width="160"
                            Margin="0,0,12,0"
                            Text="{Binding VarbitId, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Width="110"
                            Height="32"
                            Command="{Binding GetVarbitCommand}"
                            Content="Get Value"
                            Style="{StaticResource AccentButton}" />
                    </WrapPanel>

                    <Separator Margin="0,16,0,16" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="Result:" />
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Text="{Binding VarbitValue}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="{Binding Status}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
