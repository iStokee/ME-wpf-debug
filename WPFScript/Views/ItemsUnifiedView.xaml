<UserControl
    x:Class="MESharp.Views.ItemsUnifiedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:MESharp.Views.Behaviors"
    xmlns:controls="clr-namespace:MESharp.Views.Controls"
    xmlns:conv="clr-namespace:MESharp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ItemsUnifiedViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!--  Main Content Area  -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header with integrated status  -->
            <controls:SectionHeader
                Title="Item Containers"
                Grid.Row="0"
                Margin="0,0,0,10"
                Description="Select a container type and use the side panel for container-specific operations."
                HelpCommand="{Binding DataContext.ShowApiDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                IconKind="PackageVariant">
                <controls:SectionHeader.AdditionalContent>
                    <Border
                        Padding="8,6"
                        Background="{DynamicResource App.BackgroundBrush}"
                        BorderBrush="{DynamicResource App.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                Margin="0,0,15,0"
                                Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Kind="ViewList" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Text="Items: " />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Text="{Binding ItemCount, Mode=OneWay}" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                Text="{Binding StatusMessage}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </controls:SectionHeader.AdditionalContent>
            </controls:SectionHeader>

            <!--  Container Selection and Actions  -->
            <Border
                Grid.Row="1"
                Margin="0,0,0,10"
                Padding="10"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="5">
                <Expander Header="Container Selection And Actions" IsExpanded="True">
                    <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Container:" />

                    <ComboBox
                        Grid.Column="1"
                        Width="180"
                        Margin="0,0,15,0"
                        ItemContainerStyle="{StaticResource AppComboBoxItem}"
                        ItemsSource="{Binding AvailableContainers}"
                        SelectedItem="{Binding SelectedContainer}"
                        Style="{StaticResource AppComboBox}" />

                    <CheckBox
                        Grid.Column="2"
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"
                        Content="Include Coordinates"
                        IsChecked="{Binding IncludeCoordinates}" />

                    <Button
                        Grid.Column="3"
                        Margin="0,0,10,0"
                        Padding="15,5"
                        Command="{Binding LoadItemsCommand}"
                        Style="{StaticResource AccentButton}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Kind="Refresh" />
                            <TextBlock Text="Load Items" />
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Column="4"
                        Padding="15,5"
                        Command="{Binding ClearCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Kind="Close" />
                            <TextBlock Text="Clear" />
                        </StackPanel>
                    </Button>
                    </Grid>
                </Expander>
            </Border>

            <!--  Items Table  -->
            <Border
                Grid.Row="2"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="5">
                <Expander Header="Items Table" IsExpanded="True">
                    <DataGrid
                        Margin="5,10,5,5"
                        AutoGenerateColumns="False"
                        Background="{DynamicResource App.BackgroundBrush}"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserSortColumns="True"
                        Foreground="{DynamicResource App.ForegroundBrush}"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Items}"
                        RowBackground="{DynamicResource App.CardBrush}"
                        SelectedItem="{Binding SelectedItem}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="50"
                                Binding="{Binding Slot}"
                                Header="Slot" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Id}"
                                Header="ID" />
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="150"
                                Binding="{Binding Name}"
                                Header="Name" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Stack}"
                                Header="Stack" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Category}"
                                Header="Category" />
                            <DataGridTemplateColumn Width="170" Header="Flags">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemFlagBadgesTemplate}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
            </Border>
        </Grid>

        <!--  Toggle Button  -->
        <!--<ToggleButton
            Grid.Column="1"
            Width="24"
            Height="60"
            Margin="5,0,0,0"
            VerticalAlignment="Top"
            IsChecked="{Binding IsSidePanelCollapsed, Mode=TwoWay}"
            Style="{StaticResource {x:Type ToggleButton}}"
            ToolTip="Toggle Side Panel">
            <iconPacks:PackIconMaterial Kind="ChevronLeft">
                <iconPacks:PackIconMaterial.Style>
                    <Style TargetType="iconPacks:PackIconMaterial">
                        <Setter Property="Kind" Value="ChevronLeft" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidePanelCollapsed}" Value="True">
                                <Setter Property="Kind" Value="ChevronRight" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </iconPacks:PackIconMaterial.Style>
            </iconPacks:PackIconMaterial>
        </ToggleButton>-->

        <!--  Column Splitter  -->
        <GridSplitter
            Grid.Column="1"
            Width="6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{DynamicResource App.BorderBrush}"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns" />

        <!--  Side Panel  -->
        <Border
            Grid.Column="2"
            MinWidth="260"
            Margin="5,0,0,0"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="5">
            <ScrollViewer
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" HorizontalAlignment="Stretch">
                    <Expander Header="Item Actions" IsExpanded="True">
                        <StackPanel Margin="0,10,0,0">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Item Actions" />
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="11"
                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                        Text="{Binding SelectedContainer, StringFormat=Active container: {0}}" />

                    <!--  Inventory-specific Controls  -->
                    <Border
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="{DynamicResource App.BackgroundBrush}"
                        CornerRadius="5"
                        Visibility="{Binding IsInventorySelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Inventory Status" />

                            <!--  Status Display  -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontSize="11"
                                    Text="Is Open:" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding InventoryIsOpen}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    Text="Is Full:" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding InventoryIsFull}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    Text="Is Empty:" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding InventoryIsEmpty}" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    Text="Item Selected:" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding InventoryItemSelected}" />

                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    Text="Free Slots:" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding InventoryFreeSlots}" />
                            </Grid>

                            <Separator Margin="0,5,0,10" />

                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Actions" />

                            <Button
                                Margin="0,0,0,5"
                                Padding="10,5"
                                Command="{Binding InventoryRefreshCommand}"
                                Content="Refresh Status" />

                            <!--  Item Actions (requires selection)  -->
                            <TextBlock
                                Margin="0,10,0,5"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Item Actions (select item):" />

                            <Button
                                Margin="0,0,0,5"
                                Padding="10,5"
                                Command="{Binding ItemEatCommand}"
                                Content="Eat Item" />

                            <Button
                                Margin="0,0,0,5"
                                Padding="10,5"
                                Command="{Binding ItemDropCommand}"
                                Content="Drop Item" />

                            <Button
                                Margin="0,0,0,5"
                                Padding="10,5"
                                Command="{Binding ItemUseCommand}"
                                Content="Use Item" />

                            <Button
                                Margin="0,0,0,5"
                                Padding="10,5"
                                Command="{Binding ItemEquipCommand}"
                                Content="Equip Item" />

                            <Button
                                Margin="0,0,0,5"
                                Padding="10,5"
                                Command="{Binding ItemNoteCommand}"
                                Content="Note Item" />

                            <!--  Use Item On Item (requires two selections)  -->
                            <Separator Margin="0,10,0,10" />
                            <TextBlock
                                Margin="0,0,0,5"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Use Item On Item:" />

                            <TextBlock
                                Margin="0,0,0,5"
                                FontSize="11"
                                Foreground="{DynamicResource App.MutedBrush}"
                                Text="Source item (from main list):"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="5,0,0,10"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding SelectedItem.Name, FallbackValue='(none selected)'}" />

                            <TextBlock
                                Margin="0,0,0,5"
                                FontSize="11"
                                Foreground="{DynamicResource App.MutedBrush}"
                                Text="Target item (select below):"
                                TextWrapping="Wrap" />
                            <ComboBox
                                Margin="0,0,0,5"
                                ItemsSource="{Binding Items}"
                                SelectedItem="{Binding TargetItem}"
                                Style="{StaticResource AppComboBox}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                            <Run Foreground="{DynamicResource App.MutedBrush}" Text="{Binding Stack, StringFormat=' (x{0})', Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button
                                Margin="0,0,0,5"
                                Padding="10,5"
                                Command="{Binding ItemUseOnItemCommand}"
                                Content="Use Item On Item"
                                Style="{StaticResource AccentButton}" />
                        </StackPanel>
                    </Border>

                    <!--  Bank-specific Controls  -->
                    <Border
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="{DynamicResource App.BackgroundBrush}"
                        CornerRadius="5"
                        Visibility="{Binding IsBankSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Resources>
                            <!-- Keep theme button visuals; add consistent spacing/alignment locally. -->
                            <Style
                                BasedOn="{StaticResource {x:Type Button}}"
                                TargetType="Button">
                                <Setter Property="Margin" Value="0,0,0,5" />
                                <Setter Property="Padding" Value="10,5" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                            <Style
                                x:Key="BankAccentButton"
                                BasedOn="{StaticResource {x:Type Button}}"
                                TargetType="Button">
                                <Setter Property="Margin" Value="0,0,0,5" />
                                <Setter Property="Padding" Value="10,5" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </Border.Resources>
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Bank" />
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="11"
                                Foreground="{DynamicResource App.MutedBrush}"
                                Text="All bank API actions are grouped below. Select a bank item to drive item actions."
                                TextWrapping="Wrap" />

                            <!--  Status Display  -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontSize="11"
                                    Text="Is Open:" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding BankIsOpen}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    Text="Note Mode:" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding BankNoteModeEnabled}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    Text="Qty Selected:" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding BankQuantitySelected}" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    Text="X Quantity:" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding BankXQuantity}" />
                            </Grid>

                            <TabControl
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource App.BackgroundBrush}"
                                BorderBrush="{DynamicResource App.BorderBrush}">
                                <TabItem Header="Basics">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="8">
                                            <UniformGrid Margin="0,0,0,8" Columns="2">
                                                <Button
                                                    Command="{Binding BankOpenCommand}"
                                                    Content="Open Bank"
                                                    />
                                                <Button
                                                    Command="{Binding BankLoadLastPresetCommand}"
                                                    Content="Load Last Preset"
                                                    />
                                                <Button
                                                    Command="{Binding BankCloseCommand}"
                                                    Content="Close Bank"
                                                    />
                                            </UniformGrid>

                                            <TextBlock
                                                Margin="0,0,0,6"
                                                FontWeight="SemiBold"
                                                Text="PIN" />
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    Grid.Column="0"
                                                    Margin="0,0,8,0"
                                                    Text="{Binding PinInput}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Command="{Binding BankEnterPinCommand}"
                                                    Content="Enter PIN"
                                                    />
                                            </Grid>

                                            <TextBlock
                                                Margin="0,0,0,6"
                                                FontWeight="SemiBold"
                                                Text="Deposit" />
                                            <UniformGrid Margin="0,0,0,8" Columns="2">
                                                <Button
                                                    Command="{Binding BankDepositAllCommand}"
                                                    Content="Deposit All"
                                                     />
                                                <Button
                                                    Command="{Binding BankDepositInventoryCommand}"
                                                    Content="Deposit Inventory"
                                                    />
                                                <Button
                                                    Command="{Binding BankDepositEquipmentCommand}"
                                                    Content="Deposit Equipment"
                                                    />
                                                <Button
                                                    Command="{Binding BankDepositSummonCommand}"
                                                    Content="Deposit Summon"
                                                    />
                                                <Button
                                                    Command="{Binding BankDepositMoneyPouchCommand}"
                                                    Content="Deposit Money"
                                                    />
                                            </UniformGrid>

                                            <TextBlock
                                                Margin="0,0,0,4"
                                                FontSize="11"
                                                Text="Keep IDs (comma/space separated)" />
                                            <TextBox Margin="0,0,0,6" Text="{Binding BankKeepIds}" />
                                            <Button
                                                Command="{Binding BankDepositExceptIdsCommand}"
                                                Content="Deposit Except IDs"
                                                />

                                            <TextBlock
                                                Margin="0,0,0,4"
                                                FontSize="11"
                                                Text="Keep Names (comma/semicolon separated)" />
                                            <TextBox Margin="0,0,0,6" Text="{Binding BankKeepNames}" />
                                            <Button
                                                Command="{Binding BankDepositExceptNamesCommand}"
                                                Content="Deposit Except Names"
                                                />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem Header="Transfer">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="8">
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                FontWeight="SemiBold"
                                                Text="Tabs" />
                                            <UniformGrid Margin="0,0,0,8" Columns="2">
                                                <Button
                                                    Command="{Binding BankOpenInventoryTabCommand}"
                                                    Content="Inventory Tab"
                                                    />
                                                <Button
                                                    Command="{Binding BankOpenBoBTabCommand}"
                                                    Content="BoB Tab"
                                                    />
                                                <Button
                                                    Command="{Binding BankOpenEquipmentTabCommand}"
                                                    Content="Equipment Tab"
                                                    />
                                            </UniformGrid>

                                            <TextBlock
                                                Margin="0,0,0,6"
                                                FontWeight="SemiBold"
                                                Text="Transfer Page" />
                                            <UniformGrid Margin="0,0,0,8" Columns="2">
                                                <Button
                                                    Command="{Binding BankSetTransferTabCommand}"
                                                    Content="Transfer"
                                                    />
                                                <Button
                                                    Command="{Binding BankSetPresetTabCommand}"
                                                    Content="Preset"
                                                    />
                                            </UniformGrid>

                                            <TextBlock
                                                Margin="0,0,0,6"
                                                FontWeight="SemiBold"
                                                Text="Quantity" />
                                            <UniformGrid Margin="0,0,0,8" Columns="3">
                                                <Button
                                                    Command="{Binding BankSetQuantity1Command}"
                                                    Content="1"
                                                    />
                                                <Button
                                                    Command="{Binding BankSetQuantity5Command}"
                                                    Content="5"
                                                    />
                                                <Button
                                                    Command="{Binding BankSetQuantity10Command}"
                                                    Content="10"
                                                    />
                                                <Button
                                                    Command="{Binding BankSetQuantityXCommand}"
                                                    Content="X"
                                                    />
                                                <Button
                                                    Command="{Binding BankSetQuantityAllCommand}"
                                                    Content="All"
                                                    />
                                            </UniformGrid>

                                            <TextBlock
                                                Margin="0,0,0,4"
                                                FontSize="11"
                                                Text="Set X Quantity" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    Grid.Column="0"
                                                    Margin="0,0,8,0"
                                                    Text="{Binding XQuantityInput}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Command="{Binding BankSetXQuantityCommand}"
                                                    Content="Set X"
                                                    />
                                            </Grid>

                                            <Button
                                                Command="{Binding BankToggleNoteModeCommand}"
                                                Content="Toggle Note Mode"
                                                />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem Header="Items">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="8">
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                FontWeight="SemiBold"
                                                Text="Withdraw (Bank Items)" />
                                            <TextBlock FontSize="11" Text="Menu text (e.g., Withdraw-1, Withdraw-X)" />
                                            <TextBox Margin="0,4,0,6" Text="{Binding BankMenuText}" />
                                            <Button
                                                Command="{Binding BankWithdrawSelectedCommand}"
                                                Content="Withdraw Selected"
                                                />
                                            <TextBlock FontSize="11" Text="Withdraw by ID" />
                                            <TextBox Margin="0,4,0,6" Text="{Binding BankActionId}" />
                                            <Button
                                                Command="{Binding BankWithdrawByIdCommand}"
                                                Content="Withdraw ID"
                                                />
                                            <TextBlock FontSize="11" Text="Withdraw by Name" />
                                            <TextBox Margin="0,4,0,6" Text="{Binding BankActionName}" />
                                            <Button
                                                Command="{Binding BankWithdrawByNameCommand}"
                                                Content="Withdraw Name"
                                                />

                                            <Separator Margin="0,10,0,10" />

                                            <TextBlock
                                                Margin="0,0,0,6"
                                                FontWeight="SemiBold"
                                                Text="Deposit (Bank Inventory)" />
                                            <TextBlock FontSize="11" Text="Menu text (e.g., Deposit-1, Deposit-X)" />
                                            <TextBox Margin="0,4,0,6" Text="{Binding BankInvMenuText}" />
                                            <Button
                                                Command="{Binding BankInvDepositSelectedCommand}"
                                                Content="Deposit Selected"
                                                />
                                            <TextBlock FontSize="11" Text="Deposit by ID" />
                                            <TextBox Margin="0,4,0,6" Text="{Binding BankInvActionId}" />
                                            <Button
                                                Command="{Binding BankInvDepositByIdCommand}"
                                                Content="Deposit ID"
                                                />
                                            <TextBlock FontSize="11" Text="Deposit by Name" />
                                            <TextBox Margin="0,4,0,6" Text="{Binding BankInvActionName}" />
                                            <Button
                                                Command="{Binding BankInvDepositByNameCommand}"
                                                Content="Deposit Name"
                                                />

                                            <Separator Margin="0,10,0,10" />

                                            <TextBlock
                                                Margin="0,0,0,6"
                                                FontWeight="SemiBold"
                                                Text="Stack Lookup" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="0,0,8,8"
                                                    Text="{Binding IdInput}" />
                                                <Button
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Command="{Binding BankGetStackByIdCommand}"
                                                    Content="By ID"
                                                    />
                                                <TextBox
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Margin="0,0,8,0"
                                                    Text="{Binding NameInput}" />
                                                <Button
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Command="{Binding BankGetStackByNameCommand}"
                                                    Content="By Name"
                                                    />
                                            </Grid>
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                                Text="{Binding StackResult, StringFormat=Stack: {0}}" />

                                            <Separator Margin="0,10,0,10" />

                                            <TextBlock
                                                Margin="0,0,0,6"
                                                FontWeight="SemiBold"
                                                Text="Raw Action (Index/Offset)" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Text="Action:" />
                                                <TextBox
                                                    Grid.Column="1"
                                                    Margin="0,0,8,0"
                                                    Text="{Binding ActionIndex}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Text="Offset:" />
                                                <TextBox Grid.Column="3" Text="{Binding Offset}" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="0,0,8,8"
                                                    Text="{Binding IdInput}" />
                                                <Button
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Command="{Binding BankDoActionByIdCommand}"
                                                    Content="Invoke by ID"
                                                    />
                                                <TextBox
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Margin="0,0,8,0"
                                                    Text="{Binding NameInput}" />
                                                <Button
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Command="{Binding BankDoActionByNameCommand}"
                                                    Content="Invoke by Name"
                                                    />
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem Header="Presets">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="8">
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                FontWeight="SemiBold"
                                                Text="Preset Number" />
                                            <TextBox Margin="0,0,0,8" Text="{Binding PresetNumberInput}" />
                                            <UniformGrid Margin="0,0,0,8" Columns="2">
                                                <Button
                                                    Command="{Binding BankSavePresetCommand}"
                                                    Content="Save Preset"
                                                    />
                                                <Button
                                                    Command="{Binding BankLoadPresetCommand}"
                                                    Content="Load Preset"
                                                    />
                                            </UniformGrid>
                                            <UniformGrid Margin="0,0,0,8" Columns="2">
                                                <Button
                                                    Command="{Binding BankSaveSummonPresetCommand}"
                                                    Content="Save Summon Preset"
                                                    />
                                                <Button
                                                    Command="{Binding BankLoadSummonPresetCommand}"
                                                    Content="Load Summon Preset"
                                                    />
                                            </UniformGrid>

                                            <Separator Margin="0,10,0,10" />

                                            <TextBlock
                                                Margin="0,0,0,6"
                                                FontWeight="SemiBold"
                                                Text="Preset Settings" />
                                            <UniformGrid Margin="0,0,0,8" Columns="2">
                                                <Button
                                                    Command="{Binding BankPresetSettingsOpenCommand}"
                                                    Content="Open Settings"
                                                    />
                                                <Button
                                                    Command="{Binding BankPresetSettingsReturnCommand}"
                                                    Content="Return to Bank"
                                                    />
                                            </UniformGrid>
                                            <TextBlock FontSize="11" Text="Select Preset #" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    Grid.Column="0"
                                                    Margin="0,0,8,0"
                                                    Text="{Binding PresetSettingsNumberInput}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Command="{Binding BankPresetSettingsSelectCommand}"
                                                    Content="Select Preset"
                                                    />
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem Header="Boxes">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="8">
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                FontWeight="SemiBold"
                                                Text="Deposit Box" />
                                            <UniformGrid Margin="0,0,0,8" Columns="2">
                                                <Button
                                                    Command="{Binding BankDepositBoxOpenCommand}"
                                                    Content="Open"
                                                    />
                                                <Button
                                                    Command="{Binding BankDepositBoxCloseCommand}"
                                                    Content="Close"
                                                    />
                                                <Button
                                                    Command="{Binding BankDepositBoxDepositInventoryCommand}"
                                                    Content="Deposit Inv"
                                                    />
                                                <Button
                                                    Command="{Binding BankDepositBoxDepositEquipmentCommand}"
                                                    Content="Deposit Equip"
                                                    />
                                                <Button
                                                    Command="{Binding BankDepositBoxDepositMoneyCommand}"
                                                    Content="Deposit Money"
                                                    />
                                                <Button
                                                    Command="{Binding BankDepositBoxDepositAllCommand}"
                                                    Content="Deposit All"
                                                    />
                                            </UniformGrid>

                                            <Separator Margin="0,10,0,10" />

                                            <TextBlock
                                                Margin="0,0,0,6"
                                                FontWeight="SemiBold"
                                                Text="Collection Box" />
                                            <UniformGrid Columns="2">
                                                <Button
                                                    Command="{Binding BankCollectionBoxOpenCommand}"
                                                    Content="Open"
                                                    />
                                                <Button
                                                    Command="{Binding BankCollectionBoxCloseCommand}"
                                                    Content="Close"
                                                    />
                                                <Button
                                                    Command="{Binding BankCollectionBoxCollectInvCommand}"
                                                    Content="Collect Inv"
                                                    />
                                                <Button
                                                    Command="{Binding BankCollectionBoxCollectBankCommand}"
                                                    Content="Collect Bank"
                                                    />
                                            </UniformGrid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Border>

                    <!--  Equipment-specific Controls  -->
                    <Border
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="{DynamicResource App.BackgroundBrush}"
                        CornerRadius="5"
                        Visibility="{Binding IsEquipmentSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Equipment Status" />

                            <!--  Status Display  -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    FontSize="11"
                                    Text="Is Open:" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding EquipmentIsOpen}" />
                            </Grid>

                            <Separator Margin="0,5,0,10" />

                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Equipment Actions" />

                            <Button
                                Margin="0,0,0,5"
                                Padding="10,5"
                                Command="{Binding EquipmentOpenCommand}"
                                Content="Open Equipment" />

                            <Button
                                Margin="0,0,0,5"
                                Padding="10,5"
                                Command="{Binding EquipmentRefreshCommand}"
                                Content="Refresh Status" />

                            <!--  Item Actions (requires selection)  -->
                            <TextBlock
                                Margin="0,10,0,5"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Item Actions (select item):" />

                            <Button
                                Margin="0,0,0,5"
                                Padding="10,5"
                                Command="{Binding ItemUnequipCommand}"
                                Content="Unequip Item" />
                        </StackPanel>
                    </Border>

                    <!--  Loot-specific Controls  -->
                    <Border
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="{DynamicResource App.BackgroundBrush}"
                        CornerRadius="5"
                        Visibility="{Binding IsLootSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Loot Actions" />
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="11"
                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                Text="Loot-specific operations"
                                TextWrapping="Wrap" />

                            <Button
                                Margin="0,0,0,5"
                                Padding="10,5"
                                Command="{Binding LootRefreshCommand}"
                                Content="Refresh Loot" />
                        </StackPanel>
                    </Border>

                    <!--  MaterialCache-specific Controls  -->
                    <Border
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="{DynamicResource App.BackgroundBrush}"
                        CornerRadius="5"
                        Visibility="{Binding IsMaterialCacheSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Material Cache Actions" />
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="11"
                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                Text="Material cache-specific operations"
                                TextWrapping="Wrap" />

                            <Button
                                Margin="0,0,0,5"
                                Padding="10,5"
                                Command="{Binding MaterialCacheRefreshCommand}"
                                Content="Refresh Materials" />
                        </StackPanel>
                    </Border>

                    <!--  TradeWindow-specific Controls  -->
                    <Border
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="{DynamicResource App.BackgroundBrush}"
                        CornerRadius="5"
                        Visibility="{Binding IsTradeWindowSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Trade Window Actions" />
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="11"
                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                Text="Trade window-specific operations"
                                TextWrapping="Wrap" />

                            <Button
                                Margin="0,0,0,5"
                                Padding="10,5"
                                Command="{Binding TradeWindowRefreshCommand}"
                                Content="Refresh Trade" />
                        </StackPanel>
                    </Border>

                    <!--  Familiar-specific Controls  -->
                    <Border
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="{DynamicResource App.BackgroundBrush}"
                        CornerRadius="5"
                        Visibility="{Binding IsFamiliarSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Familiar Status" />

                            <!--  Status Display  -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    FontSize="11"
                                    Text="Has Familiar:" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding HasFamiliar}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,3,10,0"
                                    FontSize="11"
                                    Text="Name:" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding FamiliarName}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,3,10,0"
                                    FontSize="11"
                                    Text="Time Left:" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    FontWeight="SemiBold">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}s">
                                            <Binding Path="FamiliarTimeRemaining" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,3,10,0"
                                    FontSize="11"
                                    Text="Health:" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding FamiliarHealth}" />

                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Margin="0,3,10,0"
                                    FontSize="11"
                                    Text="Spell Points:" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding FamiliarSpellPoints}" />

                                <TextBlock
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Margin="0,3,10,0"
                                    FontSize="11"
                                    Text="Can Renew:" />
                                <TextBlock
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding FamiliarCanRenew}" />
                            </Grid>

                            <Separator Margin="0,5,0,10" />

                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Familiar Actions" />

                            <Button
                                Margin="0,0,0,5"
                                Padding="10,5"
                                Command="{Binding FamiliarRefreshCommand}"
                                Content="Refresh Status" />

                            <Button
                                Margin="0,0,0,5"
                                Padding="10,5"
                                Command="{Binding FamiliarCastSpecialCommand}"
                                Content="Cast Special Attack" />

                            <TextBlock
                                Margin="0,10,0,5"
                                FontSize="11"
                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                Text="Note: Familiar storage items appear in the main grid when Familiar container is selected."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
