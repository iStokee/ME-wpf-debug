<Window
    x:Class="MESharp.Views.WebwalkingInfoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Webwalking Guide"
    Width="860"
    Height="720"
    MinWidth="700"
    MinHeight="560"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource App.BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <TextBlock FontSize="22" FontWeight="Bold" Text="Webwalking: How It Works" />
            <TextBlock Margin="0,6,0,14" Foreground="{DynamicResource App.SubtleForegroundBrush}" TextWrapping="Wrap"
                       Text="This page explains what webwalking is, how to use the tooling, and how scripts should consume routes. The goal is to make travel logic reusable and easy to maintain." />

            <Border Padding="12" Margin="0,0,0,10" Background="{DynamicResource App.CardBrush}" CornerRadius="6">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Concept" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="Webwalking is macro navigation. It selects and executes reusable waypoint routes (teleport/walk/transition chains)." />
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="It does not replace low-level movement APIs. Scripts can still use Traversal directly when needed." />
                </StackPanel>
            </Border>

            <Border Padding="12" Margin="0,0,0,10" Background="{DynamicResource App.CardBrush}" CornerRadius="6">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Tooling Workflow" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="1) Pick or create a route in Step 1 (catalog)." />
                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="2) Edit route metadata and waypoint list in Step 2." />
                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="3) Edit selected waypoint fields and run in Step 3." />
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource App.SubtleForegroundBrush}" TextWrapping="Wrap"
                               Text="Save after edits so scripts consume the latest route pack. Use stable route IDs/names once scripts depend on them." />
                </StackPanel>
            </Border>

            <Border Padding="12" Margin="0,0,0,10" Background="{DynamicResource App.CardBrush}" CornerRadius="6">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Metadata Guidance" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="Name/Id: stable script-facing identifier (example: core.wildy_wall.to_green_dragons)." />
                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="Category: high-level grouping (core, slayer, questing, mining)." />
                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="Tags: discovery labels for scripts (dragons, bank, wilderness, etc.)." />
                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="IsEnabled: temporarily disable unsafe/broken routes without deleting." />
                </StackPanel>
            </Border>

            <Border Padding="12" Margin="0,0,0,10" Background="{DynamicResource App.CardBrush}" CornerRadius="6">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Using In Scripts" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="Use route IDs where possible for deterministic behavior:" />
                    <TextBox Margin="0,6,0,0" FontFamily="Consolas" IsReadOnly="True" Text="await Webwalking.RunRouteAsync(WebwalkingRoutes.CoreWildyWallToGreenDragons, ct);" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="Or find by metadata for flexible selection:" />
                    <TextBox Margin="0,6,0,0" FontFamily="Consolas" IsReadOnly="True" Text="var candidates = Webwalking.FindRoutes(category: &quot;core&quot;, tag: &quot;dragons&quot;);" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="For diagnostics, use detailed run result:" />
                    <TextBox Margin="0,6,0,0" FontFamily="Consolas" IsReadOnly="True" Text="var result = await Webwalking.RunRouteDetailedAsync(routeId, ct);" />
                </StackPanel>
            </Border>

            <Border Padding="12" Margin="0,0,0,10" Background="{DynamicResource App.CardBrush}" CornerRadius="6">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Best Practices" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="Keep route names stable once scripts consume them." />
                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="Prefer small reusable route segments over huge monolithic routes." />
                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="Use transitions for ladders/gates/doors and keep object IDs updated." />
                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="When a route fails repeatedly, disable it and fix in tooling rather than hot-patching each script." />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="120" Height="34" IsDefault="True" Content="Close" Click="Close_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
