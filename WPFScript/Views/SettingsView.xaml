<UserControl
    x:Class="MESharp.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MESharp.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:SettingsViewModel />
    </UserControl.DataContext>

    <StackPanel Margin="24">
        <TextBlock
            Margin="0,0,0,16"
            Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
            Style="{StaticResource MaterialDesignHeadline5TextBlock}"
            Text="Theme Settings" />

        <materialDesign:Card Margin="0,0,0,16" Padding="16">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,8"
                    Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                    Text="Base Theme" />
                <ToggleButton
                    Content="Use Dark Theme"
                    IsChecked="{Binding IsDark}"
                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />
            </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card Margin="0,0,0,16" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                        Text="Primary Color" />
                    <ComboBox
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Swatches}"
                        SelectedItem="{Binding PrimaryColor}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                        Text="Accent Color" />
                    <ComboBox
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Swatches}"
                        SelectedItem="{Binding SecondaryColor}" />
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </StackPanel>
</UserControl>