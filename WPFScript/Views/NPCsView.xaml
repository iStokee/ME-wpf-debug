<UserControl
    x:Class="MESharp.Views.NPCsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource App.BackgroundBrush}"
    Foreground="{DynamicResource App.ForegroundBrush}">
    <ScrollViewer>
        <GroupBox Margin="8" Header="NPCs">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Filters + Action  -->
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="5,5,5,7"
                        VerticalAlignment="Center"
                        Text="Filter (name or ID):" />
                    <TextBox
                        Width="150"
                        Margin="5"
                        Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                    <Ellipse
                        Width="10"
                        Height="10"
                        Margin="8,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource App.BorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowOnlyAlive}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <CheckBox
                        Margin="5"
                        VerticalAlignment="Center"
                        Content="Show Only Alive"
                        IsChecked="{Binding ShowOnlyAlive}" />
                    <CheckBox
                        Margin="5"
                        VerticalAlignment="Center"
                        Content="Live Refresh"
                        IsChecked="{Binding LiveRefresh}" />

                    <TextBlock
                        Margin="5,5,5,7"
                        VerticalAlignment="Center"
                        Text="Action #:" />
                    <ComboBox
                        Width="70"
                        ItemContainerStyle="{StaticResource AppComboBoxItem}"
                        ItemsSource="{Binding ActionIndices}"
                        SelectedItem="{Binding ActionIndex}"
                        Style="{StaticResource AppComboBox}" />
                    <Button
                        Width="80"
                        Height="30"
                        Margin="5"
                        Command="{Binding DoActionCommand}"
                        Content="DoAction"
                        Style="{StaticResource AccentButton}" />
                </StackPanel>

                <!--  Unified NPC Grid  -->
                <DataGrid
                    Grid.Row="1"
                    AutoGenerateColumns="False"
                    Background="{DynamicResource App.CardBrush}"
                    CanUserResizeColumns="False"
                    CanUserResizeRows="False"
                    CanUserSortColumns="True"
                    Foreground="{DynamicResource App.ForegroundBrush}"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding NpcsView}"
                    RowHeaderWidth="0"
                    RowHeight="28"
                    SelectedItem="{Binding SelectedNpc, Mode=TwoWay}"
                    SelectionMode="Single"
                    SelectionUnit="FullRow">
                    <DataGrid.ColumnHeaderStyle>
                        <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource App.CardBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Padding" Value="6,4" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                                </Trigger>
                                <Trigger Property="SortDirection" Value="Ascending">
                                    <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                                </Trigger>
                                <Trigger Property="SortDirection" Value="Descending">
                                    <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="220"
                            Binding="{Binding Name}"
                            Header="Name"
                            SortMemberPath="Name" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding Id}"
                            Header="ID"
                            SortMemberPath="Id" />
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding Health}"
                            Header="Health"
                            SortMemberPath="Health" />
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding X}"
                            Header="X"
                            SortMemberPath="X" />
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding Y}"
                            Header="Y"
                            SortMemberPath="Y" />
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding Distance}"
                            Header="Distance"
                            SortMemberPath="Distance" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding Animation}"
                            Header="Animation"
                            SortMemberPath="Animation" />
                        <DataGridTextColumn
                            Width="140"
                            Binding="{Binding UniqueId}"
                            Header="UniqueId"
                            SortMemberPath="UniqueId" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </ScrollViewer>
</UserControl>
