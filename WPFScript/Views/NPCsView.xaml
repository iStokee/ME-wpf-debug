<UserControl
    x:Class="MESharp.Views.NPCsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    Background="#FF232323"
    Foreground="White">
    <UserControl.DataContext>
        <vm:NpcViewModel />
    </UserControl.DataContext>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Filters + Action  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,8"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock
                Margin="5,5,5,7"
                VerticalAlignment="Center"
                Text="Filter (name or ID):" />
            <TextBox
                Width="150"
                Margin="5"
                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            <!--<CheckBox
                Margin="5"
                VerticalAlignment="Center"
                Content="Show Only Alive"
                Foreground="White"
                IsChecked="{Binding ShowOnlyAlive}" />-->

            <TextBlock
                Margin="5,5,5,7"
                VerticalAlignment="Center"
                Text="Action #:" />
            <ComboBox
                Width="50"
                ItemsSource="{Binding ActionIndices}"
                SelectedItem="{Binding ActionIndex}" />
            <Button
                Margin="5"
                Command="{Binding DoActionCommand}"
                Content="Do Action" />
        </StackPanel>

        <!--  Unified NPC Grid  -->
        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            CanUserSortColumns="True"
            IsReadOnly="True"
            ItemsSource="{Binding NpcsView}"
            SelectedItem="{Binding SelectedNpc, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Binding="{Binding Name}"
                    Header="Name"
                    SortMemberPath="Name" />
                <DataGridTextColumn
                    Binding="{Binding Id}"
                    Header="ID"
                    SortMemberPath="Id" />
                <DataGridTextColumn
                    Binding="{Binding Health}"
                    Header="Health"
                    SortMemberPath="Health" />
                <DataGridTextColumn
                    Binding="{Binding X}"
                    Header="X"
                    SortMemberPath="X" />
                <DataGridTextColumn
                    Binding="{Binding Y}"
                    Header="Y"
                    SortMemberPath="Y" />
                <DataGridTextColumn
                    Binding="{Binding Distance}"
                    Header="Distance"
                    SortMemberPath="Distance" />
                <DataGridTextColumn
                    Binding="{Binding Animation}"
                    Header="Animation"
                    SortMemberPath="Animation" />
                <DataGridTextColumn
                    Binding="{Binding UniqueId}"
                    Header="UniqueId"
                    SortMemberPath="UniqueId" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
