<UserControl
    x:Class="MESharp.Views.NPCsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Background="{DynamicResource App.BackgroundBrush}"
    Foreground="{DynamicResource App.ForegroundBrush}">

    <ScrollViewer>
        <StackPanel Margin="24">

            <!--  Header  -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial
                        Width="24"
                        Height="24"
                        Margin="0,0,8,0"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Kind="Robot" />
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="NPCs" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Style="{StaticResource HeaderHelpButton}"
                    ToolTip="Open API docs"
                    Command="{Binding DataContext.ShowApiDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <iconPacks:PackIconMaterial
                        Width="18"
                        Height="18"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Kind="HelpCircleOutline" />
                </Button>
            </Grid>

            <!--  Filters, Loading & Actions Card  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Filters, Loading and Actions" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Filter NPCs, control automatic loading, and perform actions." />

                    <!--  Filters Section  -->
                    <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Filter:" />
                        <TextBox
                            Width="180"
                            Margin="0,0,12,0"
                            Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource App.BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowOnlyAlive}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <CheckBox
                                VerticalAlignment="Center"
                                Content="Show Only Alive"
                                IsChecked="{Binding ShowOnlyAlive}" />
                        </StackPanel>
                        <CheckBox
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Content="Auto-Load NPCs"
                            IsChecked="{Binding AutoLoad}" />
                        <CheckBox
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Content="Live Refresh"
                            IsChecked="{Binding LiveRefresh}" />
                    </WrapPanel>

                    <!--  Divider  -->
                    <Border
                        Height="1"
                        Margin="0,12,0,12"
                        Background="{DynamicResource App.BorderBrush}" />

                    <!--  Actions Section  -->
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Action #:" />
                        <ComboBox
                            Width="80"
                            Margin="0,0,12,0"
                            ItemContainerStyle="{StaticResource AppComboBoxItem}"
                            ItemsSource="{Binding ActionIndices}"
                            SelectedItem="{Binding ActionIndex}"
                            Style="{StaticResource AppComboBox}" />
                        <Button
                            Width="100"
                            Height="30"
                            Command="{Binding DoActionCommand}"
                            Content="DoAction"
                            Style="{StaticResource AccentButton}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!--  NPCs List Card  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Nearby NPCs" />

                    <Grid>
                        <DataGrid
                            Height="460"
                            AutoGenerateColumns="False"
                            Background="{DynamicResource App.BackgroundBrush}"
                            BorderThickness="0"
                            CanUserResizeColumns="False"
                            CanUserResizeRows="False"
                            CanUserSortColumns="True"
                            Foreground="{DynamicResource App.ForegroundBrush}"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding NpcsView}"
                            RowBackground="{DynamicResource App.CardBrush}"
                            RowHeaderWidth="0"
                            RowHeight="28"
                            SelectedItem="{Binding SelectedNpc, Mode=TwoWay}"
                            SelectionMode="Single"
                            SelectionUnit="FullRow">
                            <DataGrid.ColumnHeaderStyle>
                                <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource App.CardBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="Padding" Value="6,4" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                                        </Trigger>
                                        <Trigger Property="SortDirection" Value="Ascending">
                                            <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                                        </Trigger>
                                        <Trigger Property="SortDirection" Value="Descending">
                                            <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="220"
                                    Binding="{Binding Name}"
                                    Header="Name"
                                    SortMemberPath="Name" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Id}"
                                    Header="ID"
                                    SortMemberPath="Id" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding Health}"
                                    Header="Health"
                                    SortMemberPath="Health" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding X}"
                                    Header="X"
                                    SortMemberPath="X" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding Y}"
                                    Header="Y"
                                    SortMemberPath="Y" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding Distance}"
                                    Header="Distance"
                                    SortMemberPath="Distance" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding Animation}"
                                    Header="Animation"
                                    SortMemberPath="Animation" />
                                <DataGridTextColumn
                                    Width="140"
                                    Binding="{Binding UniqueId}"
                                    Header="UniqueId"
                                    SortMemberPath="UniqueId" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!--  Empty State Message  -->
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource App.MutedBrush}"
                            Text="No NPCs loaded. Enable 'Auto-Load NPCs' to load them automatically.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNpcs}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
