<UserControl
    x:Class="MESharp.Views.ObjectsUnifiedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:MESharp.Views.Behaviors"
    xmlns:conv="clr-namespace:MESharp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:controls="clr-namespace:MESharp.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ObjectsUnifiedViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Main Content Area  -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <!--  Header  -->
        <controls:SectionHeader
            Grid.Row="0"
            Margin="0,0,0,10"
            Title="World Objects"
            Description="Browse NPCs and objects with type-specific controls in the side panel."
            IconKind="CubeOutline"
            HelpCommand="{Binding DataContext.ShowApiDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

            <!--  Object Type Selection and Actions  -->
            <Border
                Grid.Row="1"
                Margin="0,0,0,10"
                Padding="10"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="5">
                <Expander Header="Type Selection And Actions" IsExpanded="True">
                    <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            Margin="0,0,0,6"
                            FontWeight="SemiBold"
                            Text="Types:" />
                        <ItemsControl ItemsSource="{Binding ObjectTypeOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Margin="0,0,8,4"
                                        Content="{Binding DisplayName}"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Margin="15,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Filter:" />
                        <TextBox
                            Width="220"
                            Margin="0,6,0,0"
                            Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <Button
                            Margin="0,0,10,0"
                            Padding="15,5"
                            Command="{Binding LoadObjectsCommand}"
                            Style="{StaticResource AccentButton}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="Refresh" />
                                <TextBlock Text="Load" />
                            </StackPanel>
                        </Button>

                        <Button
                            Margin="0,0,10,0"
                            Padding="15,5"
                            Command="{Binding SearchByNameCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="Magnify" />
                                <TextBlock Text="Search" />
                            </StackPanel>
                        </Button>

                        <Button
                            Padding="15,5"
                            Command="{Binding ClearCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="Close" />
                                <TextBlock Text="Clear" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    </Grid>
                </Expander>
            </Border>

            <!--  Objects Table  -->
            <Border
                Grid.Row="2"
                Margin="0,0,0,10"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="5">
                <Expander Header="Objects Table" IsExpanded="True">
                    <Grid Margin="0,10,0,0">
                    <DataGrid
                        Margin="5,0,5,5"
                        AutoGenerateColumns="False"
                        Background="{DynamicResource App.BackgroundBrush}"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserSortColumns="True"
                        Foreground="{DynamicResource App.ForegroundBrush}"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding ObjectsView}"
                        RowBackground="{DynamicResource App.CardBrush}"
                        SelectedItem="{Binding SelectedObject}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Id}"
                                Header="ID"
                                SortMemberPath="Id" />
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="200"
                                Binding="{Binding Name}"
                                Header="Name"
                                SortMemberPath="Name" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding TypeLabel}"
                                Header="Type"
                                SortMemberPath="Type" />
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding Action}"
                                Header="Action"
                                SortMemberPath="Action" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding Distance, StringFormat={}{0:F1}}"
                                Header="Distance"
                                SortMemberPath="Distance" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Life}"
                                Header="Life"
                                SortMemberPath="Life" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding CombatLevel}"
                                Header="Combat"
                                SortMemberPath="CombatLevel" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Floor}"
                                Header="Floor"
                                SortMemberPath="Floor" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding TileX}"
                                Header="Tile X"
                                SortMemberPath="TileX" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding TileY}"
                                Header="Tile Y"
                                SortMemberPath="TileY" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding TileZ}"
                                Header="Tile Z"
                                SortMemberPath="TileZ" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding Animation}"
                                Header="Anim"
                                SortMemberPath="Animation" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!--  Empty State Message  -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="No objects loaded. Select a type and click 'Load'.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasObjects}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Grid>
                </Expander>
            </Border>

            <!--  Status Bar  -->
            <Border
                Grid.Row="3"
                Padding="10"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="5">
                <Expander Header="Status" IsExpanded="True">
                    <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Margin="0,0,20,0"
                        Orientation="Horizontal">
                        <iconPacks:PackIconMaterial
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Kind="Cube" />
                        <TextBlock VerticalAlignment="Center" Text="Objects: " />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Text="{Binding ObjectCount, Mode=OneWay}" />
                        <StackPanel
                            Margin="12,0,0,0"
                            Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NpcSnapshotCount}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <iconPacks:PackIconMaterial
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Kind="AccountGroup" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="NPC Snapshot: " />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding NpcSnapshotCount, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                        Text="{Binding StatusMessage}" />
                    </Grid>
                </Expander>
            </Border>
        </Grid>

        <!--  Toggle Button  -->
        <ToggleButton
            Grid.Column="1"
            Width="24"
            Height="60"
            Margin="5,0,0,0"
            VerticalAlignment="Top"
            IsChecked="{Binding IsSidePanelCollapsed, Mode=TwoWay}"
            Style="{StaticResource {x:Type ToggleButton}}"
            ToolTip="Toggle Side Panel">
            <iconPacks:PackIconMaterial Kind="ChevronLeft">
                <iconPacks:PackIconMaterial.Style>
                    <Style TargetType="iconPacks:PackIconMaterial">
                        <Setter Property="Kind" Value="ChevronLeft" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidePanelCollapsed}" Value="True">
                                <Setter Property="Kind" Value="ChevronRight" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </iconPacks:PackIconMaterial.Style>
            </iconPacks:PackIconMaterial>
        </ToggleButton>

        <!--  Flyout Panel  -->
        <Border
            Grid.Column="2"
            Margin="5,0,0,0"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="320" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidePanelCollapsed}" Value="True">
                            <Setter Property="Width" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <Expander Header="Object Actions" IsExpanded="True">
                        <StackPanel Margin="0,10,0,0">
                            <!--  Panel Header  -->
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Object Actions" />

                    <!--  NPC-specific Controls  -->
                    <Border
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="{DynamicResource App.BackgroundBrush}"
                        CornerRadius="5"
                        Visibility="{Binding IsNpcSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="NPC Actions" />
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="11"
                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                Text="NPC-specific filters and actions"
                                TextWrapping="Wrap" />

                            <CheckBox
                                Margin="0,0,0,5"
                                Content="Show Only Alive"
                                IsChecked="{Binding ShowOnlyAlive}" />

                            <CheckBox
                                Margin="0,0,0,5"
                                Content="Auto-Refresh"
                                IsChecked="{Binding AutoRefresh}" />

                            <TextBlock
                                Margin="0,8,0,4"
                                FontSize="12"
                                Text="Action Index:" />
                            <ComboBox
                                Margin="0,0,0,5"
                                ItemContainerStyle="{StaticResource AppComboBoxItem}"
                                ItemsSource="{Binding ActionIndices}"
                                SelectedItem="{Binding SelectedActionIndex}"
                                Style="{StaticResource AppComboBox}" />

                            <TextBlock
                                Margin="0,8,0,4"
                                FontSize="12"
                                Text="Offset:" />
                            <ComboBox
                                Margin="0,0,0,5"
                                ItemContainerStyle="{StaticResource AppComboBoxItem}"
                                ItemsSource="{Binding OffsetOptions}"
                                SelectedItem="{Binding SelectedOffset}"
                                Style="{StaticResource AppComboBox}"
                                DisplayMemberPath="DisplayName" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                Text="{Binding SelectedOffset.Description}" />

                            <Button
                                Margin="0,5,0,0"
                                Padding="10,5"
                                Command="{Binding DoActionCommand}"
                                Content="Perform Action"
                                Style="{StaticResource AccentButton}" />

                            <Separator Margin="0,12,0,12" />

                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Lookup &amp; Snapshot" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                Text="{Binding NpcSnapshotCount, StringFormat=Latest snapshot captured {0} NPC(s).}"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NpcSnapshotCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button
                                Margin="0,8,0,0"
                                Padding="10,5"
                                Command="{Binding LookupNpcByIdCommand}"
                                Content="Lookup NPC by ID (uses Filter)" />

                            <TextBlock
                                Margin="0,6,0,6"
                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                Text="{Binding NpcLookupStatus}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="NPC Search Results" />

                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="11"
                                Foreground="{DynamicResource App.MutedBrush}"
                                Text="Use the Search button with a name filter to populate results."
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNpcSearchResults}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <DataGrid
                                Height="150"
                                AutoGenerateColumns="False"
                                Background="{DynamicResource App.BackgroundBrush}"
                                BorderThickness="0"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                CanUserSortColumns="True"
                                Foreground="{DynamicResource App.ForegroundBrush}"
                                GridLinesVisibility="Horizontal"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                ItemsSource="{Binding NpcSearchResults}"
                                RowBackground="{DynamicResource App.CardBrush}"
                                SelectedItem="{Binding SelectedNpcSearchResult}"
                                Visibility="{Binding HasNpcSearchResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Name}"
                                        Header="Name" />
                                    <DataGridTextColumn
                                        Width="60"
                                        Binding="{Binding Id}"
                                        Header="ID" />
                                    <DataGridTextColumn
                                        Width="60"
                                        Binding="{Binding Health}"
                                        Header="HP" />
                                    <DataGridTextColumn
                                        Width="60"
                                        Binding="{Binding Distance, StringFormat={}{0:F1}}"
                                        Header="Dist" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!--  Objects-specific Controls  -->
                    <Border
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="{DynamicResource App.BackgroundBrush}"
                        CornerRadius="5"
                        Visibility="{Binding IsObjectsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Object Actions" />
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="11"
                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                Text="Object-specific filters and actions"
                                TextWrapping="Wrap" />

                            <CheckBox
                                Margin="0,0,0,5"
                                Content="Interactable Only"
                                IsChecked="{Binding OnlyInteractable}" />

                            <TextBlock
                                Margin="0,8,0,4"
                                FontSize="12"
                                Text="Action Index:" />
                            <ComboBox
                                Margin="0,0,0,5"
                                ItemContainerStyle="{StaticResource AppComboBoxItem}"
                                ItemsSource="{Binding ActionIndices}"
                                SelectedItem="{Binding SelectedActionIndex}"
                                Style="{StaticResource AppComboBox}" />

                            <TextBlock
                                Margin="0,8,0,4"
                                FontSize="12"
                                Text="Offset:" />
                            <ComboBox
                                Margin="0,0,0,5"
                                ItemContainerStyle="{StaticResource AppComboBoxItem}"
                                ItemsSource="{Binding OffsetOptions}"
                                SelectedItem="{Binding SelectedOffset}"
                                Style="{StaticResource AppComboBox}"
                                DisplayMemberPath="DisplayName" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                Text="{Binding SelectedOffset.Description}" />

                            <Button
                                Margin="0,5,0,0"
                                Padding="10,5"
                                Command="{Binding DoActionCommand}"
                                Content="Perform Action"
                                Style="{StaticResource AccentButton}" />
                        </StackPanel>
                    </Border>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
