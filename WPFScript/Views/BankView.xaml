<UserControl
    x:Class="MESharp.Views.BankView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Background="{DynamicResource App.BackgroundBrush}"
    Foreground="{DynamicResource App.ForegroundBrush}">

    <ScrollViewer>
        <StackPanel Margin="24">

            <!--  Header  -->
            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                <iconPacks:PackIconMaterial
                    Width="24"
                    Height="24"
                    Margin="0,0,8,0"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Kind="BankOutline" />
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Bank" />
            </StackPanel>

            <!--  Status, Lookups & Actions Card  -->
            <Border
                Padding="16"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Status, Lookups and Actions" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Bank status, quick filter, deposits, stack lookups, and item actions." />

                    <!--  Status & Quick Filter  -->
                    <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Filter:" />
                        <TextBox
                            Width="220"
                            Margin="0,0,12,8"
                            Text="{Binding QuickFilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Width="140"
                            Margin="0,0,12,8"
                            Command="{Binding RefreshStateCommand}"
                            Content="Refresh State"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="120"
                            Margin="0,0,12,8"
                            Command="{Binding CloseCommand}"
                            Content="Close Bank"
                            Style="{StaticResource AccentButton}" />
                        <TextBlock Margin="0,0,12,8" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Status: Closed" />
                                    <Setter Property="Foreground" Value="{DynamicResource App.MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                            <Setter Property="Text" Value="Status: Open" />
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,0,12,8" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Foreground" Value="{DynamicResource App.MutedBrush}" />
                                    <Setter Property="Text" Value="{Binding QuickStack, StringFormat=Matching: {0}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasStack}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </WrapPanel>

                    <!--  Divider  -->
                    <Border
                        Height="1"
                        Margin="0,8,0,12"
                        Background="{DynamicResource App.BorderBrush}" />

                    <!--  Deposit Section  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Deposit" />
                    <WrapPanel Margin="0,0,0,12">
                        <Button
                            Width="140"
                            Margin="0,0,12,8"
                            Command="{Binding DepositAllCommand}"
                            Content="Deposit All"
                            Style="{StaticResource AccentButton}" />
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Keep IDs:" />
                        <TextBox
                            Width="180"
                            Margin="0,0,8,8"
                            Text="{Binding IdsInput}" />
                        <Button
                            Width="180"
                            Margin="0,0,12,8"
                            Command="{Binding DepositAllExceptIdsCommand}"
                            Content="Deposit Except IDs"
                            Style="{StaticResource AccentButton}" />
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Keep Names:" />
                        <TextBox
                            Width="200"
                            Margin="0,0,8,8"
                            Text="{Binding NamesInput}" />
                        <Button
                            Width="200"
                            Margin="0,0,0,8"
                            Command="{Binding DepositAllExceptNamesCommand}"
                            Content="Deposit Except Names"
                            Style="{StaticResource AccentButton}" />
                    </WrapPanel>

                    <!--  Divider  -->
                    <Border
                        Height="1"
                        Margin="0,0,0,12"
                        Background="{DynamicResource App.BorderBrush}" />

                    <!--  Stack Lookups Section  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Stack Lookups" />
                    <WrapPanel Margin="0,0,0,12">
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Item ID:" />
                        <TextBox
                            Width="120"
                            Margin="0,0,8,8"
                            Text="{Binding IdInput}" />
                        <Button
                            Width="140"
                            Margin="0,0,12,8"
                            Command="{Binding GetStackByIdCommand}"
                            Content="Get Stack (ID)"
                            Style="{StaticResource AccentButton}" />
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Item Name:" />
                        <TextBox
                            Width="180"
                            Margin="0,0,8,8"
                            Text="{Binding NameInput}" />
                        <Button
                            Width="160"
                            Margin="0,0,0,8"
                            Command="{Binding GetStackByNameCommand}"
                            Content="Get Stack (Name)"
                            Style="{StaticResource AccentButton}" />
                    </WrapPanel>

                    <TextBlock Margin="0,0,0,12" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource App.SubtleForegroundBrush}" />
                                <Setter Property="Text" Value="{Binding StackResult, StringFormat=Result: {0}}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StackResult}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StackResult}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!--  Divider  -->
                    <Border
                        Height="1"
                        Margin="0,0,0,12"
                        Background="{DynamicResource App.BorderBrush}" />

                    <!--  Actions Section  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="Item Actions" />
                    <WrapPanel>
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Action #:" />
                        <TextBox
                            Width="80"
                            Margin="0,0,12,8"
                            Text="{Binding ActionIndex}" />
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Offset:" />
                        <TextBox
                            Width="80"
                            Margin="0,0,12,8"
                            Text="{Binding Offset}" />
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Item ID:" />
                        <TextBox
                            Width="120"
                            Margin="0,0,8,8"
                            Text="{Binding IdInput}" />
                        <Button
                            Width="140"
                            Margin="0,0,12,8"
                            Command="{Binding DoActionByIdCommand}"
                            Content="Invoke by ID"
                            Style="{StaticResource AccentButton}" />
                        <TextBlock
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Text="Item Name:" />
                        <TextBox
                            Width="180"
                            Margin="0,0,8,8"
                            Text="{Binding NameInput}" />
                        <Button
                            Width="160"
                            Margin="0,0,0,8"
                            Command="{Binding DoActionByNameCommand}"
                            Content="Invoke by Name"
                            Style="{StaticResource AccentButton}" />
                    </WrapPanel>

                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="11"
                        FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Text" Value="{Binding ActionResult}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActionResult}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ActionResult}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!--  Items Grid Card  -->
            <Border
                Padding="16"
                Margin="0,12,0,0"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Bank Items" />
                    <TextBlock
                        Margin="0,4,0,12"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Load and view all items currently in the bank." />
                    <WrapPanel Margin="0,0,0,12">
                        <Button
                            Width="140"
                            Margin="0,0,12,0"
                            Command="{Binding LoadItemsCommand}"
                            Content="Load Items"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="100"
                            Command="{Binding ClearItemsCommand}"
                            Content="Clear" />
                        <TextBlock
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource App.SubtleForegroundBrush}">
                            <Run Text="Items:" />
                            <Run
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding ItemCount, Mode=OneWay}" />
                        </TextBlock>
                    </WrapPanel>

                    <!--  Items DataGrid  -->
                    <Border
                        Background="{DynamicResource App.CardBrush}"
                        CornerRadius="8">
                        <DataGrid
                            Margin="5"
                            AutoGenerateColumns="False"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding Items}"
                            RowBackground="{DynamicResource App.CardBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="50"
                                    Binding="{Binding Slot}"
                                    Header="Slot" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding Id}"
                                    Header="ID" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="150"
                                    Binding="{Binding Name}"
                                    Header="Name" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding Stack}"
                                    Header="Stack" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Category}"
                                    Header="Category" />
                                <DataGridCheckBoxColumn
                                    Width="70"
                                    Binding="{Binding IsNoted, Mode=OneWay}"
                                    Header="Noted" />
                                <DataGridCheckBoxColumn
                                    Width="80"
                                    Binding="{Binding IsStackable, Mode=OneWay}"
                                    Header="Stackable" />
                                <DataGridCheckBoxColumn
                                    Width="85"
                                    Binding="{Binding IsTradeable, Mode=OneWay}"
                                    Header="Tradeable" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
