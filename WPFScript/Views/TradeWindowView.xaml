<UserControl x:Class="MESharp.Views.TradeWindowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:MESharp.ViewModels"
             Background="{DynamicResource App.BackgroundBrush}"
             Foreground="{DynamicResource App.ForegroundBrush}">

    <UserControl.DataContext>
        <vm:TradeWindowViewModel />
    </UserControl.DataContext>

    <ScrollViewer>
        <StackPanel Margin="24">
            <!--  Header  -->
            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                <iconPacks:PackIconMaterial
                    Width="24"
                    Height="24"
                    Margin="0,0,8,0"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Kind="SwapHorizontal" />
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Trade Window" />
            </StackPanel>

            <!--  Controls Card  -->
            <Border
                Padding="16"
                Margin="0,0,0,12"
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Controls" />
                    <TextBlock
                        Margin="0,4,0,12"
                        FontSize="11"
                        Foreground="{DynamicResource App.MutedBrush}"
                        Text="Load and view items from the trade window (both offers)." />
                    <WrapPanel>
                        <Button
                            Width="140"
                            Margin="0,0,12,0"
                            Command="{Binding LoadItemsCommand}"
                            Content="Load Items"
                            Style="{StaticResource AccentButton}" />
                        <Button
                            Width="100"
                            Command="{Binding ClearCommand}"
                            Content="Clear" />
                        <TextBlock
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource App.SubtleForegroundBrush}">
                            <Run Text="Items:" />
                            <Run
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding ItemCount, Mode=OneWay}" />
                        </TextBlock>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!--  Items Grid  -->
            <Border
                Background="{DynamicResource App.CardBrush}"
                CornerRadius="8">
                <DataGrid
                    Margin="5"
                    AutoGenerateColumns="False"
                    BorderThickness="0"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Items}"
                    RowBackground="{DynamicResource App.CardBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="50"
                            Binding="{Binding Slot}"
                            Header="Slot" />
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding Id}"
                            Header="ID" />
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="150"
                            Binding="{Binding Name}"
                            Header="Name" />
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding Stack}"
                            Header="Stack" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding Category}"
                            Header="Category" />
                        <DataGridCheckBoxColumn
                            Width="70"
                            Binding="{Binding IsNoted, Mode=OneWay}"
                            Header="Noted" />
                        <DataGridCheckBoxColumn
                            Width="80"
                            Binding="{Binding IsStackable, Mode=OneWay}"
                            Header="Stackable" />
                        <DataGridCheckBoxColumn
                            Width="85"
                            Binding="{Binding IsTradeable, Mode=OneWay}"
                            Header="Tradeable" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
