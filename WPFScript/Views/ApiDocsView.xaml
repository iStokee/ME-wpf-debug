<UserControl
    x:Class="MESharp.Views.ApiDocsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:MESharp.Views"
    xmlns:conv="clr-namespace:MESharp.Converters"
    xmlns:controls="clr-namespace:MESharp.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:MESharp.Models"
    xmlns:vm="clr-namespace:MESharp.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ApiDocsViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

        <!--  Code Block Style  -->
        <Style x:Key="CodeBlockStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Courier New" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource App.BackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  Section Header Style  -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Margin" Value="0,20,0,12" />
        </Style>

        <!--  Method Card Style  -->
        <Style x:Key="MethodCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource App.BackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!--  Tag Style  -->
        <Style x:Key="TagStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="220" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Navigation Sidebar  -->
        <Border
            Grid.Column="0"
            Margin="0"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Sidebar Header  -->
                <controls:SectionHeader
                    Grid.Row="0"
                    Margin="12,12,12,10"
                    Description="Comprehensive documentation for the MESharp API"
                    IconKind="BookOpenPageVariant"
                    ShowExpandCollapseAll="False"
                    ShowHelp="False"
                    Title="API Reference"
                    TitleFontSize="20" />

                <!--  Search Box  -->
                <Border
                    Grid.Row="1"
                    Margin="16,0,16,12"
                    Padding="10,8"
                    Background="{DynamicResource App.BackgroundBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource App.ForegroundBrush}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <TextBlock
                                                        Margin="2,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                                        IsHitTestVisible="False"
                                                        Text="Search API (class, method, property). Use * and ?">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ScrollViewer x:Name="PART_ContentHost" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <iconPacks:PackIconMaterial
                            Grid.Column="1"
                            Width="16"
                            Height="16"
                            Foreground="{DynamicResource App.SubtleForegroundBrush}"
                            Kind="Magnify" />
                    </Grid>
                </Border>

                <TextBlock
                    Grid.Row="2"
                    Margin="16,0,16,6"
                    FontSize="11"
                    Foreground="{DynamicResource App.SubtleForegroundBrush}"
                    Text="{Binding SearchResultSummary}"
                    TextWrapping="Wrap"
                    Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!--  Class List  -->
                <ListBox
                    Grid.Row="3"
                    Margin="8"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding ApiClasses}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedClass, Mode=TwoWay}">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearchActive}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="{DynamicResource App.BackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="Margin" Value="4,4" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border
                                            x:Name="Border"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{DynamicResource App.BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{TemplateBinding Foreground}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                                    Text="{Binding Namespace}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Border
                                                    Margin="0,4,0,0"
                                                    Padding="5,2"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource PrimarySoftBrush}"
                                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasDedicatedPanel}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock
                                                        FontSize="9"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource PrimaryBrush}"
                                                        Text="NO DEBUG TAB" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource App.BackgroundBrush}" />
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter TargetName="Border" Property="BorderThickness" Value="2" />
                                                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!--  Search Results  -->
                <ListBox
                    Grid.Row="3"
                    Margin="8"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding SearchResults}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearchActive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="{DynamicResource App.BackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="Margin" Value="4,4" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border
                                            x:Name="Border"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{DynamicResource App.BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                            <StackPanel>
                                                <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                                    <Border
                                                        Margin="0,0,8,0"
                                                        Padding="6,2"
                                                        Background="{DynamicResource PrimarySoftBrush}"
                                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4">
                                                        <TextBlock
                                                            FontSize="9"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource PrimaryBrush}"
                                                            Text="{Binding ResultType}" />
                                                    </Border>
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                                        Text="{Binding ClassName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{TemplateBinding Foreground}"
                                                    Text="{Binding Signature}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                                    Text="{Binding Summary}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource App.BackgroundBrush}" />
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter TargetName="Border" Property="BorderThickness" Value="2" />
                                                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <GridSplitter
            Grid.Column="1"
            Width="6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{DynamicResource PrimarySoftBrush}"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"
            ShowsPreview="True" />

        <!--  Documentation Content Area  -->
        <Border
            Grid.Column="2"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="8">
            <ScrollViewer
                x:Name="DocumentationScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24" DataContext="{Binding SelectedClassDocumentation}">
                    <!--  Class Header  -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <!--  Class Name  -->
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource App.ForegroundBrush}"
                                Text="{Binding ClassName}"
                                TextWrapping="Wrap" />

                            <!--  Namespace  -->
                            <TextBlock
                                Margin="0,4,0,0"
                                FontFamily="Consolas"
                                FontSize="13"
                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                TextWrapping="Wrap">
                                <Run Text="namespace" />
                                <Run FontWeight="SemiBold" Text="{Binding Namespace, Mode=OneWay}" />
                            </TextBlock>

                            <!--  Category Tag  -->
                            <Border
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TagStyle}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Text="{Binding Category}" />
                            </Border>
                        </StackPanel>

                        <!--  Debug Tool Link  -->
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <Button
                                MinWidth="180"
                                Margin="0,0,0,14"
                                Padding="14,8"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource PrimarySoftBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1"
                                Command="{Binding DataContext.OpenDebugToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="{Binding DataContext.OpenDebugToolLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Visibility="{Binding DataContext.CanOpenDebugTool, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>

                    <!--  Summary  -->
                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource App.ForegroundBrush}"
                        Text="{Binding Summary}"
                        TextWrapping="Wrap" />

                    <!--  Description  -->
                    <Border
                        Margin="0,0,0,20"
                        Padding="20,16"
                        Background="{DynamicResource App.BackgroundBrush}"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="0,0,0,3"
                        CornerRadius="6">
                        <TextBlock
                            FontSize="13"
                            Foreground="{DynamicResource App.ForegroundBrush}"
                            LineHeight="22"
                            Text="{Binding Description}"
                            TextWrapping="Wrap" />
                    </Border>

                    <!--  Properties Section  -->
                    <StackPanel Visibility="{Binding Properties.Count, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Width="20"
                                Height="20"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Kind="FormatListBulleted" />
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Properties" />
                            <ComboBox
                                Width="160"
                                Margin="14,16,0,0"
                                Padding="6,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding PropertySortOptions}"
                                SelectedItem="{Binding SelectedPropertySort, Mode=TwoWay}" />
                        </StackPanel>

                        <ListBox
                            x:Name="PropertiesListBox"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding Properties}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            SelectedItem="{Binding SelectedProperty, Mode=TwoWay}"
                            SelectionChanged="OnMemberSelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ApiPropertyDoc}">
                                    <Border>
                                        <Border.Style>
                                            <Style BasedOn="{StaticResource MethodCardStyle}" TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!--  Property Header  -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontFamily="Consolas"
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource App.ForegroundBrush}"
                                                    TextWrapping="Wrap">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                    <Run Foreground="{DynamicResource App.SubtleForegroundBrush}" Text=":" />
                                                    <Run Foreground="{DynamicResource PrimaryBrush}" Text="{Binding Type, Mode=OneWay}" />
                                                </TextBlock>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Border
                                                        Margin="0,0,4,0"
                                                        Padding="6,2"
                                                        Background="{DynamicResource PrimarySoftBrush}"
                                                        CornerRadius="4"
                                                        Visibility="{Binding IsStatic, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock
                                                            FontSize="9"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource PrimaryBrush}"
                                                            Text="STATIC" />
                                                    </Border>
                                                    <Border
                                                        Padding="6,2"
                                                        Background="{DynamicResource App.CardBrush}"
                                                        BorderBrush="{DynamicResource App.BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock
                                                            FontSize="9"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                                            Text="READ-ONLY" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!--  Summary  -->
                                            <TextBlock
                                                Grid.Row="1"
                                                Margin="0,8,0,0"
                                                FontSize="13"
                                                Foreground="{DynamicResource App.ForegroundBrush}"
                                                Text="{Binding Summary}"
                                                TextWrapping="Wrap" />

                                            <!--  Examples  -->
                                            <ItemsControl
                                                Grid.Row="2"
                                                Margin="0,12,0,0"
                                                ItemsSource="{Binding Examples}"
                                                Visibility="{Binding Examples.Count, Converter={StaticResource NullToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:ApiExampleDoc}">
                                                        <Border
                                                            Margin="0,0,0,8"
                                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                                            BorderThickness="1,0,0,0"
                                                            Padding="12,0,0,0">
                                                            <StackPanel>
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                                    Text="{Binding Title}" />
                                                                <Border
                                                                    Margin="0,6,0,0"
                                                                    CornerRadius="4">
                                                                    <TextBlock Style="{StaticResource CodeBlockStyle}" Text="{Binding Code}" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!--  Methods Section  -->
                    <StackPanel Margin="0,20,0,0" Visibility="{Binding Methods.Count, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                            <iconPacks:PackIconMaterial
                                Width="20"
                                Height="20"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Kind="FunctionVariant" />
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Methods" />
                            <ComboBox
                                Width="180"
                                Margin="14,16,0,0"
                                Padding="6,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding MethodSortOptions}"
                                SelectedItem="{Binding SelectedMethodSort, Mode=TwoWay}" />
                        </StackPanel>

                        <ListBox
                            x:Name="MethodsListBox"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding Methods}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            SelectedItem="{Binding SelectedMethod, Mode=TwoWay}"
                            SelectionChanged="OnMemberSelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ApiMethodDoc}">
                                    <Border>
                                        <Border.Style>
                                            <Style BasedOn="{StaticResource MethodCardStyle}" TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!--  Method Signature  -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontFamily="Consolas"
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource App.ForegroundBrush}"
                                                    TextWrapping="Wrap">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                    <Run Foreground="{DynamicResource App.SubtleForegroundBrush}" Text="{Binding ParametersDisplay, Mode=OneWay}" />
                                                </TextBlock>

                                                <Border
                                                    Grid.Column="1"
                                                    Padding="6,2"
                                                    Background="{DynamicResource PrimarySoftBrush}"
                                                    CornerRadius="4"
                                                    Visibility="{Binding IsStatic, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock
                                                        FontSize="9"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource PrimaryBrush}"
                                                        Text="STATIC" />
                                                </Border>
                                            </Grid>

                                            <!--  Return Type  -->
                                            <TextBlock
                                                Grid.Row="1"
                                                Margin="0,4,0,0"
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                                TextWrapping="Wrap">
                                                <Run Text="Returns:" />
                                                <Run FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Text="{Binding ReturnType, Mode=OneWay}" />
                                            </TextBlock>

                                            <!--  Return Description  -->
                                            <TextBlock
                                                Grid.Row="2"
                                                Margin="0,6,0,0"
                                                FontSize="12"
                                                Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                                Text="{Binding ReturnDescription}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding ReturnDescription, Converter={StaticResource NullToVisibilityConverter}}" />

                                            <!--  Summary  -->
                                            <TextBlock
                                                Grid.Row="3"
                                                Margin="0,12,0,0"
                                                FontSize="13"
                                                Foreground="{DynamicResource App.ForegroundBrush}"
                                                Text="{Binding Summary}"
                                                TextWrapping="Wrap" />

                                            <!--  Parameters  -->
                                            <StackPanel
                                                Grid.Row="4"
                                                Margin="0,12,0,0"
                                                Visibility="{Binding Parameters.Count, Converter={StaticResource NullToVisibilityConverter}}">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                                    Text="Parameters:" />
                                                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Parameters}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:ApiParameterDoc}">
                                                            <Grid Margin="0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="140" />
                                                                    <ColumnDefinition Width="130" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    FontFamily="Consolas"
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource App.ForegroundBrush}"
                                                                    Text="{Binding Name}"
                                                                    TextTrimming="CharacterEllipsis" />

                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Margin="12,0"
                                                                    FontFamily="Consolas"
                                                                    FontSize="11"
                                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                                    Text="{Binding Type}"
                                                                    TextTrimming="CharacterEllipsis" />

                                                                <TextBlock
                                                                    Grid.Column="2"
                                                                    FontSize="12"
                                                                    Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                                                    Text="{Binding Description}"
                                                                    TextWrapping="Wrap" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!--  Examples  -->
                                            <ItemsControl
                                                Grid.Row="5"
                                                Margin="0,16,0,0"
                                                ItemsSource="{Binding Examples}"
                                                Visibility="{Binding Examples.Count, Converter={StaticResource NullToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:ApiExampleDoc}">
                                                        <Border
                                                            Margin="0,0,0,12"
                                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                                            BorderThickness="2,0,0,0"
                                                            Padding="16,0,0,0">
                                                            <StackPanel>
                                                                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                                                    <iconPacks:PackIconMaterial
                                                                        Width="16"
                                                                        Height="16"
                                                                        Margin="0,0,6,0"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource PrimaryBrush}"
                                                                        Kind="CodeBraces" />
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="13"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{DynamicResource PrimaryBrush}"
                                                                        Text="{Binding Title}" />
                                                                </StackPanel>

                                                                <TextBlock
                                                                    Margin="0,0,0,8"
                                                                    FontSize="12"
                                                                    Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                                                    Text="{Binding Description}"
                                                                    TextWrapping="Wrap" />

                                                                <Border CornerRadius="6">
                                                                    <TextBlock Style="{StaticResource CodeBlockStyle}" Text="{Binding Code}" />
                                                                </Border>

                                                                <Border
                                                                    Margin="0,8,0,0"
                                                                    Padding="12,8"
                                                                    Background="{DynamicResource App.CardBrush}"
                                                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Visibility="{Binding Output, Converter={StaticResource NullToVisibilityConverter}}">
                                                                    <StackPanel>
                                                                        <TextBlock
                                                                            FontSize="10"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="{DynamicResource App.SubtleForegroundBrush}"
                                                                            Text="Output:" />
                                                                        <TextBlock
                                                                            Margin="0,4,0,0"
                                                                            FontFamily="Consolas"
                                                                            FontSize="11"
                                                                            Foreground="{DynamicResource App.ForegroundBrush}"
                                                                            Text="{Binding Output}"
                                                                            TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
