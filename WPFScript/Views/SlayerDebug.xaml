
<Page x:Class="ME_wpf_debug.SlayerDebug"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ME_wpf_debug"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SlayerDebug">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel>
                <TextBlock Text="Slayer Info" FontSize="20" FontWeight="Bold" Margin="10"/>
                <Button Content="Get Slayer Task" Click="GetSlayerTask_Click" Margin="10"/>
                <TextBlock x:Name="SlayerTaskText" Margin="10"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
